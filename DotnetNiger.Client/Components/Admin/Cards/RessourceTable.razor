@* Tableau admin des ressources avec actions harmonisées. *@
@using DotnetNiger.Client.Models.Responses

<div class="bg-white rounded-lg shadow">
    <table class="w-full">
        <thead class="bg-gray-50 border-b">
            <tr>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Titre</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Type</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Niveau</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">URL</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Vues</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Resources is null || Resources.Count == 0)
            {
                <tr class="border-b">
                    <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-500">Aucune ressource disponible.</td>
                </tr>
            }
            else
            {
                @foreach (var resource in Resources)
                {
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm font-medium">@resource.Title</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="rounded-full bg-blue-100 text-blue-800 px-2 py-1 text-xs">@resource.ResourceType</span>
                        </td>
                        <td class="px-6 py-4 text-sm">@resource.Level</td>
                        <td class="px-6 py-4 text-sm">
                            <a href="@resource.Url" target="_blank" class="text-blue-600 hover:underline truncate max-w-[160px] block">
                                @(resource.Url.Length > 40 ? resource.Url[..40] + "..." : resource.Url)
                            </a>
                        </td>
                        <td class="px-6 py-4 text-sm">@resource.ViewCount</td>
                        <td class="px-6 py-4 text-sm">
                            <AdminActionDropdown ItemId="resource.Id"
                                                  EditLabel="Modifier"
                                                  DeleteLabel="Supprimer"
                                                  OnEdit="HandleEdit"
                                                  OnDelete="HandleDelete" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<ResourceDto> Resources { get; set; } = new();
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private async Task HandleEdit(Guid id)
    {
        if (OnEdit.HasDelegate)
            await OnEdit.InvokeAsync(id);
    }

    private async Task HandleDelete(Guid id)
    {
        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(id);
    }
}
