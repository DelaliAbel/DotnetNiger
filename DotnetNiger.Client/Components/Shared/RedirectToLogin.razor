@* Redirects to the gateway login page when auth fails. *@
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var useMock = Config.GetValue<bool>("UseMockServices");
        if (useMock)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var apiBase = Config["ApiBaseUrl"];
        if (string.IsNullOrWhiteSpace(apiBase))
        {
            Navigation.NavigateTo("/");
            return;
        }
        var returnUrl = $"{Navigation.BaseUri.TrimEnd('/')}/auth/external-callback";
        var path = "/Account/Login";
        var loginUrl = $"{apiBase}{path}?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(loginUrl, forceLoad: true);
    }
}
