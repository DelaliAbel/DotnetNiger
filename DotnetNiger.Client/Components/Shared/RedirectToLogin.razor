@* Redirects to the gateway login page when auth fails. *@
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var useMock = Config.GetValue<bool>("UseMockServices");
        if (useMock)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var returnUrl = $"{Navigation.BaseUri.TrimEnd('/')}/auth/external-callback";
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
    }
}
