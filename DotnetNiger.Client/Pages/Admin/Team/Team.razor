@page "/admin/team"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using DotnetNiger.Client.Models.Requests
@using DotnetNiger.Client.Models.Responses
@using DotnetNiger.Client.Components.Admin.Cards
@using DotnetNiger.Client.Services.Contracts
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IUserService UserService
@inject IToastService ToastService
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <Skeleton Type="SkeletonType.Title" Class="w-48" />
                    <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-64" />
                </div>
                <Skeleton Type="SkeletonType.Button" Width="160px" />
            </div>
            <div class="overflow-hidden rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Membre</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Position</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Email</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Rôle</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Statut</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @for (int i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td class="px-6 py-4"><div class="flex items-center gap-3"><Skeleton Type="SkeletonType.Custom" Class="h-10 w-10 rounded-full" /><Skeleton Type="SkeletonType.Text" Lines="1" Class="w-32" /></div></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Text" Lines="1" Class="w-24" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Text" Lines="1" Class="w-36" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Badge" Width="60px" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Badge" Width="60px" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Button" Width="32px" Class="h-8" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-6 flex items-center justify-between gap-4">
                <section>
                    <AdminBreadcrumb />
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-body md:text-base">Gérez les membres de l'équipe visible sur la page À propos.</p>
                </section>
                <div class="flex items-center gap-3">
                    <button @onclick="NavigateToUsers"
                            class="inline-flex items-center gap-2 rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white shadow-[0_10px_20px_rgba(91,77,245,0.25)] transition hover:brightness-95">
                        <i class="fas fa-plus text-sm"></i>
                        <span class="hidden sm:block">Nouveau membre</span>
                    </button>
                </div>
            </div>

            <section class="mb-6 flex flex-col gap-4 md:flex-row md:items-center">
                <div class="flex-1 rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-black/5">
                    <div class="relative">
                        <i class="fas fa-search absolute left-0 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" placeholder="Rechercher un membre..."
                               @bind="searchQuery" @bind:event="oninput"
                               class="w-full border-0 bg-transparent pl-7 text-sm text-gray-900 outline-none placeholder:text-gray-400" />
                    </div>
                </div>
            </section>

            <div class="mb-6 hidden md:block">
                <ViewToggle @bind-IsListView="isListView" />
            </div>

            @if (isListView)
            {
                <TeamTable Members="pagedMembers"
                           OnView="HandleView"
                           OnEdit="HandleEdit"
                           OnRemoveFromTeam="HandleRemoveFromTeam"
                           OnChangeRole="HandleChangeRole" />
            }
            else
            {
                @if (pagedMembers.Count == 0)
                {
                    <div class="rounded-lg bg-white p-10 text-center text-sm text-gray-500 shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
                        Aucun membre dans l'équipe.
                    </div>
                }
                else
                {
                    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                        @foreach (var member in pagedMembers)
                        {
                            <AdminTeamCard User="member"
                                           OnView="HandleView"
                                           OnEdit="HandleEdit"
                                           OnRemoveFromTeam="HandleRemoveFromTeam"
                                           OnChangeRole="HandleChangeRole" />
                        }
                    </div>
                }
            }

            <div class="mt-6">
                <Paginated @bind-CurrentPage="currentPage" TotalPages="@totalPages" />
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isListView = false;
    private bool responsiveViewApplied;
    private string searchQueryValue = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private List<UserDto> teamMembers = [];

    private string searchQuery
    {
        get => searchQueryValue;
        set
        {
            if (searchQueryValue == value) return;
            searchQueryValue = value;
            currentPage = 1;
        }
    }

    private List<UserDto> filteredMembers => teamMembers
        .Where(m => string.IsNullOrEmpty(searchQuery) ||
                    m.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    m.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (m.Position ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredMembers.Count / pageSize));

    private List<UserDto> pagedMembers => filteredMembers
        .Skip((SafeCurrentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int SafeCurrentPage => Math.Clamp(currentPage, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamAsync();
    }

    private async Task LoadTeamAsync()
    {
        isLoading = true;
        try
        {
            var all = await UserService.GetUsersAsync();
            teamMembers = all.Where(u => u.IsTeamMember).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task HandleView(Guid id)
    {
        Navigation.NavigateTo($"/admin/profile/{id}");
        return Task.CompletedTask;
    }

    private Task HandleEdit(Guid id)
    {
        Navigation.NavigateTo($"/admin/users");
        return Task.CompletedTask;
    }

    private async Task HandleRemoveFromTeam(Guid id)
    {
        try
        {
            var user = await UserService.GetUserByIdAsync(id);
            if (user is null) return;

            await UserService.RemoveFromTeamAsync(id);
            ToastService.ShowToast($"{user.FullName} retiré de l'équipe.", ToastLevel.Success);
            await LoadTeamAsync();
        }
        catch
        {
            ToastService.ShowToast("Erreur lors du retrait de l'équipe.", ToastLevel.Error);
        }
    }

    private async Task HandleChangeRole(ChangeRoleRequest request)
    {
        try
        {
            if (request.IsRemove)
            {
                await UserService.RemoveRoleAsync(request.UserId, request.NewRole);
                await NotificationService.SendNotificationAsync(request.UserId, $"Le rôle \"{request.NewRole}\" vous a été retiré.");
            }
            else
            {
                await UserService.AssignRoleAsync(request.UserId, request.NewRole);
                await NotificationService.SendNotificationAsync(request.UserId, $"Le rôle \"{request.NewRole}\" vous a été attribué.");
            }
            ToastService.ShowToast("Rôle modifié avec succès.", ToastLevel.Success);
            await LoadTeamAsync();
        }
        catch
        {
            ToastService.ShowToast("Erreur lors du changement de rôle.", ToastLevel.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || responsiveViewApplied)
        {
            return;
        }

        responsiveViewApplied = true;
        var isMobile = await JS.InvokeAsync<bool>("dotnetNigerIsMobile");
        var shouldShowListView = !isMobile;

        if (isListView != shouldShowListView)
        {
            isListView = shouldShowListView;
            StateHasChanged();
        }
    }

    private void NavigateToUsers()
    {
        Navigation.NavigateTo("/admin/users");
    }
}
