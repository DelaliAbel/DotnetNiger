@page "/404"
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Page non trouvée - .NET Niger</PageTitle>

<section class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="max-w-2xl mx-auto px-6 py-16 text-center">

        <div class="mb-8">
            <h1 class="text-9xl font-bold text-secondary opacity-20 select-none">404</h1>
        </div>

        <div class="mb-8">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-800 mb-4">
                Oups ! Page introuvable
            </h2>
            <p class="text-sm sm:text-base md:text-lg text-gray-600 max-w-md mx-auto leading-relaxed">
                La page que vous cherchez n'existe pas ou a été déplacée.
                Vérifiez l'URL ou retournez à l'accueil.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/"
               class="px-8 py-3 text-sm sm:text-base font-semibold bg-secondary text-white rounded-lg hover:bg-blue-700 transition shadow-lg">
                Retour à l'accueil
            </a>
        </div>

    </div>
</section>
