@using DotnetNiger.UI.Components.Admin.Shared
@using System.Security.Claims
@using DotnetNiger.UI.Helpers
@using DotnetNiger.UI.Services.Contracts
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserStateService UserStateService

@if (_authorized)
{
    <div class="flex flex-col h-screen">
       <Topbar ToggleSidebar="ToggleSidebar" ToggleCollapsed="ToggleCollapsed" IsCollapsed="isCollapsed"/>
      <div class="flex flex-1 overflow-hidden">
           <Sidebar IsOpen="sidebarOpen" IsCollapsed="isCollapsed" Closed="ToggleSidebar"/>
        <main class="flex-1 overflow-y-auto bg-background transition-all duration-300">
          <div class="container mx-auto ">
            @Body
          </div>
        </main>
      </div>
    </div>
    <ToastContainer />
    <ConfirmModalContainer />
}

@code{
  bool sidebarOpen = false;
  bool isCollapsed = false;
  bool _authorized;

  protected override async Task OnInitializedAsync()
  {
      var state = await AuthStateProvider.GetAuthenticationStateAsync();
      if (state.User.Identity?.IsAuthenticated != true)
      {
          Navigation.NavigateTo("/", forceLoad: true);
          return;
      }

      if (UserStateService.CurrentUser is null)
          await UserStateService.LoadUserFromStorageAsync();

      var roles = UserStateService.CurrentUser?.Roles ?? [];
      var isAdmin = roles.Any(r => RoleConstants.IsAdminRole(r));
      var isSuperAdmin = roles.Any(r => RoleConstants.IsSuperAdminRole(r));
      var isCollaborator = roles.Any(r => RoleConstants.IsCollaboratorRole(r));
      var hasAccess = isAdmin || isCollaborator;

      if (!hasAccess)
      {
          Navigation.NavigateTo("/", forceLoad: true);
          return;
      }

      var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');

      if (isCollaborator && !isAdmin)
      {
          var redirect = path switch
          {
              "/admin/users" => "/admin",
              "/admin/blog" => "/admin/mes-articles",
              "/admin/events" => "/admin/mes-evenements",
              "/admin/ressources" => "/admin/mes-ressources",
              "/admin/projects" => "/admin/mes-projets",
              "/admin/team" => "/admin",
              "/admin/partners" => "/admin",
              "/admin/comments" => "/admin",
              "/admin/newsletter" => "/admin",
              _ => null
          };
          if (redirect is not null)
          {
              Navigation.NavigateTo(redirect, forceLoad: true);
              return;
          }
      }

      if (!isSuperAdmin && path == "/admin/settings")
      {
          Navigation.NavigateTo("/admin", forceLoad: true);
          return;
      }

      _authorized = true;
  }

  void ToggleCollapsed(){
    isCollapsed = !isCollapsed;
  }
  void ToggleSidebar(){
    sidebarOpen = !sidebarOpen;
  }
}