@page "/admin/mes-projets"
@* @attribute [Authorize(Roles = "Admin,SuperAdmin,Collaborator")] *@
@* Page admin : mes projets (filtrés par utilisateur connecté). *@
@using DotnetNiger.UI.Models.Responses
@using DotnetNiger.UI.Components.Admin.Cards
@inject NavigationManager Navigation
@inject IProjectService ProjectService
@inject IToastService ToastService
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <Skeleton Type="SkeletonType.Title" Class="w-48" />
                    <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-64" />
                </div>
                <Skeleton Type="SkeletonType.Button" Width="160px" />
            </div>

            <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-center">
                <Skeleton Type="SkeletonType.Custom" Class="h-12 rounded-lg flex-1" />
                <Skeleton Type="SkeletonType.Custom" Class="h-12 w-48 rounded-lg" />
            </div>

            <Skeleton Type="SkeletonType.Custom" Class="h-10 w-32 rounded-lg mb-6" />

            <div class="overflow-hidden rounded-lg bg-surface shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Titre</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Auteur</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Statut</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Date</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @for (int i = 0; i < 6; i++)
                            {
                                <tr>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <Skeleton Type="SkeletonType.Custom" Class="h-12 w-12 rounded-lg" />
                                            <div class="space-y-1">
                                                <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-32" />
                                                <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-24" />
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-28" />
                                    </td>
                                    <td class="px-6 py-4">
                                        <Skeleton Type="SkeletonType.Badge" Width="80px" />
                                    </td>
                                    <td class="px-6 py-4">
                                        <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-24" />
                                    </td>
                                    <td class="px-6 py-4">
                                        <Skeleton Type="SkeletonType.Button" Width="32px" Class="h-8" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-6 flex justify-center">
                <Skeleton Type="SkeletonType.Custom" Class="h-10 w-64 rounded-lg" />
            </div>
        </div>
    </div>
}
else
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <section>
                    <AdminBreadcrumb />
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-subtitle md:text-base">Gérez vos projets personnels.</p>
                </section>
                <button @onclick='() => Navigation.NavigateTo("/admin/mes-projets/nouveau")'
                        class="inline-flex items-center gap-2 rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white">
                    <i class="fas fa-plus text-sm"></i>
                    <span class="hidden sm:block">Nouveau projet</span>
                </button>
            </div>

            <section class="mb-6 flex flex-col gap-4 md:flex-row md:items-center">
                <div class="flex-1 rounded-lg bg-surface px-4 py-3 shadow-md">
                    <div class="relative">
                        <i class="fas fa-search absolute left-0 top-1/2 -translate-y-1/2 text-body"></i>
                        <input type="text" placeholder="Rechercher un projet..." @bind="searchQuery" @bind:event="oninput"
                               class="w-full bg-surface pl-7 text-sm text-body outline-none placeholder:text-gray-400" />
                    </div>
                </div>

                <select @bind="selectedStatus"
                        class="cursor-pointer rounded-lg bg-surface px-4 py-3 text-sm text-body shadow-md outline-none transition hover:border-gray-300">
                    <option value="">Tous les statuts</option>
                    <option value="active">Actif</option>
                    <option value="archived">Archivé</option>
                </select>
            </section>
            <div class="mb-6 hidden md:block">
                <ViewToggle @bind-IsListView="isListView" />
            </div>

            @if (isListView)
            {
                <ProjectsTable Projects="pagedProjects" OnChanged="LoadProjectsAsync" />
            }
            else
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-5 lg:gap-6">
                    @foreach (var project in pagedProjects)
                    {
                        <AdminProjectCard @key="project.Id" Project="project" OnProjectDeleted="LoadProjectsAsync" />
                    }
                </div>
            }

            <div class="mt-6">
                <Paginated @bind-CurrentPage="currentPage" TotalPages="@totalPages" />
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isListView = false;
    private bool responsiveViewApplied;
    private string searchQueryValue = string.Empty;
    private string selectedStatusValue = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private List<ProjectResponse> allProjects = new();

    private string searchQuery
    {
        get => searchQueryValue;
        set
        {
            if (searchQueryValue == value) return;
            searchQueryValue = value;
            currentPage = 1;
        }
    }

    private string selectedStatus
    {
        get => selectedStatusValue;
        set
        {
            if (selectedStatusValue == value) return;
            selectedStatusValue = value;
            currentPage = 1;
        }
    }

    private List<ProjectResponse> filteredProjects => allProjects
        .Where(p => string.IsNullOrEmpty(searchQuery) ||
                    p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(selectedStatus) ||
                    p.Status.Equals(selectedStatus, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredProjects.Count / pageSize));

    private List<ProjectResponse> pagedProjects => filteredProjects
        .Skip((SafeCurrentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int SafeCurrentPage => Math.Clamp(currentPage, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        isLoading = true;
        try
        {
            allProjects = await ProjectService.GetMyProjectsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || responsiveViewApplied)
        {
            return;
        }

        responsiveViewApplied = true;
        var isMobile = await JS.InvokeAsync<bool>("dotnetNigerIsMobile");
        var shouldShowListView = !isMobile;

        if (isListView != shouldShowListView)
        {
            isListView = shouldShowListView;
            StateHasChanged();
        }
    }
}
