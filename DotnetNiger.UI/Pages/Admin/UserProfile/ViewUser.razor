@page "/admin/users/{UserId:guid}"
@* @attribute [Authorize(Roles = "Admin,SuperAdmin")] *@
@using DotnetNiger.UI.Models.Requests
@using DotnetNiger.UI.Components.Admin.Shared
@using DotnetNiger.UI.Services.Contracts
@inject IUserService UserService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IToastService ToastService

@if (isLoading)
{
    <div class="mx-auto max-w-7xl px-4 py-6 md:px-6 md:py-8">
        <AdminBreadcrumb />
        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[390px_1fr]">
            <div class="space-y-6">
                <section class="rounded-lg   border-slate-200 bg-surface p-8 shadow-sm">
                    <div class="flex flex-col items-center space-y-4">
                        <Skeleton Type="SkeletonType.Avatar" Size="96px" Class="h-24 w-24" />
                        <Skeleton Type="SkeletonType.Title" Class="w-1/2" />
                        <Skeleton Type="SkeletonType.Text" Lines="2" Class="w-3/4" />
                    </div>
                    <div class="mt-7 space-y-3">
                        <Skeleton Type="SkeletonType.Text" Lines="4" />
                    </div>
                </section>
                <section class="rounded-lg   border-slate-200 bg-surface p-6 shadow-sm">
                    <Skeleton Type="SkeletonType.Title" Class="w-1/3 mb-4" />
                    <div class="flex flex-wrap gap-3">
                        <Skeleton Type="SkeletonType.Badge" Width="40px" />
                        <Skeleton Type="SkeletonType.Badge" Width="40px" />
                        <Skeleton Type="SkeletonType.Badge" Width="40px" />
                    </div>
                </section>
            </div>
            <div class="space-y-6">
                <section class="rounded-lg   border-slate-200 bg-surface p-8 shadow-sm">
                    <Skeleton Type="SkeletonType.Title" Class="w-1/4 mb-4" />
                    <Skeleton Type="SkeletonType.Text" Lines="3" />
                </section>
                <section class="rounded-lg   border-slate-200 bg-surface p-8 shadow-sm">
                    <Skeleton Type="SkeletonType.Title" Class="w-1/3 mb-4" />
                    <div class="flex flex-wrap gap-3">
                        <Skeleton Type="SkeletonType.Badge" />
                        <Skeleton Type="SkeletonType.Badge" />
                        <Skeleton Type="SkeletonType.Badge" />
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else if (user is null)
{
    <div class="mx-auto max-w-7xl px-4 py-6 md:px-6 md:py-8">
        <AdminBreadcrumb />
        <div class="flex flex-col items-center justify-center py-20">
            <i class="fas fa-user-slash text-5xl text-slate-300 mb-4"></i>
            <p class="text-lg text-slate-500">Utilisateur introuvable.</p>
            <button @onclick='() => Navigation.NavigateTo("/admin/Users")'
                    class="mt-4 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500">
                <i class="fas fa-arrow-left"></i> Retour
            </button>
        </div>
    </div>
}
else
{
    <div class="mx-auto max-w-7xl px-4 py-6 md:px-6 md:py-8">
        <AdminBreadcrumb />

        <div class="mb-6">
            <button @onclick='() => Navigation.NavigateTo("/admin/Users")'
                    class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition hover:text-indigo-600">
                <i class="fas fa-arrow-left"></i> Retour aux utilisateurs
            </button>
        </div>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[390px_1fr]">
            <div class="space-y-6">
                <section class="rounded-lg   border-slate-200 bg-surface p-8 shadow-sm">
                    <div class="mb-5 flex justify-center">
                        <ResolvedImage Src="@user.AvatarUrl" Icon="fa-user" alt="Avatar"
                                       class="h-40 w-40 rounded-full border-4 border-indigo-100" />
                    </div>

                    <div class="space-y-2 text-center">
                        <h2 class="text-xl sm:text-4xl font-semibold tracking-tight text-slate-800">
                            @DisplayOrFallback(user.FullName, user.Username)</h2>
                            <p class="text-lg text-slate-500">@DisplayPrimaryRole(user.Roles)</p>
                        </div>

                        <div class="mt-7 space-y-3 text-sm text-slate-700">
                            <div
                                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-2">
                                <i class="fas fa-map-marker-alt text-slate-500"></i>
                                <span>@BuildLocation(user.City, user.Country)</span>
                            </div>
                            <div
                                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-2">
                                <i class="fas fa-envelope text-slate-500"></i>
                                <span>@DisplayOrFallback(user.Email, "Email non renseigne")</span>
                            </div>
                            <div
                                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-2">
                                <i class="fas fa-phone text-slate-500"></i>
                                <span>@DisplayOrFallback(user.PhoneNumber, "Telephone non renseigne")</span>
                            </div>
                            <div
                                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-2">
                                <i class="fas fa-calendar-alt text-slate-500"></i>
                                <span>Membre depuis @FormatMemberSince(user.CreatedAt)</span>
                            </div>
                            <div
                                class="inline-flex w-full items-center justify-center gap-2 rounded-full @(user.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600") px-4 py-2">
                                <span
                                class="h-2.5 w-2.5 rounded-full @(user.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                <span>@(user.IsActive ? "En ligne" : "Hors ligne")</span>
                            </div>
                        </div>
                    </section>

                    <section class="rounded-lg   border-slate-200 bg-surface p-6 shadow-sm">
                        <h3 class="mb-4 text-lg font-semibold text-slate-700">Réseaux sociaux</h3>

                        @if (SocialLinks.Count == 0)
                        {
                            <p class="text-sm text-slate-500">Aucun lien social enregistré.</p>
                        }
                        else
                        {
                            <div class="flex flex-wrap gap-3">
                                @foreach (var link in SocialLinks)
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                                       class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary text-xl text-white transition hover:bg-indigo-500"
                                       title="@link.Platform">
                                        <i class="@link.Icone"></i>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                </div>

                <div class="space-y-6">
                    <section class="rounded-lg   border-slate-200 bg-surface p-8 shadow-sm">
                        <h2 class="mb-4 text-lg font-semibold tracking-tight text-slate-800">A propos</h2>
                        @if (!string.IsNullOrWhiteSpace(user.Bio))
                        {
                            <div class="break-words text-lg leading-relaxed text-slate-600 prose prose-slate max-w-none">@(new
                                                                                                                    MarkupString(HtmlSanitizer.Sanitize(user.Bio)))</div>
                            }
                    else
                            {
                                <p class="max-w-4xl text-lg leading-relaxed text-slate-600">Aucune biographie renseignée.</p>
                            }
                        </section>

                        <section class="rounded-lg   border-slate-200 bg-surface p-8 shadow-sm">
                            <h2 class="mb-4 text-lg font-semibold tracking-tight text-slate-800">Competences et technologies</h2>
                            @if (user.Skills is { Count: > 0 })
                            {
                                <div class="flex flex-wrap gap-3">
                                    @foreach (var skill in user.Skills)
                                    {
                                        <span class="rounded-lg bg-indigo-100 px-4 py-2 text-sm font-semibold text-indigo-700">@skill</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-sm text-slate-500">Aucune compétence renseignée.</p>
                            }
                        </section>

                        <section class="rounded-lg   border-slate-200 bg-surface p-6 shadow-sm">
                            <h3 class="mb-4 text-lg font-semibold text-slate-700">Actions administrateur</h3>
                            <div class="flex flex-wrap gap-3">
                                <button @onclick="ToggleStatusAsync"
                                        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition @(user.IsActive ? "bg-amber-50 text-amber-700 hover:bg-amber-100" : "bg-emerald-50 text-emerald-700 hover:bg-emerald-100")">
                                    <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                    @(user.IsActive ? "Désactiver" : "Activer")
                                </button>

                                <button @onclick="HandleToggleTeam"
                                        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition @(user.IsTeamMember ? "bg-rose-50 text-rose-700 hover:bg-rose-100" : "bg-sky-50 text-sky-700 hover:bg-sky-100")">
                                    <i class="fas @(user.IsTeamMember ? "fa-user-minus" : "fa-user-plus")"></i>
                                    @(user.IsTeamMember ? "Retirer de l'équipe" : "Ajouter à l'équipe")
                                </button>

                                <div class="relative" @onclick:stopPropagation="true">
                                    <button @onclick="() => showRoleMenu = !showRoleMenu"
                                            class="inline-flex items-center gap-2 rounded-lg bg-indigo-50 px-4 py-2.5 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100">
                                        <i class="fas fa-user-tag"></i> Changer le rôle
                                    </button>

                                    @if (showRoleMenu)
                                    {
                                        <div
                                            class="absolute left-0 z-20 mt-2 w-56 rounded-lg   border-slate-200 bg-surface py-2 shadow-lg">
                                            @foreach (var role in AvailableRoles)
                                            {
                                                var isAssigned = user.Roles?.Contains(role) == true;
                                                <button @onclick="() => HandleChangeRoleAsync(role, isAssigned)"
                                                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm transition hover:bg-slate-50 @(isAssigned ? "text-indigo-600 font-semibold" : "text-slate-700")">
                                                    <i
                                                    class="fas @(isAssigned ? "fa-check-circle text-indigo-500" : "fa-circle text-slate-300")"></i>
                                                    @role
                                                    @if (isAssigned)
                                                    {
                                                        <span class="ml-auto text-xs text-slate-400">assigné</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        }

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private UserDto? user;
    private List<SocialLinkDto> SocialLinks => user?.SocialLinks ?? new();
    private bool isLoading = true;
    private bool showRoleMenu;

    private readonly List<string> AvailableRoles = new()
    {
        "Admin",
        "SuperAdmin",
        "Collaborator",
        "Member"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await UserService.GetUserByIdAsync(UserId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleStatusAsync()
    {
        if (user is null) return;

        try
        {
            user.IsActive = !user.IsActive;
            await UserService.UpdateUserAsync(user);
            ToastService.ShowToast(user.IsActive ? "Utilisateur activé." : "Utilisateur désactivé.", ToastLevel.Success);
        }
        catch
        {
            ToastService.ShowToast("Erreur lors du changement de statut.", ToastLevel.Error);
        }
    }

    private async Task HandleToggleTeam()
    {
        if (user is null) return;

        try
        {
            if (user.IsTeamMember)
            {
                await UserService.RemoveFromTeamAsync(user.Id);
                await NotificationService.SendNotificationAsync(user.Id, "Vous avez été retiré(e) de l'équipe DotnetNiger.");
                ToastService.ShowToast("Utilisateur retiré de l'équipe.", ToastLevel.Success);
            }
            else
            {
                await UserService.AddToTeamAsync(user.Id, string.Empty);
                await NotificationService.SendNotificationAsync(user.Id, "Vous avez été intégré(e) à l'équipe DotnetNiger.");
                ToastService.ShowToast("Utilisateur intégré à l'équipe.", ToastLevel.Success);
            }

            user = await UserService.GetUserByIdAsync(UserId);
        }
        catch
        {
            ToastService.ShowToast("Erreur lors de la modification de l'équipe.", ToastLevel.Error);
        }
    }

    private async Task HandleChangeRoleAsync(string role, bool isAssigned)
    {
        if (user is null) return;
        showRoleMenu = false;

        try
        {
            if (isAssigned)
            {
                await UserService.RemoveRoleAsync(user.Id, role);
                await NotificationService.SendNotificationAsync(user.Id, $"Le rôle \"{role}\" vous a été retiré.");
            }
            else
            {
                await UserService.AssignRoleAsync(user.Id, role);
                await NotificationService.SendNotificationAsync(user.Id, $"Le rôle \"{role}\" vous a été attribué.");
            }

            ToastService.ShowToast("Rôle modifié avec succès.", ToastLevel.Success);
            user = await UserService.GetUserByIdAsync(UserId);
        }
        catch
        {
            ToastService.ShowToast("Erreur lors du changement de rôle.", ToastLevel.Error);
        }
    }

    private static string DisplayOrFallback(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string BuildLocation(string? city, string? country)
    {
        var hasCity = !string.IsNullOrWhiteSpace(city);
        var hasCountry = !string.IsNullOrWhiteSpace(country);
        return (hasCity, hasCountry) switch
        {
            (true, true) => $"{city}, {country}",
            (true, false) => city!,
            (false, true) => country!,
            _ => "Non renseignée"
        };
    }

    private static string DisplayPrimaryRole(List<string>? roles)
        => (roles is { Count: > 0 }) ? roles[0] : "Membre .NET Niger";

    private static string FormatMemberSince(DateTime createdAt)
        => createdAt.ToString("MMMM yyyy");

}
