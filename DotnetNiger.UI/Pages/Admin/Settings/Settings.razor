        <div class="mx-auto max-w-7xl">
            <div class="mb-8">
                <AdminBreadcrumb />
                <p class="mt-2 max-w-2xl text-sm leading-6 text-body md:text-base">Configurez les paramètres généraux du
                    site.</p>
                </div>

                <div class="mb-8 border-b">
                    <nav class="flex flex-wrap gap-1" role="tablist">
                        @foreach (var tab in tabs)
                        {
                            <button @onclick='() => activeTab = tab.id'
                                    class="px-5 py-3 text-sm font-medium transition border-b-2 @(activeTab == tab.id ? "border-title text-title" : "border-transparent text-body hover:text-title")"
