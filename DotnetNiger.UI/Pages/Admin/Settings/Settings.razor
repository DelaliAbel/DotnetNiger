@page "/admin/settings"
@* @attribute [Authorize(Roles = "Admin,SuperAdmin")] *@
@using DotnetNiger.UI.Helpers
@inject ISettingsService SettingsService
@inject IToastService ToastService
@inject IUserStateService UserStateService
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <Skeleton Type="SkeletonType.Title" Class="w-48 mb-6" />
            <div class="space-y-6">
                @for (int i = 0; i < 3; i++)
                {
                    <section class="rounded-lg bg-surface p-6 shadow-sm">
                        <Skeleton Type="SkeletonType.Title" Class="w-1/3 mb-4" />
                        <div class="space-y-4">
                            <Skeleton Type="SkeletonType.Custom" Class="h-12 rounded-lg w-full" />
                            <Skeleton Type="SkeletonType.Custom" Class="h-12 rounded-lg w-full" />
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
}
else
{
