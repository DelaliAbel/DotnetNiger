@page "/admin/mes-articles/nouveau"
@attribute [Authorize(Roles = "Admin,SuperAdmin,Collaborator")]
@* Page admin : création d'article (mes articles). *@
@using DotnetNiger.UI.Models
@using DotnetNiger.UI.Components.Admin
@using DotnetNiger.UI.Components.Shared
@inject NavigationManager NavigationManager
@inject IPostService PostService
@inject IUserStateService UserStateService
@inject IProfileService ProfileService
@inject IToastService ToastService
@inject PreviewStateService PreviewState
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="min-h-screen bg-primary p-6">
    <div class="mb-6 flex items-center justify-between">
        <AdminBreadcrumb />
        <button @onclick="GoBack"
                class="bg-red-500 hover:bg-red-600 text-white min-h-12 px-4 py-2 rounded-lg flex items-center gap-2">
            <i class="fas fa-arrow-left text-2xl"></i>
            <span class="Button">Retour</span>
        </button>
    </div>

    <div class="rounded-lg bg-white p-6 shadow">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
            <div class="lg:col-span-2 order-2 lg:order-1 space-y-6">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-gray-700">Titre</label>
                    <input @bind="postRequest.Title" type="text"
                           class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:outline-none" />
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-gray-700">Type d'article</label>
                    <select @bind="postRequest.PostType"
                            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 focus:outline-none">
                        <option value="">Sélectionner</option>
                        <option value="Tutorial">Tutorial</option>
                        <option value="Article">Article</option>
                        <option value="Interview">Interview</option>
                    </select>
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-gray-700">Contenu</label>
                    <Editor @ref="EditorRef" EditorId="blogDescriptionMy" InitialContent="@postRequest.Content" />
                    @if (showContentError)
                    {
                        <p class="text-red-500 text-sm mt-1">Le contenu de l'article est obligatoire.</p>
                    }
                </div>

                @* Tags *@
                <div>
                    <label class="mb-2 block text-sm font-semibold text-gray-700">Tags</label>
                    <div class="flex gap-2">
                        <input @bind="tagInput" @onkeydown="HandleTagKeyDown" type="text"
                               class="flex-1 rounded-lg border border-gray-300 px-4 py-3 focus:outline-none"
                               placeholder="Saisir un tag puis Entrée" />
                        <button type="button" @onclick="AddTag"
                                class="rounded-lg bg-primary px-4 text-sm font-semibold text-white transition hover:brightness-110">
                            Ajouter
                        </button>
                    </div>
                    @if (postRequest.TagNames.Any())
                    {
                        <div class="mt-3 flex flex-wrap gap-2">
                            @for (int i = 0; i < postRequest.TagNames.Count; i++)
                            {
                                <span
                                    class="inline-flex items-center gap-1 rounded-full bg-tag-bg px-3 py-1.5 text-xs font-semibold text-gray-700">
                                    #@postRequest.TagNames[i]
                                    <button type="button" @onclick="() => RemoveTag(i)"
                                            class="ml-0.5 text-gray-400 hover:text-red-500">
                                        <i class="fas fa-times text-[10px]"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="order-1 lg:order-2">
                <label class="mb-2 block text-sm font-semibold text-gray-700">Image de couverture</label>
                <ImageUploader UploadType="UploadType.Blog" ExistingImageUrl="@postRequest.CoverImageUrl"
                               OnImageUploaded="HandleImageUploaded" OnImageDeleted="HandleImageDeleted" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-600">@errorMessage</div>
        }

        <div class="mt-6 flex flex-wrap gap-4">
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-purple-800"
                    @onclick="@HandleSubmit">
                <i class="fas fa-paper-plane"></i>
                Publier
            </button>
            <button type="button" @onclick="HandlePreview"
                    class="flex items-center gap-2 rounded-lg bg-gray-700 px-6 py-3 text-white transition hover:bg-gray-800">
                <i class="fas fa-eye"></i>
                Aperçu
            </button>
        </div>
    </div>
</div>

@code {
    private CreatePostRequest postRequest = new();
    private string errorMessage = string.Empty;

    private bool showContentError;
    private Guid currentUserId;
    private Editor EditorRef = default!;
    private string tagInput = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!(authState.User.Identity?.IsAuthenticated ?? false))
            return;

        // Restaurer le formulaire si on revient d'un aperçu
        if (PreviewState.PendingPostRequest is not null && PreviewState.ReturnUrl == "/admin/mes-articles/nouveau")
        {
            postRequest = PreviewState.PendingPostRequest;
            PreviewState.PendingPostRequest = null;
        }

        // Charger depuis UserStateService ; fallback sur ProfileService puis synchroniser.
        if (UserStateService.CurrentUser is null)
            await UserStateService.LoadUserFromStorageAsync();

        if (UserStateService.CurrentUser is null)
        {
            var profil = await ProfileService.GetProfileAsync();
            if (profil.Id != Guid.Empty)
                await UserStateService.SetUserAsync(profil);
        }

        currentUserId = UserStateService.UserId;
    }
    private void HandleImageUploaded(string imageUrl)
    {
        postRequest.CoverImageUrl = imageUrl;
    }

    private void HandleImageDeleted()
    {
        postRequest.CoverImageUrl = string.Empty;
    }

    private void AddTag()
    {
        var tag = tagInput?.Trim();
        if (string.IsNullOrWhiteSpace(tag)) return;
        if (postRequest.TagNames.Contains(tag, StringComparer.OrdinalIgnoreCase)) return;
        postRequest.TagNames.Add(tag);
        tagInput = string.Empty;
    }

    private void RemoveTag(int index)
    {
        if (index >= 0 && index < postRequest.TagNames.Count)
            postRequest.TagNames.RemoveAt(index);
    }

    private void HandleTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag();
        }
    }

    private async Task HandlePreview()
    {
        postRequest.Content = await EditorRef.GetContentAsync();

        PreviewState.PendingPostRequest = new CreatePostRequest
        {
            Title = postRequest.Title,
            Content = postRequest.Content,
            Excerpt = postRequest.Excerpt,
            CoverImageUrl = postRequest.CoverImageUrl,
            PostType = postRequest.PostType,
            CategoryIds = postRequest.CategoryIds.ToList(),
            TagNames = postRequest.TagNames.ToList(),
            IsPublished = postRequest.IsPublished
        };

        var previewDto = new PostDto
        {
            Id = Guid.Empty,
            Title = postRequest.Title,
            Content = postRequest.Content,
            Excerpt = postRequest.Excerpt,
            CoverImageUrl = postRequest.CoverImageUrl,
            AuthorName = UserStateService.UserName,
            AuthorAvatar = UserStateService.CurrentUser?.AvatarUrl ?? string.Empty,
            AuthorId = currentUserId,
            PostType = postRequest.PostType,
            PublishedAt = DateTime.Now,
            Tags = postRequest.TagNames.Select(t => new TagDto { Name = t }).ToList()
        };

        PreviewState.SetBlogPreview(previewDto, "/admin/mes-articles/nouveau");
        NavigationManager.NavigateTo("/preview/blog");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin/mes-articles");
    }

    private async Task HandleSubmit()
    {

        errorMessage = string.Empty;
        showContentError = false;

        postRequest.Content = await EditorRef.GetContentAsync();

        if (string.IsNullOrWhiteSpace(postRequest.Title))
        {
            errorMessage = "Le titre est obligatoire.";
            return;
        }

        if (string.IsNullOrWhiteSpace(postRequest.PostType))
        {
            errorMessage = "Le type d'article est obligatoire.";
            return;
        }

        if (string.IsNullOrWhiteSpace(postRequest.Content) ||
        postRequest.Content is "<p></p>" or "<p><br></p>")
        {
            showContentError = true;
            return;
        }

        try
        {
            postRequest.IsPublished = true;
            postRequest.Excerpt = BuildExcerpt(postRequest.Content);
            await PostService.CreatePostAsync(postRequest, currentUserId);
            ToastService.ShowToast("Article créé avec succès.", ToastLevel.Success);
            NavigationManager.NavigateTo("/admin/mes-articles");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            ToastService.ShowToast("Erreur lors de la création.", ToastLevel.Error);
        }
    }

    private static string BuildExcerpt(string content)
    {
        var plain = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", string.Empty);
        plain = System.Net.WebUtility.HtmlDecode(plain).Trim();
        return plain.Length <= 120 ? plain : $"{plain[..120].Trim()}...";
    }

}
