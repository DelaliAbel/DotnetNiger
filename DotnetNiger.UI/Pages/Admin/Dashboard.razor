@page "/admin"
@* @attribute [Authorize] *@
@* Page admin : tableau de bord (KPI + listes récentes) alimenté par services. *@
@using DotnetNiger.UI.Helpers
@using System.Security.Claims
@inject IStatsService StatsService
@inject IPostService PostService
@inject IEventService EventService
@inject IResourceService ResourceService

@inject AuthenticationStateProvider AuthStateProvider
@inject IUserStateService UserStateService
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IUploadService UploadService
@inject ICertificateAdminService CertificateAdminService
@inject IConfirmService ConfirmService
@inject IToastService ToastService

<div
	class="min-h-screen px-3 sm:px-4 py-4 sm:py-6 md:px-8 md:py-8">
	<div class="mx-auto max-w-7xl">
		<AdminBreadcrumb />

		@if (!isLoading)
		{
			<section class="mt-2 flex flex-col gap-3">
				<div class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-accent">
					<span class="h-2 w-2 sm:h-2.5 sm:w-2.5 rounded-full bg-accent"></span>
					Administration
				</div>
				<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h1 class="text-lg sm:text-3xl md:text-4xl font-bold tracking-tight text-title">Tableau de bord</h1>
						<p class="mt-2 max-w-lg text-xs sm:text-sm leading-5 sm:leading-6 text-subtitle md:text-base">Aperçu
							rapide des performances, des validations en attente et des activités clés du site.</p>
						</div>

						<div
							class="w-full max-w-md rounded-lg bg-surface p-3 sm:p-4 shadow-md">
							<div class="flex items-center gap-2 sm:gap-3">
								<div
									class="flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center overflow-hidden rounded-lg bg-fond_transparent text-accent flex-shrink-0">
									@if (CurrentUserHasAvatar)
									{
										<ResolvedImage Src="@CurrentUser?.AvatarUrl" alt="@CurrentUserDisplayName"
													   class="h-full w-full object-cover" />
									}
									else
									{
										<span class="text-sm sm:text-lg font-semibold">@CurrentUserInitial</span>
									}
								</div>
								<div class="min-w-0">
									<p class="truncate text-xs sm:text-sm font-semibold text-title">@CurrentUserDisplayName</p>
									<p class="truncate text-[10px] sm:text-xs text-muted">@CurrentUserRoleLabel</p>
								</div>
							</div>
							<div class="mt-3 sm:mt-4 grid grid-cols-2 gap-2 sm:gap-3">
								<div class="rounded-lg bg-surface px-2 sm:px-3 py-2 sm:py-3">
									<p class="text-[10px] sm:text-[11px] font-semibold uppercase tracking-wide text-muted">
										Statut</p>
										<p class="mt-0.5 sm:mt-1 text-xs sm:text-sm font-semibold text-title">@(IsCurrentUserLoaded
																																									? (IsCurrentUserActive ? "Actif" : "Inactif") : "En cours")</p>
										</div>
										<div class="rounded-lg bg-surface px-2 sm:px-3 py-2 sm:py-3">
											<p class="text-[10px] sm:text-[11px] font-semibold uppercase tracking-wide text-muted">Accès
											</p>
											<p class="mt-0.5 sm:mt-1 text-xs sm:text-sm font-semibold text-title">@(IsCurrentUserAdmin ?
																																												"Administration" : "Membre")</p>
											</div>
										</div>
									</div>
								</div>
							</section>

							<section class="mt-6 sm:mt-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 sm:gap-5">
								@foreach (var metric in Metrics)
								{
									<article
										class="overflow-hidden rounded-lg bg-surface shadow-md">
										<div
											class="flex flex-col items-center justify-center gap-1.5 sm:gap-3 px-2 sm:px-6 py-3 sm:py-7 text-center min-h-[90px] sm:min-h-[150px]">
											<div
												class="flex h-8 w-8 sm:h-12 sm:w-12 items-center justify-center rounded-lg bg-fond_transparent text-accent">
												<i class="@metric.IconClass text-base sm:text-lg"></i>
											</div>
											<p class="text-lg sm:text-3xl md:text-4xl font-semibold leading-none text-title">@metric.Value</p>
											<p class="text-[10px] sm:text-sm font-medium text-body">@metric.Label</p>
										</div>
										<button type="button"
												class="flex w-full items-center justify-center gap-1 sm:gap-2 border-t border-fondTransparent bg-fondTransparent px-2 sm:px-4 py-2 sm:py-3 text-[10px] sm:text-sm font-semibold text-title transition hover:brightness-95"
												@onclick='() => Navigation.NavigateTo(metric.Url)'>
											Voir Les Détails <i class="fas fa-angle-double-right text-[10px] sm:text-xs"></i>
										</button>
									</article>
								}
							</section>

							<section class="mt-6 sm:mt-8 grid gap-4 sm:gap-6 xl:grid-cols-2">
							@if (!IsCurrentUserCollaborator || IsCurrentUserAdmin)
							{
								<article
									class="rounded-lg bg-surface p-4 sm:p-5 md:p-6 shadow-md">
									<div class="flex items-center justify-between gap-2 sm:gap-3">
										<div class="flex items-center gap-2 sm:gap-3 min-w-0">
											<div
												class="flex h-9 w-9 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-fond_transparent text-accent">
												<i class="fas fa-certificate text-sm sm:text-lg"></i>
											</div>
											<div class="min-w-0">
												<h2 class="text-sm sm:text-lg font-semibold text-title truncate">Validation de certificat</h2>
												<p class="text-xs sm:text-sm text-muted truncate">Certificats en attente de validation</p>
											</div>
										</div>
										<span
										class="rounded-full bg-fond_transparent px-2 sm:px-3 py-0.5 sm:py-1 text-xs font-semibold text-accent flex-shrink-0">@PendingCertificates.Count</span>
									</div>

									<div class="mt-3 sm:mt-5 space-y-2 sm:space-y-3">
										@if (PendingCertificates.Count == 0)
										{
											<p class="rounded-lg border-dashed px-3 sm:px-4 py-4 sm:py-6 text-xs sm:text-sm text-muted">
												Aucun certificat en attente de validation.</p>
										}
										else
										{
											@foreach (var cert in PendingCertificates)
											{
												<div
													class="flex items-center justify-between gap-2 sm:gap-3 rounded-lg border-gray-100 bg-surface px-2 sm:px-3 py-2 sm:py-3 shadow-sm">
													<div class="flex min-w-0 items-center gap-2 sm:gap-3">
														<div
															class="flex h-8 w-8 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center overflow-hidden rounded-lg bg-gray-100 text-accent">
															@if (!string.IsNullOrWhiteSpace(cert.AvatarUrl))
															{
																<ResolvedImage Src="@cert.AvatarUrl" alt="@cert.UserName"
																			   class="h-full w-full object-cover" />
															}
															else
															{
																<span
																	class="text-[10px] sm:text-sm font-semibold">@(string.IsNullOrWhiteSpace(cert.UserName)
																							? "U" : cert.UserName[..1].ToUpperInvariant())</span>
															}
														</div>
														<div class="min-w-0">
															<p class="truncate text-xs sm:text-sm font-semibold text-title">@cert.UserName</p>
															<p class="truncate text-[10px] sm:text-xs text-muted">@cert.UserEmail</p>
															<p class="truncate text-[10px] sm:text-xs text-placeholder hidden sm:block">@cert.CertificateType</p>
														@if (!string.IsNullOrWhiteSpace(cert.CertificateUrl))
														{
															<a href="@cert.CertificateUrl" target="_blank" rel="noopener noreferrer"
															   class="mt-1 inline-flex items-center gap-1 text-[10px] sm:text-xs text-accent hover:underline">
																<i class="fas fa-external-link-alt"></i> Vérifier le certificat
															</a>
														}
														</div>
													</div>
													<AdminActionDropdown ItemId="cert.Id" Status="Pending" ViewLabel="Voir" EditLabel="Modifier"
																		 DeleteLabel="Rejeter" ApproveLabel="Approuver" RejectLabel="Rejeter"
																		 OnView="HandleViewCertificateAsync" OnEdit="HandleEditCertificateAsync"
																		 OnDelete="HandleRejectCertificateAsync" OnApprove="HandleApproveCertificateAsync"
																		 OnReject="HandleRejectCertificateAsync" />
												</div>
											}
										}
									</div>
								</article>

								<article
									class="rounded-lg bg-surface p-4 sm:p-5 md:p-6 shadow-md">
									<div class="flex items-center justify-between gap-2 sm:gap-3">
										<div class="flex items-center gap-2 sm:gap-3 min-w-0">
											<div
												class="flex h-9 w-9 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-info-light-bg text-info">
												<i class="fas fa-calendar-check text-sm sm:text-lg"></i>
											</div>
											<div class="min-w-0">
												<h2 class="text-sm sm:text-lg font-semibold text-title truncate">File de validation</h2>
												<p class="text-xs sm:text-sm text-muted truncate">Événements en attente</p>
											</div>
										</div>
										<span
										class="rounded-full bg-info-light-bg px-2 sm:px-3 py-0.5 sm:py-1 text-xs font-semibold text-info flex-shrink-0">@PendingEvents.Count</span>
									</div>

									<div class="mt-3 sm:mt-5 space-y-2 sm:space-y-3">
										@if (PendingEvents.Count == 0)
										{
											<p class="rounded-lg border-dashed px-3 sm:px-4 py-4 sm:py-6 text-xs sm:text-sm text-muted">
												Aucun événement en attente de validation.</p>
										}
										else
										{
											@foreach (var item in PendingEvents)
											{
												<div
													class="flex items-center justify-between gap-2 sm:gap-3 rounded-lg border-gray-100 bg-surface px-2 sm:px-3 py-2 sm:py-3 shadow-sm">
													<div class="flex min-w-0 items-center gap-2 sm:gap-3">
														<div class="h-8 w-8 sm:h-11 sm:w-11 flex-shrink-0 overflow-hidden rounded-lg bg-gray-100">
															@if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
															{
																<ResolvedImage Src="@item.CoverImageUrl" alt="@item.Title"
																			   class="h-full w-full object-cover" />
															}
															else
															{
																<div class="flex h-full w-full items-center justify-center text-accent"><i
																	class="fas fa-pen-nib text-xs sm:text-base"></i></div>
															}
														</div>
														<div class="min-w-0">
															<p class="truncate text-xs sm:text-sm font-semibold text-title">@item.Title</p>
															<p class="truncate text-[10px] sm:text-xs text-muted">@item.Description</p>
														</div>
													</div>
													<AdminActionDropdown ItemId="item.Id" Status="Pending" ViewLabel="Voir" EditLabel="Modifier"
																		 DeleteLabel="Supprimer" ApproveLabel="Approuver" RejectLabel="Rejeter"
																		 OnView="HandleViewAsync" OnEdit="HandleEditAsync" OnDelete="HandleDeleteAsync"
																		 OnApprove="HandleApproveAsync" OnReject="HandleRejectAsync" />
												</div>
											}
										}
									</div>
								</article>

								<article
									class="rounded-lg bg-surface p-4 sm:p-5 md:p-6 shadow-md">
									<div class="flex items-center justify-between gap-2 sm:gap-3">
										<div class="flex items-center gap-2 sm:gap-3 min-w-0">
											<div
												class="flex h-9 w-9 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-success-light-bg text-success">
												<i class="fas fa-folder-open text-sm sm:text-lg"></i>
											</div>
											<div class="min-w-0">
												<h2 class="text-sm sm:text-lg font-semibold text-title truncate">Ressources récentes</h2>
												<p class="text-xs sm:text-sm text-muted truncate">Documents les plus consultés</p>
											</div>
										</div>
										<span
										class="rounded-full bg-success-light-bg px-2 sm:px-3 py-0.5 sm:py-1 text-xs font-semibold text-success flex-shrink-0">@RecentResources.Count</span>
									</div>

									<div class="mt-3 sm:mt-5 space-y-2 sm:space-y-3">
										@if (RecentResources.Count == 0)
										{
											<p class="rounded-lg border-dashed px-3 sm:px-4 py-4 sm:py-6 text-xs sm:text-sm text-muted">
												Aucune ressource disponible.</p>
										}
										else
										{
											@foreach (var item in RecentResources)
											{
												<div
													class="flex items-center justify-between gap-2 sm:gap-3 rounded-lg border-gray-100 bg-surface px-2 sm:px-3 py-2 sm:py-3 shadow-sm">
													<div class="flex min-w-0 items-center gap-2 sm:gap-3">
														<div
															class="flex h-8 w-8 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-surface-alt text-title">
															<i class="fas fa-folder-open text-xs sm:text-base"></i>
														</div>
														<div class="min-w-0">
															<p class="truncate text-xs sm:text-sm font-semibold text-title">@item.Title</p>
															<p class="truncate text-[10px] sm:text-xs text-muted">@item.Subtitle</p>
														</div>
													</div>
													<AdminActionDropdown ItemId="item.Id" Status="Published" ViewLabel="Voir" EditLabel="Modifier"
																		 DeleteLabel="Supprimer" OnView="HandleViewAsync" OnEdit="HandleEditAsync"
																		 OnDelete="HandleDeleteAsync" />
												</div>
											}
										}
									</div>
								</article>

								<article
									class="rounded-lg bg-surface p-4 sm:p-5 md:p-6 shadow-md">
									<div class="flex items-center justify-between gap-2 sm:gap-3">
										<div class="flex items-center gap-2 sm:gap-3 min-w-0">
											<div
												class="flex h-9 w-9 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-fond_transparent text-accent">
												<i class="fas fa-code-branch text-sm sm:text-lg"></i>
											</div>
											<div class="min-w-0">
												<h2 class="text-sm sm:text-lg font-semibold text-title truncate">Projets récents</h2>
												<p class="text-xs sm:text-sm text-muted truncate">Derniers projets publiés</p>
											</div>
										</div>
										<button type="button"
												class="text-xs sm:text-sm font-semibold text-accent transition hover:text-accent-active flex-shrink-0"
												@onclick='() => Navigation.NavigateTo("/admin/projects")'>Voir tout</button>
									</div>

									<div class="mt-3 sm:mt-5 space-y-2 sm:space-y-3">
										@if (RecentProjects.Count == 0)
										{
											<p class="rounded-lg border-dashed px-3 sm:px-4 py-4 sm:py-6 text-xs sm:text-sm text-muted">
												Aucun projet récent disponible.</p>
										}
										else
										{
											@foreach (var item in RecentProjects)
											{
												<div
													class="flex items-center justify-between gap-2 sm:gap-3 rounded-lg border-gray-100 bg-surface px-2 sm:px-3 py-2 sm:py-3 shadow-sm">
													<div class="flex min-w-0 items-center gap-2 sm:gap-3">
														<div
															class="flex h-8 w-8 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-fond_transparent text-accent">
															<i class="fas fa-code-branch text-xs sm:text-base"></i>
														</div>
														<div class="min-w-0">
															<p class="truncate text-xs sm:text-sm font-semibold text-title">@item.Title</p>
															<p class="truncate text-[10px] sm:text-xs text-muted">@item.Subtitle</p>
														</div>
													</div>
													<AdminActionDropdown ItemId="item.Id" Status="Published" ViewLabel="Voir" EditLabel="Modifier"
																		 DeleteLabel="Supprimer" OnView="HandleViewAsync" OnEdit="HandleEditAsync"
																		 OnDelete="HandleDeleteAsync" />
												</div>
											}
										}
									</div>
								</article>

								<article
									class="rounded-lg bg-surface p-4 sm:p-5 md:p-6 shadow-md xl:col-span-2">
									<div class="flex items-center justify-between gap-2 sm:gap-3">
										<div class="flex items-center gap-2 sm:gap-3 min-w-0">
											<div
												class="flex h-9 w-9 sm:h-11 sm:w-11 flex-shrink-0 items-center justify-center rounded-lg bg-[#FFF7ED] text-[#ea580c]">
												<i class="fas fa-calendar-days text-sm sm:text-lg"></i>
											</div>
											<div class="min-w-0">
												<h2 class="text-sm sm:text-lg font-semibold text-title truncate">Événements récents</h2>
												<p class="text-xs sm:text-sm text-muted truncate">Dernières publications visibles</p>
											</div>
										</div>
										<button type="button"
												class="text-xs sm:text-sm font-semibold text-accent transition hover:text-accent-active flex-shrink-0"
												@onclick='() => Navigation.NavigateTo("/admin/events")'>Voir tout</button>
									</div>

									<div class="mt-3 sm:mt-5 space-y-2 sm:space-y-3">
										@if (RecentEvents.Count == 0)
										{
											<p class="rounded-lg border-dashed px-3 sm:px-4 py-4 sm:py-6 text-xs sm:text-sm text-muted">
												Aucun évènement récent disponible.</p>
										}
										else
										{
											@foreach (var item in RecentEvents)
											{
												<div
													class="flex items-center justify-between gap-1 sm:gap-4 rounded-lg border-gray-100 bg-surface px-1.5 sm:px-3 py-2 sm:py-3 shadow-sm">
													<div class="flex min-w-0 items-center gap-1.5 sm:gap-3">
														<div class="h-8 w-8 sm:h-12 sm:w-12 flex-shrink-0 overflow-hidden rounded-lg bg-gray-100">
															@if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
															{
																<ResolvedImage Src="@item.CoverImageUrl" alt="@item.Title"
																			   class="h-full w-full object-cover" />
															}
															else
															{
																<div class="flex h-full w-full items-center justify-center text-accent"><i
																	class="fas fa-calendar text-xs sm:text-base"></i></div>
															}
														</div>
														<div class="min-w-0">
															<p class="truncate text-xs sm:text-sm font-semibold text-title">@item.Title</p>
															<p class="truncate text-[10px] sm:text-xs text-muted">@item.Subtitle</p>
														</div>
													</div>
													<div class="flex items-center gap-1 sm:gap-3 flex-shrink-0">
														<span
														class="rounded-md px-1.5 sm:px-3 py-1 sm:py-1.5 text-[10px] sm:text-xs font-semibold @GetEventStatusClass(item) hidden sm:inline-block">@GetEventStatusLabel(item)</span>
														<AdminActionDropdown ItemId="item.Id" Status="@(item.IsPublished ? "Published" : "Pending")"
																			 ViewLabel="Voir l'article" EditLabel="Modifier" DeleteLabel="Supprimer"
																			 ApproveLabel="Publier" RejectLabel="Supprimer" OnView="HandleViewAsync"
																			 OnEdit="HandleEditAsync" OnDelete="HandleDeleteAsync" OnApprove="HandleApproveAsync"
																			 OnReject="HandleRejectAsync" />
													</div>
												</div>
											}
										}
									</div>
								</article>
							}
							</section>
															}
		else
															{
																<section class="mt-2 flex flex-col gap-3">
																	<div class="inline-flex items-center gap-2 text-sm font-semibold text-accent">
																		<span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
																		Administration
																	</div>
																	<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
																		<div>
																			<Skeleton Type="SkeletonType.Title" Class="h-8 w-64" />
																			<Skeleton Type="SkeletonType.Text" Lines="1" Class="w-96 mt-2" />
																		</div>
																		<Skeleton Type="SkeletonType.Custom" Class="h-24 w-80 rounded-[18px]" />
																	</div>
																</section>

																<section class="mt-6 sm:mt-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-5">
																	@for (int i = 0; i < 5; i++)
																	{
																		<article
																			class="overflow-hidden rounded-[18px] bg-surface shadow-md">
																			<div
																				class="flex flex-col items-center justify-center gap-1.5 sm:gap-3 px-2 sm:px-6 py-3 sm:py-7 text-center min-h-[90px] sm:min-h-[150px]">
																				<Skeleton Type="SkeletonType.Custom" Class="h-8 w-8 sm:h-12 sm:w-12 rounded-lg" />
																				<Skeleton Type="SkeletonType.Title" Class="h-5 w-10 sm:h-8 sm:w-16" />
																				<Skeleton Type="SkeletonType.Text" Lines="1" Class="w-12 sm:w-20" />
																			</div>
																			<Skeleton Type="SkeletonType.Custom" Class="h-8 sm:h-11 w-full rounded-none" />
																		</article>
																	}
																</section>

																<section class="mt-6 sm:mt-8 grid gap-4 sm:gap-6 xl:grid-cols-2">
																	@for (int i = 0; i < 4; i++)
																	{
																		<article
																			class="rounded-lg bg-surface p-4 sm:p-5 md:p-6 shadow-md">
																			<div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-5">
																				<Skeleton Type="SkeletonType.Custom" Class="h-9 w-9 sm:h-11 sm:w-11 rounded-lg flex-shrink-0" />
																				<div class="flex-1 min-w-0">
																					<Skeleton Type="SkeletonType.Title" Class="h-4 sm:h-5 w-32 sm:w-48" />
																					<Skeleton Type="SkeletonType.Text" Lines="1" Class="w-40 sm:w-64 mt-1" />
																				</div>
																				<Skeleton Type="SkeletonType.Badge" Width="24px" Class="h-5 sm:h-6 flex-shrink-0" />
																			</div>
																			<div class="space-y-2 sm:space-y-3">
																				@for (int j = 0; j < 5; j++)
																				{
																					<div
