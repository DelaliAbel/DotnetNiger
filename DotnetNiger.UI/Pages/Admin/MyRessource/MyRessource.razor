@page "/admin/mes-ressources"
@attribute [Authorize(Roles = "Admin,SuperAdmin,Collaborator")]
@* Page admin : mes ressources (filtrées par utilisateur connecté). *@
@inject NavigationManager Navigation
@inject IResourceService ResourceService
@inject IToastService ToastService
@inject IJSRuntime JS
@using DotnetNiger.UI.Components.Admin.Cards
@using DotnetNiger.UI.Components.Admin.Shared
@using DotnetNiger.UI.Components.Cards

<div class="p-6 bg-primary">
    @if (isLoading)
    {
        <div class="flex justify-between items-center mb-6">
            <Skeleton Type="SkeletonType.Title" Class="w-48" />
            <Skeleton Type="SkeletonType.Button" Width="140px" />
        </div>

        <div class="flex gap-4 mb-6">
            <Skeleton Type="SkeletonType.Custom" Class="h-12 rounded-lg flex-1" />
            <Skeleton Type="SkeletonType.Custom" Class="h-12 w-40 rounded-lg" />
            <Skeleton Type="SkeletonType.Custom" Class="h-12 w-40 rounded-lg" />
        </div>

        <Skeleton Type="SkeletonType.Custom" Class="h-10 w-32 rounded-lg mb-6" />

        <div class="bg-surface rounded-lg shadow overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-title">Titre</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-title">Type</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-title">Niveau</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-title">URL</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-title">Vues</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-title">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < 6; i++)
                    {
                        <tr class="border-b">
                            <td class="px-6 py-4">
                                <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-36" />
                            </td>
                            <td class="px-6 py-4">
                                <Skeleton Type="SkeletonType.Badge" Width="100px" />
                            </td>
                            <td class="px-6 py-4">
                                <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-20" />
                            </td>
                            <td class="px-6 py-4">
                                <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-40" />
                            </td>
                            <td class="px-6 py-4">
                                <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-12" />
                            </td>
                            <td class="px-6 py-4">
                                <Skeleton Type="SkeletonType.Button" Width="32px" Class="h-8" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-6 flex justify-center">
            <Skeleton Type="SkeletonType.Custom" Class="h-10 w-64 rounded-lg" />
        </div>
    }
    else
    {
        <div class="flex justify-between items-center mb-6">
            <AdminBreadcrumb />
            <button @onclick='() => Navigation.NavigateTo("/admin/mes-ressources/nouveau")'
                    class="inline-flex items-center gap-2 rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white shadow-[0_10px_20px_rgba(91,77,245,0.25)] transition hover:brightness-95">
                <i class="fas fa-plus text-sm"></i>
                <span class="hidden sm:block">Nouveau</span>
            </button>
        </div>

        <div class="flex gap-4 mb-6">
            <div class="flex-1 relative">
                <i class="fas fa-search absolute left-4 top-4 text-gray-400"></i>
                <input type="text" placeholder="Rechercher une ressource..." @bind="searchQuery" @bind:event="oninput"
                       class="w-full bg-surface pl-10 pr-4 py-3   border-gray-300 rounded-lg focus:outline-none" />
            </div>
            <select @bind="selectedType" class="bg-surface px-4 py-3 text-body border-gray-300 rounded-lg focus:outline-none">
                <option value="">Type</option>
                <option value="Documentation">Documentation</option>
                <option value="Tutoriel">Tutoriel</option>
                <option value="Article">Article</option>
                <option value="GitHub">GitHub</option>
                <option value="Cours">Cours</option>
                <option value="Livre">Livre</option>
                <option value="Outil">Outil</option>
            </select>
            <select @bind="selectedLevel" class="bg-surface text-body px-4 py-3 border-gray-300 rounded-lg focus:outline-none">
                <option value="">Niveau</option>
                <option value="Débutant">Débutant</option>
                <option value="Intermediaire">Intermediaire</option>
                <option value="Avancé">Avancé</option>
                <option value="Tous niveaux">Tous niveaux</option>
            </select>
        </div>
        <div class="mb-6 hidden md:block">
            <ViewToggle @bind-IsListView="isListView" />
        </div>

        @if (isListView)
        {
            <RessourceTable Resources="pagedResources" OnEdit="NavigateToEdit" OnDelete="DeleteResource" />
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var resource in pagedResources)
                {
                    <RessourceCard Resource="resource" AdminMode="true" OnEdit="NavigateToEdit" OnDelete="DeleteResource" />
                }
            </div>
        }

        <div class="mt-6">
            <Paginated @bind-CurrentPage="currentPage" TotalPages="@totalPages" />
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isListView = false;
    private bool responsiveViewApplied;
    private string searchQueryValue = string.Empty;
    private string selectedTypeValue = string.Empty;
    private string selectedLevelValue = string.Empty;
    private int currentPage = 1;
    private int pageSize = 7;

    private List<ResourceDto> allResources = new();

    private string searchQuery
    {
        get => searchQueryValue;
        set
        {
            if (searchQueryValue == value) return;
            searchQueryValue = value;
            currentPage = 1;
        }
    }

    private string selectedType
    {
        get => selectedTypeValue;
        set
        {
            if (selectedTypeValue == value) return;
            selectedTypeValue = value;
            currentPage = 1;
        }
    }

    private string selectedLevel
    {
        get => selectedLevelValue;
        set
        {
            if (selectedLevelValue == value) return;
            selectedLevelValue = value;
            currentPage = 1;
        }
    }

    private List<ResourceDto> filteredResources => allResources
        .Where(r => string.IsNullOrEmpty(searchQuery) ||
                    r.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    r.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(selectedType) || r.ResourceType == selectedType)
        .Where(r => string.IsNullOrEmpty(selectedLevel) || r.Level == selectedLevel)
        .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredResources.Count / pageSize));

    private List<ResourceDto> pagedResources => filteredResources
        .Skip((SafeCurrentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int SafeCurrentPage => Math.Clamp(currentPage, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            allResources = await ResourceService.GetMyResourcesAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToEdit(Guid id)
    {
        Navigation.NavigateTo($"/admin/mes-ressources/edit/{id}");
    }

    private async Task DeleteResource(Guid id)
    {
        try
        {
            await ResourceService.DeleteResourceAsync(id);
            ToastService.ShowToast("Ressource supprimée.", ToastLevel.Success);
            allResources = await ResourceService.GetMyResourcesAsync();
        }
        catch
        {
            ToastService.ShowToast("Erreur lors de la suppression.", ToastLevel.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || responsiveViewApplied)
        {
            return;
        }

        responsiveViewApplied = true;
        var isMobile = await JS.InvokeAsync<bool>("dotnetNigerIsMobile");
        var shouldShowListView = !isMobile;

        if (isListView != shouldShowListView)
        {
            isListView = shouldShowListView;
            StateHasChanged();
        }
    }
}
