@page "/admin/mes-ressources/edit/{Id:guid}"
@* @attribute [Authorize(Roles = "Admin,SuperAdmin,Collaborator")] *@
@* Page admin : édition d'une ressource (mes ressources). *@
@using DotnetNiger.UI.Models.Requests
@inject NavigationManager Navigation
@inject IResourceService ResourceService
@inject IToastService ToastService

<div class="p-6 bg-primary">
    <div class="flex justify-between items-center mb-6">
        <AdminBreadcrumb />
        <button @onclick="GoBack"
                class="inline-flex items-center gap-2 rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white transition hover:brightness-95">
            <i class="fas fa-arrow-left"></i>
            <span>Retour</span>
        </button>
    </div>

    @if (!isLoading)
    {
        <div class="bg-surface rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold mb-6">Modifier la ressource</h2>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-50   border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm mb-4">@errorMessage</div>
            }

            <EditForm Model="resourceRequest" OnValidSubmit="UpdateResource" class="space-y-5">
                <DataAnnotationsValidator />
                <div>
                    <label class="block text-sm font-medium mb-1">Titre *</label>
                    <InputText @bind-Value="resourceRequest.Title"
                               class="w-full   rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                               placeholder="Titre de la ressource" />
                    <ValidationMessage For="@(() => resourceRequest.Title)" class="text-xs text-red-500 mt-1" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Description *</label>
                    <InputTextArea @bind-Value="resourceRequest.Description" rows="3"
                                   class="w-full   rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                   placeholder="Description de la ressource" />
                    <ValidationMessage For="@(() => resourceRequest.Description)" class="text-xs text-red-500 mt-1" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">URL *</label>
                    <InputText @bind-Value="resourceRequest.Url"
                               class="w-full   rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                               placeholder="https://..." />
                    <ValidationMessage For="@(() => resourceRequest.Url)" class="text-xs text-red-500 mt-1" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Type *</label>
                    <InputSelect @bind-Value="resourceRequest.ResourceType"
                                 class="w-full   rounded-lg px-4 py-2 bg-surface focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Selectionner un type</option>
                        <option value="Documentation">Documentation</option>
                        <option value="Tutoriel">Tutoriel</option>
                        <option value="Article">Article</option>
                        <option value="GitHub">GitHub</option>
                        <option value="Cours">Cours</option>
                        <option value="Livre">Livre</option>
                        <option value="Outil">Outil</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => resourceRequest.ResourceType)" class="text-xs text-red-500 mt-1" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Niveau *</label>
                    <InputSelect @bind-Value="resourceRequest.Level"
                                 class="w-full   rounded-lg px-4 py-2 bg-surface focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Selectionner un niveau</option>
                        <option value="Débutant">Débutant</option>
                        <option value="Intermediaire">Intermediaire</option>
                        <option value="Avancé">Avancé</option>
                        <option value="Tous niveaux">Tous niveaux</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => resourceRequest.Level)" class="text-xs text-red-500 mt-1" />
                </div>
                <div class="flex justify-end gap-3 pt-4">
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-purple-800">
                        <i class="fas fa-paper-plane"></i>
                        Mettre à jour
                    </button>
                </div>
            </EditForm>
        </div>
    }
    else
    {
        <div class="bg-surface rounded-lg shadow p-6 space-y-5">
            <Skeleton Type="SkeletonType.Title" Class="w-48" />
            <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-16" />
            <Skeleton Type="SkeletonType.Custom" Class="h-10 w-full rounded-lg" />
            <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-24" />
            <Skeleton Type="SkeletonType.Custom" Class="h-20 w-full rounded-lg" />
            <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-16" />
            <Skeleton Type="SkeletonType.Custom" Class="h-10 w-full rounded-lg" />
            <Skeleton Type="SkeletonType.Button" Width="140px" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool isLoading = true;
    private CreateResourceRequest resourceRequest = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var existing = await ResourceService.GetResourceByIdAsync(Id);
            if (existing is not null)
            {
                resourceRequest = new CreateResourceRequest
                {
                    Title = existing.Title,
                    Description = existing.Description,
                    Url = existing.Url,
                    ResourceType = existing.ResourceType,
                    Level = existing.Level
                };
            }
            else
            {
                errorMessage = "Ressource introuvable.";
            }
        }
        catch
        {
            errorMessage = "Erreur lors du chargement.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/mes-ressources");
    }

    private async Task UpdateResource()
    {
        errorMessage = string.Empty;
        try
        {
            await ResourceService.UpdateResourceAsync(Id, resourceRequest);
            ToastService.ShowToast("Ressource mise à jour.", ToastLevel.Success);
            Navigation.NavigateTo("/admin/mes-ressources");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            ToastService.ShowToast("Erreur lors de la mise à jour.", ToastLevel.Error);
        }
    }
}
