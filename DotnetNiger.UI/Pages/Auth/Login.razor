@page "/login"
@inject IAuthService Auth
@inject IUserStateService UserStateService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@using DotnetNiger.UI.Helpers
@using DotnetNiger.UI.Services.Api

<PageTitle>Connexion - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
    <div class="w-full @(Config.GetValue<bool>("UseMockServices") ? "max-w-lg" : "max-w-md")">

        @if (Config.GetValue<bool>("UseMockServices"))
        {
            <div class="bg-white rounded-lg shadow-xl p-8 md:p-10">
                <div class="text-center mb-8">
                    <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-user-shield text-purple-600 text-2xl"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900">Connexion</h1>
                    <p class="text-gray-500 text-sm mt-1">Mode démo - Sélectionnez un compte</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 rounded-lg px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700">
                        @errorMessage
                    </div>
                }

                <div class="space-y-4">
                    <button type="button" disabled="@isLoading"
                        class="w-full text-left p-4 rounded-lg border-2 border-purple-200 bg-purple-50 hover:bg-purple-100 hover:border-purple-400 transition disabled:opacity-60"
                        @onclick="() => LoginAs(AdminEmail)">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-purple-200 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-user-shield text-purple-700"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="font-semibold text-gray-900">Ali Mahamane</p>
                                <p class="text-sm text-gray-500">admin&#64;dotnet.niger</p>
                            </div>
                            <span class="ml-auto text-xs font-medium px-2.5 py-1 rounded-full bg-purple-200 text-purple-800">Admin</span>
                        </div>
                    </button>

                    <button type="button" disabled="@isLoading"
                        class="w-full text-left p-4 rounded-lg border-2 border-blue-200 bg-blue-50 hover:bg-blue-100 hover:border-blue-400 transition disabled:opacity-60"
                        @onclick="() => LoginAs(MemberEmail)">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-blue-200 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-user text-blue-700"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="font-semibold text-gray-900">Fatima Oumar</p>
                                <p class="text-sm text-gray-500">fatima&#64;dotnet.niger</p>
                            </div>
                            <span class="ml-auto text-xs font-medium px-2.5 py-1 rounded-full bg-blue-200 text-blue-800">Membre</span>
                        </div>
                    </button>
                </div>

                @if (isLoading)
                {
                    <div class="text-center mt-6">
                        <div class="inline-block w-6 h-6 border-2 border-purple-600 border-t-transparent rounded-full animate-spin"></div>
                        <p class="text-sm text-gray-500 mt-2">Connexion en cours...</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow-xl p-8 md:p-10">
                <div class="text-center mb-6">
                    <div class="w-16 h-16 rounded-full bg-violet-100 flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-user text-violet-600 text-2xl"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900">Connexion</h1>
                    <p class="text-gray-500 text-sm mt-1">Connectez-vous à votre compte</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 rounded-lg px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700">
                        @errorMessage
                    </div>
                }

                <form @onsubmit="HandlePasswordLogin">
                    <div class="space-y-4">
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input id="email" type="email" @bind="email" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-violet-500 focus:ring-1 focus:ring-violet-500 outline-none transition" />
                        </div>

                        <div>
                            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
                            <input id="password" type="password" @bind="password" required
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-violet-500 focus:ring-1 focus:ring-violet-500 outline-none transition" />
                        </div>

                        <div class="flex items-center justify-between text-sm">
                            <a href="/forgot-password" class="text-violet-600 hover:text-violet-800">Mot de passe oublié ?</a>
                        </div>

                        @if (!string.IsNullOrEmpty(socialError))
                        {
                            <div class="rounded-lg px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700">
                                @socialError
                            </div>
                        }

                        <button type="submit" disabled="@isLoading"
                            class="w-full bg-violet-600 hover:bg-violet-700 text-white font-medium py-2.5 rounded-lg transition disabled:opacity-60 flex items-center justify-center gap-2">
                            @if (isLoading)
                            {
                                <span class="inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                <span>Connexion...</span>
                            }
                            else
                            {
                                <span>Se connecter</span>
                            }
                        </button>
                    </div>
                </form>

                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="bg-white px-4 text-gray-500">OU</span>
                    </div>
                </div>

                <div class="space-y-3">
                    <button type="button" disabled="@isSocialBusy"
                        class="w-full flex items-center justify-center gap-3 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-60 text-sm font-medium text-gray-700"
                        @onclick="() => SocialLoginAsync(SocialProvider.Google)">
                        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                        Google
                    </button>

                    <button type="button" disabled="@isSocialBusy"
                        class="w-full flex items-center justify-center gap-3 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-60 text-sm font-medium text-gray-700"
                        @onclick="() => SocialLoginAsync(SocialProvider.GitHub)">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                        GitHub
                    </button>

                    <button type="button" disabled="@isSocialBusy"
                        class="w-full flex items-center justify-center gap-3 px-4 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition disabled:opacity-60 text-sm font-medium text-gray-700"
                        @onclick="() => SocialLoginAsync(SocialProvider.Microsoft)">
                        <svg class="w-5 h-5" viewBox="0 0 24 24"><rect x="1" y="1" width="10.5" height="10.5" fill="#F25022"/><rect x="12.5" y="1" width="10.5" height="10.5" fill="#7FBA00"/><rect x="1" y="12.5" width="10.5" height="10.5" fill="#00A4EF"/><rect x="12.5" y="12.5" width="10.5" height="10.5" fill="#FFB900"/></svg>
                        Microsoft
                    </button>
                </div>

                <p class="text-center text-sm text-gray-500 mt-6">
                    Pas encore de compte ?
                    <a href="/register" class="text-violet-600 hover:text-violet-800 font-medium">S'inscrire</a>
                </p>
            </div>
        }

    </div>
</div>

@code {
    private const string AdminEmail = "admin@dotnet.niger";
    private const string MemberEmail = "fatima@dotnet.niger";

    private string email = string.Empty;
    private string password = string.Empty;
    private bool isLoading;
    private bool isSocialBusy;
    private string? errorMessage;
    private string? socialError;

    private static class SocialProvider
    {
        public const string Google = "Google";
        public const string GitHub = "GitHub";
        public const string Microsoft = "Microsoft";
    }

    private async Task HandlePasswordLogin()
    {
        isLoading = true;
        errorMessage = null;

        var result = await Auth.LoginAsync(new LoginRequest
        {
            Email = email,
            Password = password
        });

        isLoading = false;

        if (result.Success && result.Data is not null)
        {
            await UserStateService.SetUserAsync(result.Data.User);

            var isAdmin = result.Data.User.Roles.Any(r => RoleConstants.IsAdminRole(r));
            Navigation.NavigateTo(isAdmin ? "/admin" : "/");
        }
        else
        {
            errorMessage = result.Message ?? "Email ou mot de passe incorrect.";
        }
    }

    private async Task LoginAs(string email)
    {
        isLoading = true;
        errorMessage = null;

        var result = await Auth.LoginAsync(new LoginRequest
        {
            Email = email,
            Password = "password123"
        });

        isLoading = false;

        if (result.Success && result.Data is not null)
        {
            await UserStateService.SetUserAsync(result.Data.User);

            var isAdmin = result.Data.User.Roles.Any(r => RoleConstants.IsAdminRole(r));
            Navigation.NavigateTo(isAdmin ? "/admin" : "/");
        }
        else
        {
            errorMessage = result.Message ?? "Erreur de connexion.";
        }
    }

    private async Task SocialLoginAsync(string provider)
    {
        if (isSocialBusy) return;

        isSocialBusy = true;
        socialError = null;

        try
        {
            var apiBase = Config["ApiBaseUrl"] ?? "http://localhost:5000";
            var redirectUri = Navigation.BaseUri.TrimEnd('/') + "/auth/callback-popup.html";
            var authorizeUrl = $"{apiBase}/{ApiEndpoints.Auth.Authorize}" +
                $"?idp_hint={provider}" +
                "&response_type=code" +
                $"&client_id=web-ui" +
                $"&redirect_uri={Uri.EscapeDataString(redirectUri)}" +
                "&scope=openid+profile+email+roles+offline_access";

            var code = await JS.InvokeAsync<string>("openOAuthPopup", authorizeUrl);

            var result = await Auth.CompleteCodeExchangeAsync(code, redirectUri);

            if (result.Success && result.Data is not null)
            {
                await UserStateService.SetUserAsync(result.Data.User);

                var isAdmin = result.Data.User.Roles.Any(r => RoleConstants.IsAdminRole(r));
                Navigation.NavigateTo(isAdmin ? "/admin" : "/");
            }
            else
            {
                socialError = result.Message ?? "Erreur lors de la connexion avec le fournisseur externe.";
            }
        }
        catch (JSException ex)
        {
            socialError = ex.Message;
        }
        catch (Exception ex)
        {
            socialError = ex.Message;
        }
        finally
        {
            isSocialBusy = false;
        }
    }
}
