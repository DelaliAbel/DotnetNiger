@page "/login"
@inject IAuthService Auth
@inject IUserStateService UserStateService
@inject NavigationManager Navigation
@inject IConfiguration Config
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthProvider
@using DotnetNiger.UI.Helpers
@implements IDisposable

<PageTitle>Connexion - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
    <div class="w-full max-w-lg">

        <div class="bg-surface rounded-lg shadow-xl p-8 md:p-10">

            <div class="text-center mb-8">
                <a href="/" class="inline-block mb-4">
                    <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center mx-auto">
                        <i class="fas fa-user-shield text-purple-600 text-2xl"></i>
                    </div>
                </a>
                <h1 class="text-2xl font-bold text-title">Connexion</h1>
                <p class="text-body text-sm mt-1">@(_isMock ? "Mode démo - Sélectionnez un compte" : "Connectez-vous à votre compte")</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-4 rounded-lg px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700">
                    @_errorMessage
                </div>
            }

            @if (_resetSuccessMessage)
            {
                <div class="mb-4 rounded-lg px-4 py-3 text-sm bg-green-50 border border-green-200 text-green-700">
                    Mot de passe réinitialisé avec succès. Vous pouvez vous connecter.
                </div>
            }

            @if (_isMock)
            {
                <div class="space-y-4">
                    <button type="button" disabled="@_isLoading"
                            class="w-full text-left p-4 rounded-lg border-2 border-purple-200 bg-purple-50 hover:bg-purple-100 hover:border-purple-400 transition disabled:opacity-60"
                            @onclick="() => LoginAs(AdminEmail)">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-purple-200 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-user-shield text-purple-700"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="font-semibold text-title">Ali Mahamane</p>
                                <p class="text-sm text-body">admin&#64;dotnet.niger</p>
                            </div>
                            <span class="ml-auto text-xs font-medium px-2.5 py-1 rounded-full bg-purple-200 text-purple-800">Admin</span>
                        </div>
                    </button>

                    <button type="button" disabled="@_isLoading"
                            class="w-full text-left p-4 rounded-lg border-2 border-blue-200 bg-blue-50 hover:bg-blue-100 hover:border-blue-400 transition disabled:opacity-60"
                            @onclick="() => LoginAs(MemberEmail)">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-blue-200 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-user text-blue-700"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="font-semibold text-title">Fatima Oumar</p>
                                <p class="text-sm text-body">fatima&#64;dotnet.niger</p>
                            </div>
                            <span class="ml-auto text-xs font-medium px-2.5 py-1 rounded-full bg-blue-200 text-blue-800">Membre</span>
                        </div>
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Adresse e-mail</label>
                        <InputText @bind-Value="_loginModel.Email" type="email"
                                   class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 outline-none transition"
                                   placeholder="vous@exemple.com" />
                        <ValidationMessage For="@(() => _loginModel.Email)" class="text-xs text-red-500 mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
                        <div class="relative">
                            <InputText @bind-Value="_loginModel.Password" type="@(_showPassword ? "text" : "password")"
                                       class="w-full rounded-lg border border-gray-300 px-4 py-2.5 pr-10 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 outline-none transition"
                                       placeholder="Votre mot de passe" />
                            <button type="button" @onclick="TogglePasswordVisibility"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition">
                                <i class="fas @(_showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _loginModel.Password)" class="text-xs text-red-500 mt-1" />
                    </div>

                    <div class="flex items-center justify-end mb-6">
                        <a href="/forgot-password" class="text-sm text-purple-600 hover:text-purple-700 font-medium">
                            Mot de passe oublié ?
                        </a>
                    </div>

                    <button type="submit" disabled="@_isLoading"
                            class="w-full rounded-lg bg-purple-600 py-2.5 text-sm font-semibold text-white hover:bg-purple-700 transition disabled:opacity-60">
                        @(_isLoading ? "Connexion en cours..." : "Se connecter")
                    </button>
                </EditForm>

                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-200"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-3 bg-surface text-gray-400">ou continuer avec</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <button type="button" @onclick="() => OAuthLogin(GoogleProvider)"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-surface px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50">
                        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                        Google
                    </button>
                    <button type="button" @onclick="() => OAuthLogin(GitHubProvider)"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-surface px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        GitHub
                    </button>
                </div>
            }

            <div class="mt-8 pt-6 border-t border-gray-100 text-center">
                <p class="text-xs text-gray-400">
                    Pas encore de compte ?
                    <a href="/register" class="text-purple-600 hover:text-purple-700 font-medium">Créer un compte</a>
                </p>
            </div>

        </div>

        <p class="mt-6 text-center text-xs text-gray-400">
            <i class="fas fa-lock mr-1"></i>
            Vos données sont protégées et jamais partagées.
        </p>
    </div>
</div>

@code {
    private const string AdminEmail = "admin@dotnet.niger";
    private const string MemberEmail = "fatima@dotnet.niger";
    private const string GoogleProvider = "Google";
    private const string GitHubProvider = "GitHub";

    private readonly LoginRequest _loginModel = new();
    private bool _isLoading;
    private bool _showPassword;
    private string? _errorMessage;
    private bool _resetSuccessMessage;
    private bool _isMock;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    protected override void OnInitialized()
    {
        _isMock = Config.GetValue<bool>("UseMockServices");

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["resetSuccess"] == "true")
            _resetSuccessMessage = true;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await Auth.LoginAsync(_loginModel);

        _isLoading = false;

        if (result.Success && result.Data is not null)
        {
            await UserStateService.SetUserAsync(result.Data.User);

            var returnUrl = GetReturnUrl();
            var isAdmin = result.Data.User.Roles.Any(r => RoleConstants.IsAdminRole(r));

            if (IsSafeReturnUrl(returnUrl))
                Navigation.NavigateTo(returnUrl!, forceLoad: true);
            else
                Navigation.NavigateTo(isAdmin ? "/admin" : "/");
        }
        else
        {
            _errorMessage = result.Message ?? "Erreur de connexion.";
        }
    }

    private void OAuthLogin(string provider)
    {
        var apiBase = Config["ApiBaseUrl"] ?? "http://localhost:5000";
        var externalLoginUrl = $"{apiBase.TrimEnd('/')}/api/auth/external-login?provider={Uri.EscapeDataString(provider)}";
        _ = JS.InvokeVoidAsync("openExternalLoginPopup", externalLoginUrl, DotNetObjectReference.Create(this));
    }

    /// <summary>
    /// Callback JS invokable appelé par la popup quand le login externe réussit.
    /// Recoit les tokens JWT et connecte l'utilisateur.
    /// </summary>
    [JSInvokable]
    public async Task OnExternalLoginSuccess(string accessToken, string refreshToken, int expiresIn)
    {
        await AuthProvider.SaveTokensAsync(accessToken, refreshToken);
        var user = await Auth.GetCurrentUserAsync();
        if (user is not null)
        {
            await UserStateService.SetUserAsync(user);
            var isAdmin = user.Roles?.Any(r => RoleConstants.IsAdminRole(r)) ?? false;
            Navigation.NavigateTo(isAdmin ? "/admin" : "/");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
        StateHasChanged();
    }

    /// <summary>
    /// Callback JS invokable appelé par la popup quand le login externe échoue.
    /// </summary>
    [JSInvokable]
    public Task OnExternalLoginError(string error)
    {
        _errorMessage = error ?? "Erreur lors de la connexion externe.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        GC.SuppressFinalize(this);
    }

    private string? GetReturnUrl()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query["returnUrl"];
    }

    /// <summary>
    /// Vérifie que l'URL de retour est un chemin relatif sûr.
    /// Protège contre les attaques d'open-redirect.
    /// </summary>
    private static bool IsSafeReturnUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        if (!url.StartsWith("/") || url.StartsWith("//")) return false;
        if (url.Contains('\\') || url.Contains('\r') || url.Contains('\n')) return false;
        return true;
    }

    private async Task LoginAs(string email)
    {
        _isLoading = true;
        _errorMessage = null;

        // En mode mock, le mot de passe est défini dans la config
        var result = await Auth.LoginAsync(new LoginRequest
        {
            Email = email,
            Password = Config["MockPassword"] ?? "Demo2024!"
        });

        _isLoading = false;

        if (result.Success && result.Data is not null)
        {
            await UserStateService.SetUserAsync(result.Data.User);
            var isAdmin = result.Data.User.Roles.Any(r => RoleConstants.IsAdminRole(r));
            Navigation.NavigateTo(isAdmin ? "/admin" : "/");
        }
        else
        {
            _errorMessage = result.Message ?? "Erreur de connexion.";
        }
    }
}
