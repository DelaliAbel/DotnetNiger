@page "/auth/external-callback"
@inject IAuthService AuthService
@inject IUserStateService UserStateService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>Connexion en cours - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
    <div class="text-center">
        <div class="text-gray-500 mb-4">
            @if (isProcessing)
            {
                <div class="space-y-4">
                    <div class="inline-block w-8 h-8 border-2 border-violet-600 border-t-transparent rounded-full animate-spin"></div>
                    <p class="text-sm text-gray-500 mt-2">Finalisation de la connexion...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="text-red-600">@errorMessage</p>
            }
        </div>
    </div>
</div>

@code {
    private bool isProcessing = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var code = query["code"];
        var error = query["error"];

        if (!string.IsNullOrEmpty(error))
        {
            isProcessing = false;
            errorMessage = Uri.UnescapeDataString(error);
            return;
        }

        if (string.IsNullOrEmpty(code))
        {
            isProcessing = false;
            errorMessage = "Aucun code de validation reçu.";
            await Task.Delay(3000);
            Navigation.NavigateTo("/login");
            return;
        }

        var apiBase = Config["ApiBaseUrl"] ?? "http://localhost:5000";
        var redirectUri = Navigation.BaseUri.TrimEnd('/') + "/auth/external-callback";

        var response = await AuthService.CompleteCodeExchangeAsync(code, redirectUri);

        if (response.Success && response.Data != null)
        {
            if (response.Data.User is not null)
                await UserStateService.SetUserAsync(response.Data.User);

            var isAdmin = response.Data.User?.Roles.Any(r => Helpers.RoleConstants.IsAdminRole(r)) == true;
            Navigation.NavigateTo(isAdmin ? "/admin" : "/");
        }
        else
        {
            errorMessage = response.Message ?? "Erreur lors de la connexion externe.";
            await Task.Delay(3000);
            Navigation.NavigateTo("/login");
        }
    }
}
