@page "/auth/external-callback"
@using Microsoft.AspNetCore.Components
@inject IAuthService AuthService
@inject IUserStateService UserStateService
@inject NavigationManager Navigation

<PageTitle>Connexion en cours - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
    <div class="text-center">
        <div class="text-body mb-4">
            @if (isProcessing)
            {
                <div class="space-y-4">
                    <Skeleton Type="SkeletonType.Custom" Class="h-16 w-16 rounded-full mx-auto" />
                    <Skeleton Type="SkeletonType.Title" Class="w-3/4 mx-auto" />
                    <Skeleton Type="SkeletonType.Text" Lines="2" Class="w-1/2 mx-auto" />
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="text-red-600">@errorMessage</p>
            }
        </div>
    </div>
</div>

@code {
    private bool isProcessing = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var ticket = query["ticket"];
        var error = query["error"];
        var returnUrl = query["returnUrl"];

        if (!string.IsNullOrEmpty(error))
        {
            isProcessing = false;
            errorMessage = Uri.UnescapeDataString(error);
            return;
        }

        if (string.IsNullOrEmpty(ticket))
        {
            isProcessing = false;
            errorMessage = "Aucun ticket de connexion reçu.";
            await Task.Delay(3000);
            Navigation.NavigateTo("/login");
            return;
        }

        var response = await AuthService.CompleteExternalLoginAsync(ticket);

        if (response.Success && response.Data != null)
        {
            if (response.Data.User is not null)
                await UserStateService.SetUserAsync(response.Data.User);

            var destination = "/";
            if (!string.IsNullOrWhiteSpace(returnUrl) && IsSafeReturnUrl(returnUrl))
                destination = returnUrl;

            Navigation.NavigateTo(destination);
        }
        else
        {
            errorMessage = response.Message ?? "Erreur lors de la connexion externe.";
            await Task.Delay(3000);
            Navigation.NavigateTo("/login");
        }
    }

    /// <summary>
    /// Vérifie que l'URL de retour est un chemin relatif sûr (pas de protocole externe).
    /// Protège contre les attaques d'open-redirect.
    /// </summary>
    private static bool IsSafeReturnUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        if (!url.StartsWith("/") || url.StartsWith("//")) return false;
        if (url.Contains('\\') || url.Contains('\r') || url.Contains('\n')) return false;
        return true;
    }
}
