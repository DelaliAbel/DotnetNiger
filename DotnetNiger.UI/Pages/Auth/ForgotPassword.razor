@page "/forgot-password"
@* Page d'authentification : demande de lien de réinitialisation de mot de passe. *@
@inject IAuthService Auth

<PageTitle>Mot de passe oublié - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-2xl">
        <a href="/login" class="inline-flex items-center text-sm text-body mb-6"><i class="fas fa-arrow-left mr-2"></i>
            Retour</a>

            <div class="bg-fondTransparent rounded-lg shadow-sm p-10 md:p-12">
            <div class="max-w-md mx-auto">
                <h1 class="text-2xl md:text-3xl font-bold text-title mb-2">Mot de passe oublié ?</h1>
                <p class="text-body mb-6">Entrez votre adresse e-mail pour recevoir un lien de réinitialisation.</p>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div
                        class="mb-4 rounded-lg px-4 py-3 text-sm @(isSuccess ? "bg-green-50   border-green-200 text-green-700" : "bg-red-50   border-red-200 text-red-700")">
                        @message
                    </div>
                }

                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="mb-4">
                <label class="block text-xs font-medium text-title mb-2">ADRESSE E-MAIL</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-body"><i
                        class="fas fa-envelope"></i></span>
                        <InputText @bind-Value="model.Email" type="email"
                                   class="w-full rounded-lg bg-surface text-body shadow-md px-4 py-3 pl-12 text-sm focus:outline-none transition"
                                   placeholder="nom@exemple.ne" />
                    </div>
                    <ValidationMessage For="@(() => model.Email)" class="text-xs text-red-500 mt-1" />
                </div>

                <button type="submit" disabled="@isLoading"
                        class="w-full rounded-lg bg-primary hover:bg-blue-700 text-white py-3 mt-2 font-medium shadow-md transition disabled:opacity-60">
                    @(isLoading ? "Envoi en cours..." : "Envoyer le lien de réinitialisation")
                </button>
            </EditForm>

            <p class="text-center text-sm text-body mt-6">
            <a href="/login" class="text-primary font-medium hover:underline">← Retour à la connexion</a>
        </p>
    </div>
</div>
</div>
</div>

@code {
    private ForgotPasswordRequest model = new();
    private string message = "";
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleSubmit()
    {
        isLoading = true;
        message = "";
        var result = await Auth.ForgotPasswordAsync(model);
        isLoading = false;
        isSuccess = true;
        message = "Si cet email est associé à un compte, un lien de réinitialisation a été envoyé.";
    }
}
