@page "/register"
@inject IAuthService Auth
@inject IRegistrationService RegistrationService
@inject IProfileService ProfileService
@inject NavigationManager Navigation
@inject IConfiguration Config

<PageTitle>Inscription - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg">

        <div class="relative rounded-2xl bg-surface shadow-[0_8px_30px_rgb(0,0,0,0.06)]   border-gray-100 p-8 md:p-10">

            <a href="/" class="absolute left-6 top-6 inline-flex items-center gap-1.5 text-xs text-gray-400 transition hover:text-gray-600">
                <i class="fas fa-arrow-left text-[10px]"></i>
                Accueil
            </a>

            @* Stepper *@
            <div class="flex items-center justify-center gap-3 mb-8">
                <div class="flex items-center gap-2 @(currentStep >= 1 ? "text-purple-700" : "text-gray-300")">
                    <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold @(currentStep >= 1 ? "bg-purple-600 text-white" : "bg-gray-100 text-gray-400")">1</span>
                    <span class="text-xs font-medium">Compte</span>
                </div>
                <div class="w-10 h-px @(currentStep >= 2 ? "bg-purple-300" : "bg-gray-200")"></div>
                <div class="flex items-center gap-2 @(currentStep >= 2 ? "text-purple-700" : "text-gray-300")">
                    <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold @(currentStep >= 2 ? "bg-purple-600 text-white" : "bg-gray-100 text-gray-400")">2</span>
                    <span class="text-xs font-medium">Certificat</span>
                </div>
            </div>

            @if (currentStep == 1)
            {
                @if (isLoadingProfile)
                {
                    <div class="text-center py-8">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600 mx-auto mb-4"></div>
                        <p class="text-sm text-body">Chargement du profil...</p>
                    </div>
                }
                else if (hasProfile)
                {
                    <div class="text-center py-4">
                        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50">
                            <i class="fas fa-check-circle text-emerald-500 text-2xl"></i>
                        </div>

                        <h2 class="text-xl font-bold text-title">Bienvenue, @registeredName !</h2>

                        <p class="mt-2 text-sm text-body max-w-sm mx-auto leading-relaxed">
                            Votre compte a été créé. Pour terminer votre adhésion, il ne vous reste plus qu'à valider votre certificat.
                        </p>

                        <div class="mt-6 bg-amber-50   border-amber-100 rounded-xl p-4 text-left">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-info-circle text-amber-500 mt-0.5"></i>
                                <div class="text-sm text-amber-800">
                                    <p class="font-medium">Action requise</p>
                                    <p class="mt-1 text-amber-700">Vous devez détenir le certificat <strong>Foundational C# with Microsoft</strong> pour accéder aux fonctionnalités de contribution.</p>
                                </div>
                            </div>
                        </div>

                        <button type="button"
                                class="mt-7 inline-flex items-center gap-2 rounded-xl bg-purple-600 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-purple-700 hover:shadow-md active:scale-[0.98]"
                                @onclick="GoToStep2">
                            Continuer
                            <i class="fas fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-purple-50">
                            <i class="fas fa-user-plus text-purple-500 text-xl"></i>
                        </div>

                        <h1 class="text-xl font-bold text-title">Rejoindre la communauté</h1>
                        <p class="mt-2 text-sm text-body leading-relaxed max-w-sm mx-auto">
                            Créez votre compte pour participer aux événements, accéder aux ressources et contribuer à l'écosystème .NET au Niger.
                        </p>

                        <button type="button"
                                class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-purple-600 px-5 py-3 text-sm font-semibold text-white transition-all hover:bg-purple-700 hover:shadow-md active:scale-[0.98]"
                                @onclick="RedirectToIdentityRegister">
                            <i class="fas fa-graduation-cap"></i>
                            Créer mon compte
                        </button>

                        <p class="mt-5 text-xs text-gray-400 leading-relaxed">
                            En créant un compte, vous acceptez nos
                            <a href="/conditions" class="text-purple-600 hover:text-purple-700 font-medium">conditions d'utilisation</a>.
                        </p>

                        <div class="mt-8 pt-6 border-t border-gray-100">
                            <p class="text-xs text-gray-400">
                                Déjà membre ?
                                <a href="/login" class="text-purple-600 hover:text-purple-700 font-medium">Se connecter</a>
                            </p>
                        </div>
                    </div>
                }
            }

            @if (currentStep == 2)
            {
                <RegistrationStep3
                    Model="certifModel"
                    ErrorMessage="certifErrorMessage"
                    IsLoading="isCertifLoading"
                    IsSubmitted="isCertifSubmitted"
                    Status="certifStatus"
                    OnSubmit="HandleCertifSubmit"
                    OnBack="GoToStep1"
                    OnContinue="NavigateToLogin" />
            }

        </div>

        <p class="mt-6 text-center text-xs text-gray-400">
            <i class="fas fa-lock mr-1"></i>
            Vos données sont protégées et jamais partagées.
        </p>
    </div>
</div>

@code {
    private Uri IdentityRegisterUri => new($"{Config["ApiBaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')}{Config["IdentityEndpoints:Register"] ?? "/Account/Register"}");

    private readonly CertificateSubmissionDto certifModel = new();
    private CertificateStatusDto? certifStatus;

    private int currentStep = 1;
    private Guid tempUserId;
    private string registeredName = string.Empty;

    private bool hasProfile;
    private bool isLoadingProfile;
    private bool isCertifSubmitted;

    private string? certifErrorMessage;

    private bool isCertifLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoadingProfile = true;

        try
        {
            var profile = await ProfileService.GetProfileAsync();
            if (profile.Id != Guid.Empty)
            {
                tempUserId = profile.Id;
                registeredName = profile.FullName ?? profile.Email;
                certifModel.UserId = profile.Id;
                hasProfile = true;
            }
        }
        catch
        {
            hasProfile = false;
        }
        finally
        {
            isLoadingProfile = false;
        }
    }

    private void RedirectToIdentityRegister()
    {
        var returnUrl = $"{Navigation.BaseUri}register";
        var redirectUrl = $"{IdentityRegisterUri}?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(redirectUrl);
    }

    private async Task HandleCertifSubmit(CertificateSubmissionDto request)
    {
        isCertifLoading = true;
        certifErrorMessage = null;

        try
        {
            request.UserId = tempUserId;
            var result = await RegistrationService.SubmitStep2Async(request);

            if (result.Success && result.Data is not null)
            {
                certifStatus = result.Data;
                isCertifSubmitted = true;
            }
            else
            {
                certifErrorMessage = result.Message ?? "Erreur lors de la soumission de la certification. Vérifiez que le lien est valide et réessayez.";
            }
        }
        catch (Exception ex)
        {
            certifErrorMessage = $"Erreur inattendue : {ex.Message}";
        }
        finally
        {
            isCertifLoading = false;
        }
    }

    private Task GoToStep1()
    {
        currentStep = 1;
        return Task.CompletedTask;
    }

    private Task GoToStep2()
    {
        currentStep = 2;
        return Task.CompletedTask;
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}
