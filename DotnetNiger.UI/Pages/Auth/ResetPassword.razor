@page "/reset-password"
@* Page d'authentification : saisie du nouveau mot de passe avec token. *@
@inject IAuthService Auth
@inject NavigationManager Navigation
@inject IConfiguration Config

<PageTitle>Réinitialiser le mot de passe - .NET Niger</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-fondTransparent rounded-lg shadow-sm p-8">

        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-title">Nouveau mot de passe</h1>
            <p class="text-subtitle mt-2">Saisissez votre nouveau mot de passe ci-dessous.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-4 rounded-lg bg-red-50   border-red-200 px-4 py-3 text-red-700 text-sm">
                @errorMessage
            </div>
        }

        <EditForm Model="model" OnValidSubmit="HandleReset">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="block text-sm font-medium text-title mb-1">Adresse e-mail</label>
                <InputText @bind-Value="model.Email" type="email"
                           class="w-full rounded-lg bg-surface text-body shadow-md px-4 py-2.5 text-sm focus:outline-none transition"
                           placeholder="vous@exemple.com" />
                <ValidationMessage For="@(() => model.Email)" class="text-xs text-red-500 mt-1" />
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-title mb-1">Nouveau mot de passe</label>
                <div class="relative">
                    <InputText @bind-Value="model.NewPassword" type="@(_showPassword ? "text" : "password")"
                               class="w-full rounded-lg bg-surface text-body shadow-md px-4 py-2.5 pr-10 text-sm focus:outline-none transition"
                               placeholder="Minimum 8 caractères" />
                    <button type="button" @onclick="TogglePasswordVisibility"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-body hover:text-gray-600 transition">
                        <i class="fas @(_showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => model.NewPassword)" class="text-xs text-red-500 mt-1" />
            </div>

            <button type="submit" disabled="@isLoading"
                    class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-white hover:bg-blue-800 transition disabled:opacity-60">
                @(isLoading ? "Réinitialisation..." : "Réinitialiser le mot de passe")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private ResetPasswordRequest model = new();
    private string errorMessage = "";
    private bool isLoading;
    private bool _showPassword;

    // Pré-remplissage depuis les query params: /reset-password?token=xxx&email=yyy
    [Parameter, SupplyParameterFromQuery] public string? Token { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Email { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Token)) model.Token = Token;
        if (!string.IsNullOrWhiteSpace(Email)) model.Email = Email;
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task HandleReset()
    {
        isLoading = true;
        errorMessage = "";
        var result = await Auth.ResetPasswordAsync(model);
        isLoading = false;

        if (result.Success)
        {
            Navigation.NavigateTo("/login?resetSuccess=true");
        }
        else
            errorMessage = result.Message ?? "Erreur lors de la réinitialisation.";
    }
}
