@page "/contact"

@using Microsoft.AspNetCore.Components.Forms
@inject IContactService ContactService
@inject ISettingsService SettingsService
@inject NavigationManager Navigation

<PageTitle>Contact - .NET Niger</PageTitle>

<div class="min-h-screen">
    <section class="relative overflow-hidden px-4 py-20 sm:px-6 lg:px-8">

        <div class="relative mx-auto flex max-w-4xl flex-col items-center text-center">
            <h1
                class="max-w-3xl text-2xl font-extrabold leading-tight text-primary sm:text-3xl md:text-4xl lg:text-5xl">
                Contactez-nous
            </h1>
            <p
                class="mt-4 sm:mt-6 max-w-3xl text-xs leading-6 text-subtitle sm:text-sm sm:leading-7 md:text-base lg:text-lg">
                Une question, une suggestion ou une collaboration ? Envoyez-nous un message, nous vous répondrons dans
                les plus brefs délais.
            </p>
        </div>
    </section>

    <section class="px-4 pb-20 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[1fr_1.5fr] lg:items-start">
            @* Coordonnées & Réseaux *@
            <div class="rounded-lg bg-fondTransparent p-8 sm:p-10 shadow-xl">
                <h2 class="text-lg font-bold text-title">Nos coordonnées</h2>
                <p class="mt-2 text-sm text-subtitle">Restons en contact via nos differents canaux.</p>

                <div class="mt-8 space-y-6">
                    @if (!string.IsNullOrWhiteSpace(contactEmail))
                    {
                        <div class="flex items-start gap-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-primary">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wide text-title">Email</p>
                                <a href="mailto:@contactEmail"
                                   class="text-sm text-primary">@contactEmail</a>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(tel))
                    {
                        <div class="flex items-start gap-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-primary">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wide text-title">Téléphone</p>
                                <p class="text-sm text-primary">@tel</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(location))
                    {
                        <div class="flex items-start gap-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-primary">
                                <i class="fas fa-location-dot"></i>
                            </div>
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wide text-title">Adresse</p>
                                <p class="text-sm text-primary">@location</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-8 border-t pt-6">
                    <p class="text-xs font-semibold uppercase tracking-wide text-title mb-4">Suivez-nous</p>
                    <div class="flex gap-4">
                        @if (!string.IsNullOrWhiteSpace(settings?.LinkedInUrl))
                        {
                            <a href="@settings.LinkedInUrl" target="_blank" rel="noopener"
                               class="flex h-10 w-10 items-center justify-center rounded-full bg-surface shadow-sm text-primary transition hover:text-white hover:bg-primary"
                               title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings?.WhatsAppUrl))
                        {
                            <a href="@settings.WhatsAppUrl" target="_blank" rel="noopener"
                               class="flex h-10 w-10 items-center justify-center rounded-full bg-surface shadow-sm text-primary transition hover:text-white hover:bg-primary"
                               title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings?.FacebookUrl))
                        {
                            <a href="@settings.FacebookUrl" target="_blank" rel="noopener"
                               class="flex h-10 w-10 items-center justify-center rounded-full bg-surface shadow-sm text-primary transition hover:text-white hover:bg-primary"
                               title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings?.YoutubeUrl))
                        {
                            <a href="@settings.YoutubeUrl" target="_blank" rel="noopener"
                               class="flex h-10 w-10 items-center justify-center rounded-full bg-surface shadow-sm text-primary transition hover:text-white hover:bg-primary"
                               title="YouTube"><i class="fab fa-youtube"></i></a>
                        }
                    </div>
                </div>
            </div>

            @* Formulaire *@
            <div>
                @if (isSuccess)
                {
                    <div class="rounded-lg bg-fondTransparent p-8 sm:p-10 shadow-xl text-center">
                        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
                            <i class="fas fa-check text-2xl text-green-600"></i>
                        </div>
                        <h2 class="text-xl font-bold text-title">Message envoyé !</h2>
                        <p class="mt-2 text-sm text-subtitle">Merci de nous avoir contactés. Nous reviendrons vers vous
                            rapidement.</p>
                            <button @onclick="ResetForm"
                                    class="mt-6 inline-flex items-center justify-center rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:bg-accent-hover">
                                Envoyer un autre message
                            </button>
                        </div>
                    }
            else
                    {
                        <div class="rounded-lg bg-fondTransparent p-8 sm:p-10 shadow-xl">
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="mb-6 rounded-lg bg-red-50 border-red-200 px-4 py-3 text-red-700 text-sm">
                                    @errorMessage
                                </div>
                            }

                            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                                <DataAnnotationsValidator />

                                <div class="mb-5">
                                    <label class="block text-xs font-medium text-title mb-2">NOM COMPLET</label>
                                    <div class="relative">
                                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><i
                                            class="fas fa-user"></i></span>
                                            <InputText @bind-Value="model.FullName"
                                                       class="w-full rounded-lg text-body bg-surface shadow-md px-4 py-3 pl-12 text-sm focus:outline-none transition"
                                                       placeholder="Votre nom" />
                                        </div>
                                        <ValidationMessage For="@(() => model.FullName)" class="text-xs text-red-500 mt-1" />
                                    </div>

                                    <div class="mb-5">
                                        <label class="block text-xs font-medium text-title mb-2">ADRESSE EMAIL</label>
                                        <div class="relative">
                                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><i
                                                class="fas fa-envelope"></i></span>
                                                <InputText @bind-Value="model.Email" type="email"
                                                           class="w-full rounded-lg bg-surface text-body shadow-md px-4 py-3 pl-12 text-sm focus:outline-none transition"
                                                           placeholder="nom@exemple.com" />
                                            </div>
                                            <ValidationMessage For="@(() => model.Email)" class="text-xs text-red-500 mt-1" />
                                        </div>

                                        <div class="mb-5">
                                            <label class="block text-xs font-medium text-title mb-2">SUJET</label>
                                            <div class="relative">
                                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><i
                                                    class="fas fa-tag"></i></span>
                                                    <InputText @bind-Value="model.Subject"
                                                               class="w-full rounded-lg bg-surface text-body shadow-md px-4 py-3 pl-12 text-sm focus:outline-none transition"
                                                               placeholder="Sujet de votre message" />
                                                </div>
                                                <ValidationMessage For="@(() => model.Subject)" class="text-xs text-red-500 mt-1" />
                                            </div>

                                            <div class="mb-6">
                                                <label class="block text-xs font-medium text-title mb-2">MESSAGE</label>
                                                <InputTextArea @bind-Value="model.Message" rows="5"
                                                               class="w-full rounded-lg bg-surface text-body shadow-md px-4 py-3 text-sm focus:outline-none transition resize-y"
                                                               placeholder="Votre message..." />
                                                <ValidationMessage For="@(() => model.Message)" class="text-xs text-red-500 mt-1" />
                                            </div>

                                            <button type="submit" disabled="@isLoading"
                                                    class="w-full rounded-lg bg-primary hover:bg-accent-hover text-white py-3 font-medium shadow-md transition disabled:opacity-60">
                                                @(isLoading ? "Envoi en cours..." : "Envoyer le message")
                                            </button>
                                        </EditForm>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                </div>

@code {
    private ContactRequest model = new();
    private bool isLoading = false;
    private bool isSuccess = false;
    private string errorMessage = string.Empty;
    private PublicSettingsResponse? settings;
    private string contactEmail = "";
    private string tel = "";
    private string location = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            settings = await SettingsService.GetPublicSettingsAsync();
            if (settings is not null)
            {
                contactEmail = settings.ContactEmail;
                tel = settings.Tel;
                location = settings.Location;
            }
        }
        catch
        {
            // Fallback silencieux
        }

        if (string.IsNullOrWhiteSpace(contactEmail))
            contactEmail = "contact@dotnetniger.com";
        if (string.IsNullOrWhiteSpace(tel))
            tel = "+227 12 34 56 78";
        if (string.IsNullOrWhiteSpace(location))
            location = "Niamey, Niger";
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var success = await ContactService.SendAsync(model);
            if (success)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = "Une erreur est survenue. Veuillez réessayer.";
            }
        }
        catch
        {
            errorMessage = "Une erreur est survenue. Veuillez réessayer.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetForm()
    {
        model = new();
        isSuccess = false;
        errorMessage = string.Empty;
        isLoading = false;
    }
}
