@* Carte admin des commentaires avec actions de modération. *@
@using DotnetNiger.UI.Models.Responses
@using DotnetNiger.UI.Models.Requests
@inject ICommentService CommentService
@inject IToastService ToastService
@inject IJSRuntime JS

<div class="group rounded-lg bg-surface shadow-md p-5">
    <div class="mb-3 flex items-start justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
            <div class="h-10 w-10 flex-shrink-0 overflow-hidden rounded-full bg-gray-100">
                @if (!string.IsNullOrWhiteSpace(Comment?.AuthorAvatar))
                {
                    <ResolvedImage Src="@Comment.AuthorAvatar" alt="@Comment.AuthorName"
                                   class="h-full w-full object-cover" />
                }
                else
                {
                    <div class="flex h-full w-full items-center justify-center text-sm font-semibold text-body">
                        @((Comment?.AuthorName ?? "?")[..1].ToUpperInvariant())
                    </div>
                }
            </div>
            <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-title">@Comment?.AuthorName</p>
                <p class="text-xs text-muted">@Comment?.CreatedAt.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <div class="flex flex-col items-end gap-1">
            <span
                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @GetStatusClass(Comment?.Status ?? "")">
                @GetStatusLabel(Comment?.Status ?? "")
            </span>
            <span
                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(Comment?.PostId != Guid.Empty ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                @(Comment?.PostId != Guid.Empty ? "Article" : "Événement")
            </span>
        </div>
    </div>

    <p class="mb-3 text-sm leading-6 text-body line-clamp-3">@Comment?.Content</p>

    <div class="mb-2 text-xs text-muted truncate">
        <span class="font-medium">Cible:</span> @GetTargetTitle(Comment)
    </div>

    <div class="flex items-center gap-2 border-t border-gray-100 pt-3">
        @if (Comment?.Status == "pending")
        {
            <button @onclick="() => ApproveComment(Comment.Id)"
                    class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium text-green-600 transition hover:bg-green-50">
                <i class="fas fa-check text-xs"></i>
                <span>Approuver</span>
            </button>
            <button @onclick="() => RejectComment(Comment.Id)"
                    class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium text-red-600 transition hover:bg-red-50">
                <i class="fas fa-xmark text-xs"></i>
                <span>Rejeter</span>
            </button>
        }
        <button @onclick="() => DeleteComment(Comment?.Id ?? Guid.Empty)"
                class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium text-body transition hover:bg-gray-100">
            <i class="fas fa-trash text-xs"></i>
            <span>Supprimer</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public CommentResponse? Comment { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task ApproveComment(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Approuver ce commentaire ?");
        if (!confirmed) return;

        var updated = await CommentService.ApproveCommentAsync(id);
        if (updated is not null)
        {
            ToastService.ShowToast("Commentaire approuvé.", ToastLevel.Success);
            await OnChanged.InvokeAsync();
        }
        else
        {
            ToastService.ShowToast("Erreur lors de l'approbation.", ToastLevel.Error);
        }
    }

    private async Task RejectComment(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Rejeter ce commentaire ?");
        if (!confirmed) return;

        var updated = await CommentService.RejectCommentAsync(id);
        if (updated is not null)
        {
            ToastService.ShowToast("Commentaire rejeté.", ToastLevel.Success);
            await OnChanged.InvokeAsync();
        }
        else
        {
            ToastService.ShowToast("Erreur lors du rejet.", ToastLevel.Error);
        }
    }

    private async Task DeleteComment(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Supprimer ce commentaire ?");
        if (!confirmed) return;

        var deleted = await CommentService.DeleteCommentAsync(new DeleteCommentRequest { Id = id, DeleteAllReplies = true });
        if (deleted)
        {
            ToastService.ShowToast("Commentaire supprimé.", ToastLevel.Success);
            await OnChanged.InvokeAsync();
        }
        else
        {
            ToastService.ShowToast("Erreur lors de la suppression.", ToastLevel.Error);
        }
    }

    private static string GetStatusClass(string status) => status switch
    {
        "pending" => "bg-amber-100 text-amber-700",
        "approved" => "bg-success-bg text-success",
        "rejected" => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-title"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "pending" => "En attente",
        "approved" => "Approuvé",
        "rejected" => "Rejeté",
        _ => status
    };

    private static string GetTargetTitle(CommentResponse? comment)
    {
        if (comment is null) return "—";
        if (!string.IsNullOrWhiteSpace(comment.PostTitle))
            return comment.PostTitle;
        if (!string.IsNullOrWhiteSpace(comment.EventTitle))
            return comment.EventTitle;
        return "—";
    }
}
