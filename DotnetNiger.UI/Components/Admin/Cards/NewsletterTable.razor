@* Tableau admin des abonnés newsletter avec suppression inline. *@
@using DotnetNiger.UI.Models.Responses
@inject IConfirmService ConfirmService

<div class="rounded-lg bg-surface shadow-md">
    <table class="w-full">
        <thead class="border-b">
            <tr>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Email</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Date inscription</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Statut</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (Subscribers is null || Subscribers.Count == 0)
            {
                <tr>
                    <td colspan="4" class="px-6 py-10 text-center text-sm text-body">Aucun abonné.</td>
                </tr>
            }
            else
            {
                @foreach (var sub in Subscribers)
                {
                    <tr @key="sub.Email" class="transition hover:bg-gray-50/80">
                        <td class="px-6 py-4 text-sm font-medium text-title">@sub.Email</td>
                        <td class="px-6 py-4 text-sm text-body">@sub.SubscribedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-6 py-4 text-sm">
                            <span
                                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(sub.IsConfirmed ? "bg-success-bg text-success" : "bg-amber-100 text-amber-700")">
                                @(sub.IsConfirmed ? "Confirmé" : "En attente")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <button @onclick="() => ConfirmDelete(sub.Email)"
                                    class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium text-rose-600 transition hover:bg-rose-50">
                                <i class="fas fa-trash text-xs"></i>
                                <span>Supprimer</span>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<NewsletterSubscriberDto> Subscribers { get; set; } = new();
    [Parameter] public EventCallback<string> OnDelete { get; set; }

    private async Task ConfirmDelete(string email)
    {
        var confirmed = await ConfirmService.ShowAsync($"Supprimer l'abonné {email} ?");
        if (!confirmed) return;

        if (OnDelete.HasDelegate)
            await OnDelete.InvokeAsync(email);
    }
}
