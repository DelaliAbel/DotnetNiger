@* Tableau admin des commentaires — suppression uniquement. *@
@using DotnetNiger.UI.Models.Responses
@using DotnetNiger.UI.Models.Requests
@inject ICommentService CommentService
@inject IToastService ToastService
@inject IConfirmService ConfirmService

<div class="overflow-hidden rounded-lg bg-surface shadow-md">
    <table class="w-full">
        <thead class="border-b">
            <tr>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Auteur</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Contenu</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Type</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Cible</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Date</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (Comments is null || Comments.Count == 0)
            {
                <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-sm text-body">Aucun commentaire trouvé.</td>
                </tr>
            }
            else
            {
                @foreach (var comment in Comments)
                {
                    <tr @key="comment.Id" class="transition hover:bg-gray-50/80">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="h-8 w-8 flex-shrink-0 overflow-hidden rounded-full bg-gray-100">
                                    @if (!string.IsNullOrWhiteSpace(comment.AuthorAvatar))
                                    {
                                        <ResolvedImage Src="@comment.AuthorAvatar" alt="@comment.AuthorName"
                                                       class="h-full w-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="flex h-full w-full items-center justify-center text-xs font-semibold text-body">
                                            @((comment.AuthorName ?? "?")[..1].ToUpperInvariant())
                                        </div>
                                    }
                                </div>
                                <span class="text-sm font-medium text-title">@comment.AuthorName</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-body max-w-xs truncate">@Truncate(comment.Content, 150)</td>
                        <td class="px-6 py-4 text-sm">
                            <span
                                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(comment.PostId != Guid.Empty ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                                @(comment.PostId != Guid.Empty ? "Article" : "Événement")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-body max-w-[200px] truncate">
                            @GetTargetTitle(comment)
                        </td>
                        <td class="px-6 py-4 text-sm text-body">@comment.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-4 text-sm">
                            <button @onclick="() => DeleteComment(comment.Id)"
                                    class="rounded-lg p-2 text-body transition hover:bg-gray-100" title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<CommentResponse> Comments { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task DeleteComment(Guid id)
    {
        var confirmed = await ConfirmService.ShowAsync("Supprimer ce commentaire ?");
        if (!confirmed) return;

        var deleted = await CommentService.DeleteCommentAsync(new DeleteCommentRequest { Id = id, DeleteAllReplies = true });
        if (deleted)
        {
            ToastService.ShowToast("Commentaire supprimé.", ToastLevel.Success);
            await OnChanged.InvokeAsync();
        }
        else
        {
            ToastService.ShowToast("Erreur lors de la suppression.", ToastLevel.Error);
        }
    }

    private static string Truncate(string value, int maxLength)
        => value?.Length > maxLength ? value[..maxLength] + "..." : value ?? "";

    private static string GetTargetTitle(CommentResponse comment)
    {
        if (!string.IsNullOrWhiteSpace(comment.PostTitle))
            return comment.PostTitle;
        if (!string.IsNullOrWhiteSpace(comment.EventTitle))
            return comment.EventTitle;
        return "—";
    }
}
