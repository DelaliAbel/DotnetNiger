@* Carte admin des événements avec menu d'actions harmonisé. *@
@using DotnetNiger.UI.Models.Responses
@inject NavigationManager NavigationManager
@inject IEventService EventService
@inject IConfirmService ConfirmService

<div class="group rounded-lg bg-surface shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
    <div class="relative w-full overflow-hidden aspect-video">
        <ResolvedImage Src="@Event?.CoverImageUrl" Icon="fa-calendar" class="h-full w-full" alt="@Event?.Title" />
    </div>

    <div class="p-5">
        <div class="mb-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h3 class="truncate text-lg font-semibold text-title">@Event?.Title</h3>
                <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span class="rounded-full px-3 py-1 text-xs font-semibold @StatusCssClass">
                        <span class="mr-1 inline-block h-2 w-2 rounded-full @StatusDotCssClass"></span>
                        @StatusLabel
                    </span>
                    <span
                    class="rounded-full bg-primary px-3 py-1 text-xs font-semibold text-title">@Event?.EventType</span>
                </div>
            </div>

            <AdminActionDropdown ItemId="@(Event?.Id ?? Guid.Empty)" Status="@(Event?.Status ?? "Draft")" ReviewStatusValue="PendingReview"
                                 ViewLabel="Voir l'événement" EditLabel="Modifier" DeleteLabel="Supprimer" ApproveLabel="Publier"
                                 RejectLabel="Rejeter" OnView="OpenEvent" OnEdit="EditEvent" OnDelete="DeleteEvent"
                                 OnApprove="SetPublished" OnReject="DeleteEvent" />
        </div>

        <p class="mb-4 line-clamp-3 text-sm leading-6 text-body break-words">
            @((MarkupString)HtmlSanitizer.Sanitize(Event?.Description ?? string.Empty))</p>

            <div class="flex items-center justify-between gap-3 border-t border-gray-100 pt-4 text-sm text-body">
                <span class="truncate font-medium">@Event?.OrganizerName</span>
                <span class="whitespace-nowrap">@Event?.StartDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
    </div>
@code {

    [Parameter]
    public EventDto? Event { get; set; }

    [Parameter]
    public EventCallback OnEventDeleted { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSetPending { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSetPublished { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSetArchived { get; set; }

   
    private bool IsPublished => Event?.IsPublished == true;
    private bool IsPending => Event?.Status == "PendingReview";
    private bool IsArchived => Event?.Status == "Archived";
    private bool IsCancelled => Event?.Status == "Cancelled";

    private string StatusLabel => Event?.Status switch
    {
        "Published" => "Publié",
        "PendingReview" => "En cours de validation",
        "Archived" => "Archivé",
        "Cancelled" => "Annulé",
        _ => "Brouillon"
    };

    private string StatusCssClass => Event?.Status switch
    {
        "Published" => "bg-green-100 text-green-700",
        "PendingReview" => "bg-amber-100 text-amber-700",
        "Archived" => "bg-gray-100 text-gray-700",
        "Cancelled" => "bg-red-100 text-red-700",
        _ => "bg-blue-100 text-blue-700"
    };

    private string StatusDotCssClass => Event?.Status switch
    {
        "Published" => "bg-green-500",
        "PendingReview" => "bg-amber-500",
        "Archived" => "bg-gray-500",
        "Cancelled" => "bg-red-500",
        _ => "bg-blue-500"
    };

    private Task OpenEvent()
    {
        if (Event is null) return Task.CompletedTask;
        NavigationManager.NavigateTo($"/admin/events/{Event.Slug}");
        return Task.CompletedTask;
    }

    private Task EditEvent(Guid id)
    {
        if (Event is null) return Task.CompletedTask;
        NavigationManager.NavigateTo($"/admin/events/edit/{Event.Id}");
        return Task.CompletedTask;
    }

    private async Task DeleteEvent(Guid id)
    {
        if (Event is null) return;
        var confirmed = await ConfirmService.ShowAsync("Êtes-vous sûr de vouloir supprimer cet événement ?");
        if (!confirmed) return;
        await EventService.DeleteEventAsync(Event.Id);
        await OnEventDeleted.InvokeAsync();
    }

    private async Task SetPending(Guid id)
    {
        if (Event is null) return;
        await OnSetPending.InvokeAsync(Event.Id);
    }

    private async Task SetPublished(Guid id)
    {
        if (Event is null) return;
        await OnSetPublished.InvokeAsync(Event.Id);
    }

    private async Task SetArchived(Guid id)
    {
        if (Event is null) return;
        await OnSetArchived.InvokeAsync(Event.Id);
    }
}