@* Tableau admin des partenaires avec actions harmonisées. *@
@using DotnetNiger.UI.Models.Responses
@inject IPartnerService PartnerService
@inject NavigationManager Navigation
@inject IToastService ToastService

<div class="rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
    <table class="w-full">
        <thead class="border-b border-gray-100 bg-gray-50">
            <tr>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Nom</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Type</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Site web</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Ordre</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Statut</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (Partners is null || Partners.Count == 0)
            {
                <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-500">Aucun partenaire disponible.</td>
                </tr>
            }
            else
            {
                @foreach (var partner in Partners)
                {
                    <tr @key="partner.Id" class="transition hover:bg-gray-50/80">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div
                                    class="h-10 w-10 flex-shrink-0 overflow-hidden rounded-lg bg-gray-100 flex items-center justify-center">
                                    @if (!string.IsNullOrWhiteSpace(partner.LogoUrl))
                                    {
                                        <ResolvedImage Src="@partner.LogoUrl" alt="@partner.Name"
                                                       class="h-full w-full object-cover" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-handshake text-sm text-gray-400"></i>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-title">@partner.Name</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <span
                                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(partner.PartnerType == "education" ? "bg-blue-100 text-blue-700" : "bg-amber-100 text-amber-700")">
                                @GetPartnerTypeLabel(partner.PartnerType)
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-body">
                            @if (!string.IsNullOrWhiteSpace(partner.WebsiteUrl))
                            {
                                <a href="@partner.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                                   class="text-primary hover:underline">@partner.WebsiteUrl</a>
                            }
                            else
                            {
                                <span class="text-gray-400">—</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-sm text-body">@partner.SortOrder</td>
                        <td class="px-6 py-4 text-sm">
                            <span
                                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(partner.IsActive ? "bg-success-bg text-success" : "bg-gray-100 text-gray-700")">
                                @(partner.IsActive ? "Actif" : "Inactif")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <AdminActionDropdown ItemId="partner.Id" Status="@(partner.IsActive ? "Published" : "Pending")"
                                                 ViewLabel="Modifier" EditLabel="Modifier" DeleteLabel="Supprimer" OnView="HandleEdit"
                                                 OnEdit="HandleEdit" OnDelete="HandleDelete" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<PartnerResponse> Partners { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task HandleEdit(Guid id)
    {
        Navigation.NavigateTo($"/admin/partners/edit/{id}");
        return Task.CompletedTask;
    }

    private async Task HandleDelete(Guid id)
    {
        var deleted = await PartnerService.DeleteAsync(id);
        if (deleted)
        {
            ToastService.ShowToast("Partenaire supprimé avec succès.", ToastLevel.Success);
            await OnChanged.InvokeAsync();
        }
        else
        {
            ToastService.ShowToast("Erreur lors de la suppression.", ToastLevel.Error);
        }
    }

    private static string GetPartnerTypeLabel(string type)
    {
        return type.ToLowerInvariant() switch
        {
            "education" => "Éducation",
            "sponsor" => "Sponsor",
            _ => type
        };
    }
}
