@* Tableau admin des membres de l'équipe. *@
@using DotnetNiger.UI.Models.Requests
@using DotnetNiger.UI.Models.Responses

<div class="rounded-lg bg-surface shadow-md">
    <table class="w-full">
        <thead class="border-b border-gray-100 bg-gray-50">
            <tr>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Membre</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Position</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Email</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Rôle</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Statut</th>
                <th class="px-6 py-4 text-left text-sm font-semibold text-title">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (Members.Count == 0)
            {
                <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-sm text-body">Aucun membre dans l'équipe.</td>
                </tr>
            }
            else
            {
                @foreach (var member in Members)
                {
                    <tr @key="member.Id" class="transition hover:bg-gray-50/80">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 flex-shrink-0 overflow-hidden rounded-full bg-gray-100">
                                    @if (!string.IsNullOrWhiteSpace(member.AvatarUrl))
                                    {
                                        <ResolvedImage Src="@member.AvatarUrl" alt="@member.FullName"
                                                       class="h-full w-full object-cover" />
                                    }
                                    else
                                    {
                                        <div
                                            class="flex h-full w-full items-center justify-center text-sm font-semibold text-gray-400">
                                            @GetInitial(member.FullName)
                                        </div>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-title">@member.FullName</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-body">
                            @if (!string.IsNullOrWhiteSpace(member.Position))
                            {
                                <span>@member.Position</span>
                            }
                            else
                            {
                                <span class="text-gray-400">—</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-sm text-body">@member.Email</td>
                        <td class="px-6 py-4 text-sm">
                            <span
                                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold bg-primary/10 text-primary">
                                @GetPrimaryRole(member)
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <span
                                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(member.IsActive ? "bg-success-bg text-success" : "bg-gray-100 text-title")">
                                @(member.IsActive ? "Actif" : "Inactif")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <AdminActionDropdown ItemId="member.Id" Status="Published" IsTeamMember="true"
                                                 UserRoles="member.Roles" ViewLabel="Voir" EditLabel="Modifier" DeleteLabel="Retirer de l'équipe"
                                                 OnView="OnView" OnEdit="OnEdit" OnRemoveFromTeam="OnRemoveFromTeam"
                                                 OnChangeRole="OnChangeRole" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<UserDto> Members { get; set; } = new();
    [Parameter] public EventCallback<Guid> OnView { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnRemoveFromTeam { get; set; }
    [Parameter] public EventCallback<ChangeRoleRequest> OnChangeRole { get; set; }

    private static string GetInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return name.Trim().Substring(0, 1).ToUpperInvariant();
    }

    private static string GetPrimaryRole(UserDto user)
        => user.Roles.FirstOrDefault() ?? "User";
}
