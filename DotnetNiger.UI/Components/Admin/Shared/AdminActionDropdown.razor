@implements IDisposable
@using DotnetNiger.UI.Models.Requests
@using DotnetNiger.UI.Helpers
@inject IJSRuntime JS

<div class="relative inline-block text-left">
    <button type="button"
            class="inline-flex items-center justify-center rounded-full p-2 text-title transition hover:bg-gray-100 hover:text-title"
            aria-haspopup="menu" aria-expanded="@isOpen" aria-label="@AriaLabel" @onclick="ToggleMenu"
            @onclick:stopPropagation="true">
        <i class="fas fa-ellipsis-vertical text-xl"></i>
    </button>

    @if (isOpen)
    {
        <button type="button" class="fixed inset-0 z-40 cursor-default" aria-label="Fermer le menu" @onclick="CloseMenu">
        </button>

        <div
            class="absolute right-0 z-50 mt-2 w-56 overflow-hidden rounded-[22px]   border-gray-100 bg-surface shadow-[0_18px_35px_rgba(15,23,42,0.18)]">
            <div class="py-2">
                @if (showChangeRoleView)
                {
                    <div class="flex items-center gap-2 px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                        <button type="button" class="text-title hover:text-title transition" @onclick="BackToMainMenu"
                                @onclick:stopPropagation="true">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <span>Rôle</span>
                    </div>

                    <div class="my-2 border-t border-gray-100"></div>

                    @foreach (var role in AllRoles)
                    {
                        var isAssigned = UserRoles.Any(r => r.Equals(role.Key, StringComparison.OrdinalIgnoreCase));
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition @(isAssigned ? "text-rose-600 hover:bg-rose-50" : "text-title hover:bg-gray-50")"
                                @onclick="() => ToggleRoleAsync(role.Key, isAssigned)" @onclick:stopPropagation="true">
                            <i class="fas @(isAssigned ? "fa-user-minus text-rose-500" : "fa-user-plus text-title") text-base"></i>
                            <span class="text-sm font-medium">@(isAssigned ? "Retirer " : "Ajouter ")@role.Value</span>
                        </button>
                    }
                }
                else if (IsReviewState)
                {
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left text-emerald-600 transition hover:bg-emerald-50"
                            @onclick="ApproveAsync" @onclick:stopPropagation="true">
                        <i class="fas fa-check text-base"></i>
                        <span class="text-sm font-medium">@ApproveLabel</span>
                    </button>

                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left text-rose-600 transition hover:bg-rose-50"
                            @onclick="RejectAsync" @onclick:stopPropagation="true">
                        <i class="fas fa-xmark text-base"></i>
                        <span class="text-sm font-medium">@RejectLabel</span>
                    </button>

                    <div class="my-2 border-t border-gray-100"></div>

                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left text-title transition hover:bg-gray-50"
                            @onclick="EditAsync" @onclick:stopPropagation="true">
                        <i class="fas fa-pen text-base text-title"></i>
                        <span class="text-sm font-medium">@EditLabel</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left text-title transition hover:bg-gray-50"
                            @onclick="ViewAsync" @onclick:stopPropagation="true">
                        <i class="fas fa-eye text-base text-title"></i>
                        <span class="text-sm font-medium">@ViewLabel</span>
                    </button>

                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left text-title transition hover:bg-gray-50"
                            @onclick="EditAsync" @onclick:stopPropagation="true">
                        <i class="fas fa-pen text-base text-title"></i>
                        <span class="text-sm font-medium">@EditLabel</span>
                    </button>

                    @if (OnToggleStatus.HasDelegate)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left text-title transition hover:bg-gray-50"
                                @onclick="ToggleStatusAsync" @onclick:stopPropagation="true">
                            <i class="fas fa-toggle-on text-base text-title"></i>
                            <span class="text-sm font-medium">@ToggleStatusLabel</span>
                        </button>
                    }

                    @if (OnChangeRole.HasDelegate)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left text-title transition hover:bg-gray-50"
                                @onclick="ShowRoleSelection" @onclick:stopPropagation="true">
                            <i class="fas fa-user-shield text-base text-title"></i>
                            <span class="text-sm font-medium">Changer le rôle</span>
                        </button>
                    }

                    @if (IsTeamMember && OnRemoveFromTeam.HasDelegate)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left text-rose-600 transition hover:bg-rose-50"
                                @onclick="RemoveFromTeamAsync" @onclick:stopPropagation="true">
                            <i class="fas fa-user-minus text-base"></i>
                            <span class="text-sm font-medium">Retirer de l'équipe</span>
                        </button>
                    }
                    else if (OnAddToTeam.HasDelegate)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left text-title transition hover:bg-gray-50"
                                @onclick="AddToTeamAsync" @onclick:stopPropagation="true">
                            <i class="fas fa-user-plus text-base text-title"></i>
                            <span class="text-sm font-medium">Intégrer à l'équipe</span>
                        </button>
                    }

                    <div class="my-2 border-t border-gray-100"></div>

                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left text-rose-600 transition hover:bg-rose-50"
                            @onclick="DeleteAsync" @onclick:stopPropagation="true">
                        <i class="fas fa-trash text-base"></i>
                        <span class="text-sm font-medium">@DeleteLabel</span>
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid ItemId { get; set; }

    [Parameter]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public string ReviewStatusValue { get; set; } = "Pending";

    [Parameter]
    public string AriaLabel { get; set; } = "Ouvrir le menu d'actions";

    [Parameter]
    public string ViewLabel { get; set; } = "Voir l'article";

    [Parameter]
    public string EditLabel { get; set; } = "Modifier";

    [Parameter]
    public string DeleteLabel { get; set; } = "Supprimer";

    [Parameter]
    public string ToggleStatusLabel { get; set; } = "Activer / Désactiver";

    [Parameter]
    public string ApproveLabel { get; set; } = "Approuver";

    [Parameter]
    public string RejectLabel { get; set; } = "Rejeter";

    [Parameter]
    public EventCallback<Guid> OnView { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Guid> OnToggleStatus { get; set; }

    [Parameter]
    public EventCallback<Guid> OnApprove { get; set; }

    [Parameter]
    public EventCallback<Guid> OnReject { get; set; }

    [Parameter]
    public EventCallback<ChangeRoleRequest> OnChangeRole { get; set; }

    [Parameter]
    public EventCallback<(Guid UserId, string Position)> OnAddToTeam { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRemoveFromTeam { get; set; }

    [Parameter]
    public bool IsTeamMember { get; set; }

    [Parameter]
    public List<string> UserRoles { get; set; } = new();

    private static event Action<Guid>? OnMenuOpened;

    private readonly Guid _instanceId = Guid.NewGuid();
    private bool isOpen;
    private bool showChangeRoleView;

    private static readonly Dictionary<string, string> AllRoles = new()
    {
        { "SuperAdmin", "SuperAdmin" },
        { "Admin", "Admin" },
        { "Collaborator", "Collaborateur" },
        { "User", "Utilisateur" }
    };

    private bool IsReviewState => string.Equals(Status, ReviewStatusValue, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        OnMenuOpened += HandleOtherMenuOpened;
    }

    private void ToggleMenu()
    {
        if (isOpen)
        {
            isOpen = false;
            return;
        }

        OnMenuOpened?.Invoke(_instanceId);
        isOpen = true;
    }

    private void CloseMenu()
    {
        isOpen = false;
        showChangeRoleView = false;
    }

    private void HandleOtherMenuOpened(Guid openedInstanceId)
    {
        if (openedInstanceId == _instanceId || !isOpen)
        {
            return;
        }

        isOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ViewAsync() => await InvokeAndCloseAsync(OnView);

    private async Task EditAsync() => await InvokeAndCloseAsync(OnEdit);

    private async Task DeleteAsync() => await InvokeAndCloseAsync(OnDelete);

    private async Task ToggleStatusAsync() => await InvokeAndCloseAsync(OnToggleStatus);

    private async Task ApproveAsync() => await InvokeAndCloseAsync(OnApprove);

    private async Task RejectAsync() => await InvokeAndCloseAsync(OnReject);

    private void ShowRoleSelection()
    {
        showChangeRoleView = true;
    }

    private void BackToMainMenu()
    {
        showChangeRoleView = false;
    }

    private async Task ToggleRoleAsync(string role, bool isCurrentlyAssigned)
    {
        if (ItemId == Guid.Empty || !OnChangeRole.HasDelegate)
            return;

        var action = isCurrentlyAssigned ? "retirer" : "ajouter";
        bool confirmed = await ConfirmAsync($"Voulez-vous {action} le rôle \"{role}\" ?");
        if (!confirmed)
            return;

        var request = new ChangeRoleRequest
        {
            UserId = ItemId,
            NewRole = role,
            IsRemove = isCurrentlyAssigned
        };
        await OnChangeRole.InvokeAsync(request);
        isOpen = false;
        showChangeRoleView = false;
    }

    private async Task AddToTeamAsync()
    {
        if (ItemId != Guid.Empty && OnAddToTeam.HasDelegate)
        {
            var position = await JS.InvokeAsync<string>("prompt", "Poste dans l'équipe :");
            if (string.IsNullOrWhiteSpace(position))
            {
                isOpen = false;
                return;
            }
            await OnAddToTeam.InvokeAsync((ItemId, position.Trim()));
        }

        isOpen = false;
    }

    private async Task RemoveFromTeamAsync()
    {
        if (ItemId != Guid.Empty && OnRemoveFromTeam.HasDelegate)
        {
            bool confirmed = await ConfirmAsync("Retirer cet utilisateur de l'équipe ?");
            if (!confirmed)
                return;

            await OnRemoveFromTeam.InvokeAsync(ItemId);
        }

        isOpen = false;
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private async Task InvokeAndCloseAsync(EventCallback<Guid> callback)
    {
        if (ItemId != Guid.Empty && callback.HasDelegate)
        {
            await callback.InvokeAsync(ItemId);
        }

        isOpen = false;
    }

    public void Dispose()
    {
        OnMenuOpened -= HandleOtherMenuOpened;
    }
}