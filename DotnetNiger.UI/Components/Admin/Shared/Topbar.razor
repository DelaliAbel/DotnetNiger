@* Composant admin : barre supérieure avec profil et actions rapides. *@
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IConfiguration Config
@inject ISettingsService SettingsService
@inject IUploadService UploadService

<header class="sticky z-20 w-full flex h-16 items-center justify-between bg-background px-8 sm:px-4 md:px-6 shadow-md">
      <div class="flex gap-4">
            <button class="sm:hidden" @onclick="ToggleSidebar">
                  <i class="fas fa-bars text-xl"></i>
            </button>
            <button class="hidden sm:flex items-center text-body hover:text-gray-800 transition-colors"
                    @onclick="ToggleCollapsed" title="@(IsCollapsed ? "Développer" : "Réduire")">
                  <i class="fas @(IsCollapsed ? "fa-chevron-right" : "fa-chevron-left") text-xl"></i>
            </button>
            <div class="flex items-center text-xl font-bold">
                  <img src="@resolvedLogoUrl" alt="@(settings?.LogoNom ?? "dotnet Niger")" class="w-10 h-10">
                  <span class="text-title">@(settings?.SiteName ?? "Dotnet Niger")</span>
            </div>
      </div>
      <div class="flex items-center space-x-4">
            <ThemeToggle />
            <button @onclick="HandleLogout"
                    class="flex items-center gap-2 rounded-lg bg-primary px-3 py-2 text-white hover:bg-hover">
                  <span class="Button hidden sm:inline"> Deconnexion</span>
                  <i class="fas fa-sign-out-alt text-2xl sm:text-xl"></i>
            </button>
      </div>
</header>

@code {
      [Parameter]
      public EventCallback ToggleSidebar { get; set; }

      [Parameter]
      public EventCallback ToggleCollapsed { get; set; }

      [Parameter]
      public bool IsCollapsed { get; set; }

      private PublicSettingsResponse? settings;
      private string resolvedLogoUrl = "/Logo.svg";

      protected override async Task OnInitializedAsync()
      {
            try
            {
                  settings = await SettingsService.GetPublicSettingsAsync();
                  if (settings is not null)
                        resolvedLogoUrl = await UploadService.ResolveImageUrlAsync(settings.LogoUrl) ?? "/Logo.svg";
            }
            catch
            {
                  // Fallback silencieux
            }
      }

      private async Task HandleLogout()
      {
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/", forceLoad: true);
      }
}

}