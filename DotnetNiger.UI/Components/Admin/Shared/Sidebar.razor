                                    <i class="fas fa-handshake w-8 text-2xl"></i>
                                    @if (!IsCollapsed)
                                    {
                                          <span class="Link">Partenaires</span>
                                    }
                              </NavLink>
                        }

                        @if (IsAdmin)
                        {
