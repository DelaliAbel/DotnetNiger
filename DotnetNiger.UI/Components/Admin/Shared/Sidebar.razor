@code {
      [Parameter]
      public bool IsCollapsed { get; set; }

      [Parameter]
      public EventCallback Closed { get; set; }

      [Parameter]
      public bool IsOpen { get; set; }

      private bool IsSuperAdmin => UserStateService.CurrentUser?.Roles.Any(r => RoleConstants.IsSuperAdminRole(r)) ?? false;

      private bool IsAdmin => UserStateService.CurrentUser?.Roles.Any(r => RoleConstants.IsAdminRole(r)) ?? false;

      private bool IsCollaborator => UserStateService.CurrentUser?.Roles.Any(r => string.Equals(r, RoleConstants.Collaborator,
StringComparison.OrdinalIgnoreCase)) ?? false;

      private bool CanAccessMesSections => IsAdmin || IsCollaborator;

      private string GetBackLinkClass() => $"flex items-center gap-2 text-gray-300 transition-colors hover:text-white {(IsCollapsed ? "justify-center" : "")}";

      private string DesktopSidebarWidthClass => IsCollapsed ? "w-20" : "w-64";

      private string DisplayName => string.IsNullOrWhiteSpace(UserStateService.CurrentUser?.Username) ? "Administrateur" :
UserStateService.CurrentUser.Username;

      private string PrimaryRole => UserStateService.CurrentUser?.Roles?.FirstOrDefault() ?? "Membre";

      private string AvatarUrl => UserStateService.CurrentUser?.AvatarUrl ?? string.Empty;

      private bool HasAvatar => !string.IsNullOrWhiteSpace(AvatarUrl);

      private string UserInitial => DisplayName.Substring(0, 1).ToUpperInvariant();

      private PublicSettingsResponse? settings;
      private string resolvedLogoUrl = "/Logo.svg";

      protected override async Task OnInitializedAsync()
      {
            if (UserStateService.CurrentUser is null)
                  await UserStateService.LoadUserFromStorageAsync();

            try
            {
                  settings = await SettingsService.GetPublicSettingsAsync();
                  if (settings is not null)
                        resolvedLogoUrl = await UploadService.ResolveImageUrlAsync(settings.LogoUrl) ?? "/Logo.svg";
            }
            catch
            {
                  // Fallback silencieux
            }
      }
}