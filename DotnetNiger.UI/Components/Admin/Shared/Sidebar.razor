                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active" @onclick="Closed">
                                    <i class="fas fa-newspaper w-8 text-2xl"></i>
                                    <span class="Link">Blog</span>
                              </NavLink>
                        }

                        @if (IsAdmin)
                        {
                              <NavLink href="/admin/events"
                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active" @onclick="Closed">
                                    <i class="fas fa-calendar w-8 text-2xl"></i>
                                    <span class="Link">Événements</span>
                              </NavLink>
