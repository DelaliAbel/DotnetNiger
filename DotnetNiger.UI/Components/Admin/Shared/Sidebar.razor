                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active" @onclick="Closed">
                                    <i class="fas fa-code-branch w-8 text-2xl"></i>
                                    <span class="Link">Projets</span>
                              </NavLink>
