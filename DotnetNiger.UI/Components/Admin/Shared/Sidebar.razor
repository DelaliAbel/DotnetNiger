            <div class="flex flex-1 flex-col overflow-hidden">
                  <div class="flex h-16 items-center gap-3 bg-active px-5 text-2xl font-bold">
                        <img src="@resolvedLogoUrl" alt="@(settings?.LogoNom ?? "Logo du Dotnet Niger")" class="h-10 w-10">
                        <span class="Link">@(settings?.SiteName ?? "Dotnet Niger")</span>
                  </div>

                  <NavLink href="/admin/profile" class="mt-4 flex items-center gap-3 px-5 py-3"
                           ActiveClass="bg-active/80" @onclick="Closed">
                        <div
                              class="flex h-[46px] w-[46px] items-center justify-center overflow-hidden rounded-full bg-slate-700 text-lg font-semibold text-white">
                              @if (HasAvatar)
                              {
                                    <ResolvedImage Src="@(UserStateService.CurrentUser?.AvatarUrl)"
                                                   class="h-full w-full object-cover" alt="@($"Avatar de {DisplayName}")" />
                              }
                              else
                              {
                                    <span>@UserInitial</span>
                              }
                        </div>

                        <div class="min-w-0">
                              <span class="Button block truncate text-white">@DisplayName</span>
                              <span class="Badge block truncate text-role-badge">@PrimaryRole</span>
                        </div>
