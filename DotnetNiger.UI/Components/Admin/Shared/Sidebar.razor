                              <NavLink href="/admin/settings"
                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active">
                                    <i class="fas fa-gear w-8 text-2xl"></i>
                                    @if (!IsCollapsed)
                                    {
                                          <span class="Link">Paramètres</span>
                                    }
                              </NavLink>
                        }
                  </nav>
            </div>

            <div>
                  <div class="border-t border-slate-700 p-4">
                        <NavLink href="/" class="@GetBackLinkClass()">
                              <i class="fas fa-arrow-left mr-3"></i>
                              @if (!IsCollapsed)
                              {
                                    <span>Retour au site</span>
                              }
                        </NavLink>
                  </div>
            </div>
      </aside>

      <div class="fixed inset-0 z-40 bg-black/50 sm:hidden @(IsOpen ? string.Empty : "hidden")" @onclick="Closed"></div>

      <aside
