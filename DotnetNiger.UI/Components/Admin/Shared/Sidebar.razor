@* Composant admin : barre latérale de navigation (responsive + mode réduit). *@
@using DotnetNiger.UI.Helpers
@inject IUserStateService UserStateService
@inject IUploadService UploadService
@inject ISettingsService SettingsService
@inject IUploadService UploadService

<div class="h-full">
      <aside
            class="hidden h-full flex-col justify-between bg-primary text-white shadow-lg transition-all duration-300 sm:flex @DesktopSidebarWidthClass">
            <div class="flex flex-1 flex-col overflow-hidden">
