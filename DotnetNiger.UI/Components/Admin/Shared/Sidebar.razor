                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active" @onclick="Closed">
                                    <i class="fas fa-envelope w-8 text-2xl"></i>
                                    <span class="Link">Newsletter</span>
                              </NavLink>
                        }

                        @if (CanAccessMesSections)
                        {
                              <div class="border-t border-slate-700/40 my-2"></div>
                        }

                        @if (CanAccessMesSections)
                        {
                              <NavLink href="/admin/mes-articles"
                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active" @onclick="Closed">
                                    <i class="fas fa-pen-nib w-8 text-2xl"></i>
                                    <span class="Link">Mes Articles</span>
                              </NavLink>
                        }

                        @if (CanAccessMesSections)
                        {
                              <NavLink href="/admin/mes-evenements"
                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active" @onclick="Closed">
                                    <i class="fas fa-calendar-check w-8 text-2xl"></i>
