                              <NavLink href="/admin/users"
                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active">
                                    <i class="fas fa-user w-8 text-2xl"></i>
                                    @if (!IsCollapsed)
                                    {
                                          <span class="Link">Utilisateurs</span>
                                    }
                              </NavLink>
                        }

