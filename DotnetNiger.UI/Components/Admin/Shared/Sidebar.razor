                        <div
                              class="flex h-[46px] w-[46px] items-center justify-center overflow-hidden rounded-full bg-slate-700 text-lg font-semibold text-white">
                              @if (HasAvatar)
                              {
                                    <ResolvedImage Src="@(UserStateService.CurrentUser?.AvatarUrl)"
                                                   class="h-full w-full object-cover" alt="@($"Avatar de {DisplayName}")" />
                              }
                              else
                              {
                                    <span>@UserInitial</span>
                              }
                        </div>

                        @if (!IsCollapsed)
                        {
                              <div class="min-w-0">
                                    <span class="Button block truncate text-white">@DisplayName</span>
                                    <span class="Badge block truncate text-role-badge">@PrimaryRole</span>
                              </div>
                        }
                  </NavLink>

                  <nav class="sidebar-scroll mt-4 flex-1 space-y-2 overflow-y-auto px-3">
                        @if (IsAdmin || IsCollaborator)
                        {
                              <NavLink href="/admin" Match="NavLinkMatch.All"
                                       class="flex items-center gap-2 rounded-lg px-3 py-3 transition-colors hover:bg-hover"
                                       ActiveClass="bg-active">
                                    <i class="fas fa-gauge w-8 text-2xl"></i>
                                    @if (!IsCollapsed)
                                    {
                                          <span class="Link">Dashboard</span>
                                    }
                              </NavLink>
                        }

                        @if (IsAdmin)
