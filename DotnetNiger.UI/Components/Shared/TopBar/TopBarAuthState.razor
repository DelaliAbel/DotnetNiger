@implements IDisposable
@using DotnetNiger.UI.Services.Helpers
@inject NavigationManager Navigation
@inject IAuthService Auth
@inject IUserStateService UserStateService
@inject IProfileService ProfileService
@inject INotificationService NotificationService
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView>
    <Authorized Context="authState">
        @if (Mobile)
        {
            <button @onclick="ToggleOverlay" class="text-primary hover:text-hover focus:outline-none">
                <i class="fa-solid fa-bars text-2xl"></i>
            </button>

            @* Overlay *@
            <div class="fixed inset-0 z-30 bg-black/50 transition-opacity duration-300 @(isOverlayOpen ? "opacity-100" : "opacity-0 pointer-events-none")"
                 @onclick="CloseOverlay"></div>

            @* Panneau coulissant *@
            <div
                class="fixed top-0 right-0 z-40 flex h-screen w-[75%] flex-col bg-surface shadow-xl transition-transform duration-300 @(isOverlayOpen ? "translate-x-0" : "translate-x-full")">
                <div class="flex items-center justify-between border-b p-4">
                    <div class="flex flex-col justify-center items-center gap-3">
                        <button class="h-20 w-20 overflow-hidden rounded-full border-2 border-primary"
                                @onclick="NavigateToProfileAsync">
                            @if (!string.IsNullOrWhiteSpace(profile?.AvatarUrl))
                            {
                                <ResolvedImage Src="@profile.AvatarUrl" class="h-full w-full object-cover" alt="@DisplayName" />
                            }
                            else
                            {
                                <span
                                class="flex h-full w-full items-center justify-center bg-gray-100 text-sm font-semibold text-primary">@Initials</span>
                            }
                        </button>
                        <div>
                            <p class="text-lg text-center font-bold text-title">@DisplayName</p>
                        </div>
                    </div>
                    <button @onclick="CloseOverlay"
                            class="absolute top-3 right-3 z-40 flex h-8 w-8 items-center justify-center rounded-full text-body hover:bg-gray-100">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>

                <nav class="flex-1 space-y-1 overflow-y-auto p-4">
                    @foreach (var item in MobileNavigationItems)
                    {
                        if (item.Href == "/admin" && !UserStateService.IsAdmin && !UserStateService.IsCollaborator) { continue; }
                        <NavLink href="@item.Href" Match="@item.Match"
                                 class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-title transition hover:bg-gray-100"
                                 ActiveClass="bg-active" @onclick="CloseOverlay">
                            <i class="@item.Icon w-6 text-lg"></i>
                            <span>@item.Label</span>
                        </NavLink>
                    }
                </nav>

                <div class="border-t p-4">
                    <button @onclick="LogoutAsync"
                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-red-500 px-4 py-3 text-sm font-semibold text-white transition hover:bg-red-600">
                        <i class="fa-solid fa-sign-out-alt"></i>
                        <span>Déconnexion</span>
                    </button>
                </div>
            </div>
        }
        else
        {
            <TopBarProfileDropdown User="authState.User" NotificationCount="UnreadNotificationCount" />
        }
    </Authorized>
    <NotAuthorized>
        @if (Mobile)
        {
            <div class="flex items-center gap-2">
                <button @onclick="ToggleOverlay" class="text-primary hover:text-hover focus:outline-none">
                    <i class="fa-solid fa-bars text-2xl"></i>
                </button>
            </div>

            @* Overlay *@
            <div class="fixed inset-0 z-30 bg-black/50 transition-opacity duration-300 @(isOverlayOpen ? "opacity-100" : "opacity-0 pointer-events-none")"
                 @onclick="CloseOverlay"></div>

            @* Panneau coulissant *@
            <div
                class="fixed top-0 right-0 z-40 flex h-screen w-[75%] flex-col bg-surface shadow-xl transition-transform duration-300 @(isOverlayOpen ? "translate-x-0" : "translate-x-full")">
                <div class="flex items-center justify-between border-b p-4">
                    <span class="text-lg font-bold text-title">Menu</span>
                    <button @onclick="CloseOverlay"
                            class="flex h-8 w-8 items-center justify-center rounded-full text-body hover:bg-gray-100">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>

                <nav class="flex-1 space-y-1 overflow-y-auto p-4">
                    @foreach (var item in GuestMobileNavigationItems)
                    {
                        <NavLink href="@item.Href" Match="@item.Match"
                                 class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-title transition hover:bg-gray-100"
                                 ActiveClass="bg-active" @onclick="CloseOverlay">
                            <i class="@item.Icon w-6 text-lg"></i>
                            <span>@item.Label</span>
                        </NavLink>
                    }
                </nav>

                <div class="border-t p-4">
                    <button @onclick="NavigateToLoginAsync"
                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-white transition hover:bg-hover">
                        <i class="fa-solid fa-sign-in-alt"></i>
                        <span>Connecter</span>
                    </button>
                </div>
            </div>
        }
        else
        {
            <button type="button"
                    class="flex items-center gap-2 rounded-lg bg-primary px-3 py-2 text-white transition duration-150 ease-in-out hover:bg-hover"
                    @onclick="NavigateToLoginAsync">
                <i class="fas fa-sign-in-alt text-2xl"></i>
                <span class="text-sm font-semibold text-white">Connecter</span>
            </button>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public bool Mobile { get; set; }
    [Parameter] public int? NotificationCount { get; set; }
    [Parameter] public EventCallback OnActionCompleted { get; set; }

    private UserDto? profile;
    private int unreadNotificationCount;
    private bool isOverlayOpen;

    private string DisplayName => StringHelper.FirstNotEmpty(
        profile?.FullName,
        profile?.Username,
        "Utilisateur"
    )!;

    private string Initials => StringHelper.GetInitials(DisplayName);

    private MobileNavItem[] GuestMobileNavigationItems { get; } =
    [
        new MobileNavItem("/", "Accueil", "fa-solid fa-house", NavLinkMatch.All),
        new MobileNavItem("/propos", "À propos", "fa-solid fa-circle-info"),
        new MobileNavItem("/ressources", "Ressources", "fa-solid fa-folder"),
        new MobileNavItem("/community", "Communauté", "fa-solid fa-users"),
        new MobileNavItem("/blog", "Blog", "fa-solid fa-newspaper"),
        new MobileNavItem("/evenements", "Événements", "fa-solid fa-calendar"),
        new MobileNavItem("/partners", "Partenaires", "fa-solid fa-handshake"),
        new MobileNavItem("/contact", "Contact", "fa-solid fa-envelope")
    ];

    private MobileNavItem[] MobileNavigationItems { get; } =
    [
        new MobileNavItem("/profile", "Mon Profil", "fa-solid fa-user", NavLinkMatch.All),
        new MobileNavItem("/", "Accueil", "fa-solid fa-house"),
        new MobileNavItem(Href: "/propos", Label : "A propos", Icon: "fa-solid fa-circle-info"),
        new MobileNavItem("/ressources", "Ressources", "fa-solid fa-folder"),
        new MobileNavItem("/community", "Communauté", "fa-solid fa-users"),
        new MobileNavItem("/blog", "Blog", "fa-solid fa-newspaper"),
        new MobileNavItem("/evenements", "Événements", "fa-solid fa-calendar"),
        new MobileNavItem("/partners", "Partenaires", "fa-solid fa-handshake"),
        new MobileNavItem("/contact", "Contact", "fa-solid fa-envelope"),
        new MobileNavItem("/admin", "Administration", "fa-solid fa-shield-halved")
    ];

    private void ToggleOverlay()
    {
        isOverlayOpen = !isOverlayOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!(authState.User.Identity?.IsAuthenticated ?? false))
                return;

            // Charger le profil depuis le cache localStorage (instantané, pas d'appel API)
            if (UserStateService.CurrentUser is null)
                await UserStateService.LoadUserFromStorageAsync();

            profile = UserStateService.CurrentUser;

            // Si pas de cache (première visite), fetch API une fois puis stocke en localStorage
            if (profile is null)
            {
                var fetched = await ProfileService.GetProfileAsync();
                if (fetched.Id != Guid.Empty)
                {
                    await UserStateService.SetUserAsync(fetched);
                    profile = fetched;
                }
            }

            // Notifications — fetch API à chaque session
            if (profile is not null)
                unreadNotificationCount = await NotificationService.GetUnreadCountAsync(profile.Id);

            NotificationService.NotificationsChanged += HandleNotificationsChanged;
            UserStateService.OnChange += HandleUserStateChanged;
        }
        catch
        {
            profile = null;
            unreadNotificationCount = 0;
        }
    }

    public void Dispose()
    {
        NotificationService.NotificationsChanged -= HandleNotificationsChanged;
        UserStateService.OnChange -= HandleUserStateChanged;
    }

    private int UnreadNotificationCount => unreadNotificationCount > 0 ? unreadNotificationCount :
NotificationCount.GetValueOrDefault();

    private async Task NavigateToLoginAsync()
    {
        await NotifyActionCompletedAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task NavigateToProfileAsync()
    {
        await NotifyActionCompletedAsync();
        Navigation.NavigateTo(UserStateService.IsAdmin ? "/admin/profile" : "/profile");
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        await NotifyActionCompletedAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task NavigateToNotificationsAsync()
    {
        await NotifyActionCompletedAsync();
        Navigation.NavigateTo("/notifications");
    }
    private void HandleUserStateChanged()
    {
        profile = UserStateService.CurrentUser;
        InvokeAsync(StateHasChanged);
    }

    private void HandleNotificationsChanged(Guid userId)
    {
        if (profile is null || userId != profile.Id)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                unreadNotificationCount = await NotificationService.GetUnreadCountAsync(profile.Id);
            }
            catch
            {
                unreadNotificationCount = 0;
            }
            StateHasChanged();
        });
    }

    private async Task CloseOverlay()
    {
        isOverlayOpen = false;
        await NotifyActionCompletedAsync();
    }

    private Task NotifyActionCompletedAsync()
    {
        if (!OnActionCompleted.HasDelegate)
            return Task.CompletedTask;

        return OnActionCompleted.InvokeAsync();
    }

    private sealed record MobileNavItem(string Href, string Label, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);
}
