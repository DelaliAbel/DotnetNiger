
@using DotnetNiger.UI.Models
@inject IUploadService UploadService
@inject IJSRuntime JS

<div class="w-full @(Compact ? "" : "shadow-md")">
    @if (isLoading)
    {
        <div class="flex flex-col items-center gap-3 @(Compact ? "py-4" : "py-8") border-2 border-dashed rounded-lg
                    border-gray-300 bg-surface">
            <i class="fa-solid fa-spinner fa-spin @(Compact ? "text-2xl" : "text-4xl") text-primary"></i>
            <p class="text-subtitle @(Compact ? "text-xs" : "font-medium")">Upload en cours...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(PreviewUrl))
    {
        <div class="relative @(Compact ? "border p-3" : "border-2 border-green-300 p-6") bg-surface border-dashed rounded-lg text-center">
            <div class="relative inline-block @(Compact ? "w-full max-w-xs" : "w-full max-w-2xl")">
                <img src="@PreviewUrl"
                     alt="Prévisualisation"
                     class="w-full rounded-lg object-contain shadow-md @(Compact ? "h-32" : "aspect-video")" />
                <button type="button"
                        @onclick="RemoveImage"
                        class="absolute -top-3 -right-3 bg-red-500 hover:bg-red-600 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg transition-colors"
                        title="Supprimer l'image">
                    <i class="fa-solid fa-times"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <label class="relative block border-2 border-dashed rounded-lg @(Compact ? "p-4" : "p-6") text-center transition-all duration-200 cursor-pointer
                       border-gray-300 hover:border-primary bg-surface overflow-hidden">
            <div class="flex flex-col items-center gap-3 @(Compact ? "py-2" : "py-8") pointer-events-none">
                <i class="fa-solid fa-cloud-upload-alt @(Compact ? "text-3xl" : "text-5xl") text-gray-400"></i>
                <div>
                    <p class="@(Compact ? "text-xs" : "text-subtitle font-medium")">
                        <span class="text-primary underline">Cliquez</span> pour sélectionner un fichier
                    </p>
                    <p class="text-gray-400 text-xs mt-1">
                        @(Compact ? "JPG, PNG, WebP, GIF" : "Formats : JPG, PNG, WebP, GIF &mdash; Max 3 Mo")
                    </p>
                </div>
            </div>

            <InputFile OnChange="HandleFileSelected"
                       accept=".jpg,.jpeg,.png,.webp,.gif"
                       class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
        </label>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mt-3 flex items-center gap-2 rounded-lg bg-red-50 p-3 text-sm text-red-700">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@ErrorMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="mt-3 flex items-center gap-2 rounded-lg bg-green-50 p-3 text-sm text-green-700">
            <i class="fa-solid fa-check-circle"></i>
            <span>@SuccessMessage</span>
        </div>
    }
</div>

@code {
    private bool isLoading;
    private string? PreviewUrl;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private string? _currentImageUrl;
    private string? _previousExistingImageUrl;

    [Parameter] public UploadType UploadType { get; set; } = UploadType.Event;
    [Parameter] public EventCallback<string> OnImageUploaded { get; set; }
    [Parameter] public EventCallback OnImageDeleted { get; set; }
    [Parameter] public string? ExistingImageUrl { get; set; }
    [Parameter] public bool Compact { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        if (ExistingImageUrl == _previousExistingImageUrl)
            return;

        _previousExistingImageUrl = ExistingImageUrl;
        await LoadExistingImageAsync();
    }

    private async Task LoadExistingImageAsync()
    {
        if (!string.IsNullOrWhiteSpace(ExistingImageUrl))
        {
            _currentImageUrl = ExistingImageUrl;
            PreviewUrl = await UploadService.ResolveImageUrlAsync(ExistingImageUrl) ?? ExistingImageUrl;
        }
        else
        {
            _currentImageUrl = null;
            PreviewUrl = null;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        await UploadFileAsync(file);
    }

    private async Task UploadFileAsync(IBrowserFile file)
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var response = await UploadService.UploadImageAsync(file, UploadType);

            if (response.Success)
            {
                _currentImageUrl = response.ImageUrl;
                PreviewUrl = await UploadService.ResolveImageUrlAsync(response.ImageUrl) ?? response.ImageUrl;
                SuccessMessage = response.Message;
                await OnImageUploaded.InvokeAsync(response.ImageUrl);
            }
            else
            {
                ErrorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur inattendue : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RemoveImage()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            if (!string.IsNullOrWhiteSpace(_currentImageUrl))
            {
                await UploadService.DeleteImageAsync(_currentImageUrl);
            }

            _currentImageUrl = null;
            PreviewUrl = null;
            SuccessMessage = "Image supprimée avec succès.";
            await OnImageDeleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors de la suppression : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

}
