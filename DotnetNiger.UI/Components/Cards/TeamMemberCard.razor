@namespace DotnetNiger.UI.Components

@using DotnetNiger.UI.Models.Responses

<article
    class="overflow-hidden rounded-lg bg-surface shadow-md hover:shadow-lg">
    <div
        class="relative h-48 sm:h-56 md:h-64 overflow-hidden">
        <ResolvedImage Src="@Member?.AvatarUrl" Icon="fa-user" alt="@GetDisplayName()"
                       class="absolute inset-0 h-full w-full" />
    </div>

    <div class="space-y-2 p-4 sm:space-y-3 sm:p-5">
        <div>
            <h3 class="text-base sm:text-lg font-bold text-title">@GetDisplayName()</h3>
            <p class="text-xs sm:text-sm font-semibold text-warning">@GetRole()</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Member?.Bio))
        {
            <p class="text-xs sm:text-sm leading-6 sm:leading-7 text-body break-words">@(new
                                                            MarkupString(HtmlSanitizer.Sanitize(Member?.Bio) ?? string.Empty))</p>
            }

            @if (Member?.SocialLinks?.Any() == true)
            {
                <div class="flex items-center gap-3 pt-2">
                    @foreach (var link in Member.SocialLinks)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                           class="text-slate-400 hover:text-primary transition text-xl" title="@link.Platform">
                            <i class="@link.Icone"></i>
                        </a>
                    }
                </div>
            }
        </div>
    </article>

@code {
    [Parameter]
    public TeamMemberResponse? Member { get; set; }

    private string GetDisplayName()
    {
        return string.IsNullOrWhiteSpace(Member?.FullName) ? "Membre" : Member!.FullName;
    }

    private string GetRole()
    {
        return string.IsNullOrWhiteSpace(Member?.Position) ? "Membre" : Member!.Position;
    }

}
