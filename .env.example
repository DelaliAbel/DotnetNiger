# JWT (obligatoire — minimum 32 caractères)
JWT_KEY=TaCleJWTSuperSecreteMinimum32Caracteres!

# Domaine public (laisser vide pour localhost)
PUBLIC_URL=http://localhost:5000

# Ports
GATEWAY_PORT=5000
IDENTITY_WEB_PORT=5100

# Gateway
GATEWAY_REGISTRATION_KEY=change-moi
INTERNAL_API_KEY=change-moi

# Admin
ADMIN_PASSWORD=Admin@123456

# Identity.Web OIDC
IDENTITY_WEB_CLIENT_ID=web-ui
IDENTITY_WEB_CLIENT_SECRET=

# SMTP (optionnel — email confirmation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ton.email@gmail.com
SMTP_PASSWORD=ton-mot-de-passe-app
SMTP_FROM_EMAIL=noreply@dotnetniger.com
SMTP_SUPPORT_EMAIL=support@dotnetniger.com

# Rate limiting
RATE_LIMIT_PERMIT=5
RATE_LIMIT_WINDOW=60

# Health checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_MAX_FAILURES=3
