<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — DotnetNiger</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            background: #f0f0f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 24px 16px;
        }
        .card {
            background: white;
            border-radius: 8px;
            padding: 36px 32px 28px;
            width: 100%;
            max-width: 400px;
            margin: auto;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        .card-wide { max-width: 440px; }
        .logo {
            text-align: center;
            margin-bottom: 20px;
        }
        .logo h1 {
            color: #1a1a1a;
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.3px;
        }
        .logo p {
            color: #666;
            font-size: 13px;
            margin-top: 4px;
        }
        .form-group { margin-bottom: 14px; }
        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #1a1a1a;
            margin-bottom: 4px;
        }
        input[type="email"],
        input[type="password"],
        input[type="text"],
        input[type="tel"] {
            width: 100%;
            padding: 8px 10px;
            border: 1.5px solid #d1d1d1;
            border-radius: 4px;
            font-size: 14px;
            transition: border-color 0.15s;
            outline: none;
            background: #fafafa;
        }
        input:focus { border-color: #0067b8; background: white; }
        .password-wrapper { position: relative; }
        .password-wrapper input { padding-right: 40px; }
        .toggle-password {
            position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
            background: none; border: none; cursor: pointer; padding: 4px;
            color: #999; display: flex; align-items: center;
        }
        .toggle-password:hover { color: #333; }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #1a1a1a;
        }
        button[type="submit"],
        .btn-primary {
            width: 100%;
            padding: 8px;
            background: #0067b8;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s;
            margin-top: 4px;
        }
        button[type="submit"]:hover,
        .btn-primary:hover { background: #005a9e; }
        .error {
            background: #fef2f2;
            color: #c00;
            padding: 8px 10px;
            border-radius: 4px;
            font-size: 13px;
            margin-bottom: 14px;
            text-align: center;
        }
        .success {
            background: #f0fdf4;
            color: #16a34a;
            padding: 8px 10px;
            border-radius: 4px;
            font-size: 13px;
            margin-bottom: 14px;
            text-align: center;
        }
        .info {
            background: #eff6ff;
            color: #1e40af;
            padding: 8px 10px;
            border-radius: 4px;
            font-size: 13px;
            margin-bottom: 14px;
            text-align: center;
        }
        .text-link {
            color: #0067b8;
            text-decoration: none;
            font-weight: 500;
        }
        .text-link:hover { text-decoration: underline; }
        .divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 18px 0;
            color: #999;
            font-size: 12px;
        }
        .divider::before, .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e0e0e0;
        }
        .external-providers { display: flex; flex-direction: column; gap: 8px; }
        .btn-external {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 7px;
            border: 1.5px solid #d1d1d1;
            border-radius: 4px;
            background: white;
            color: #333;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s;
        }
        .btn-external:hover { background: #f5f5f5; }
        .btn-google { border-color: #4285f4; color: #4285f4; }
        .btn-github { border-color: #333; color: #333; }
        .btn-microsoft { border-color: #00a4ef; color: #00a4ef; }
        .row { display: flex; gap: 10px; }
        .row .half { flex: 1; }
        .forgot-password {
            font-size: 12px;
            color: #0067b8;
            text-decoration: none;
            font-weight: 500;
        }
        .forgot-password:hover { text-decoration: underline; }
        .code-input {
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 16px;
            text-align: center;
            font-family: 'Courier New', monospace;
        }
        .btn-link {
            background: none;
            border: none;
            color: #0067b8;
            text-decoration: underline;
            cursor: pointer;
            font-size: 13px;
            padding: 0;
            width: auto;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 11px;
            color: #999;
        }
        .readonly-field {
            background: #f5f5f5;
            cursor: not-allowed;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
            padding: 10px 12px;
            width: 100%;
            font-size: 14px;
            color: #666;
        }
        @@media (max-width: 480px) {
            body { padding: 12px 8px; }
            .card { padding: 28px 20px 24px; max-width: 100%; }
            .card-wide { max-width: 100%; }
            .logo h1 { font-size: 20px; }
            input { font-size: 16px; }
            .row { flex-direction: column; gap: 0; }
        }
    </style>
</head>
<body>
    <div class="card @(ViewData["Wide"] == null ? "" : "card-wide")">
        <div class="logo">
            <h1>DotnetNiger</h1>
            <p>@ViewData["Subtitle"]</p>
        </div>
        @RenderBody()
        <div class="footer">
            &copy; @DateTime.Now.Year DotnetNiger
        </div>
    </div>
    <script>
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.toggle-password');
            if (!btn) return;
            const input = btn.parentElement.querySelector('input');
            if (!input) return;
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            btn.innerHTML = isPassword
                ? '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
                : '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
        });
    </script>
</body>
</html>
