@page
@model DotnetNiger.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublie";
    ViewData["Subtitle"] = "Reinitialisez votre mot de passe";
}

<form method="post">
    @Html.AntiForgeryToken()

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="success">@Model.SuccessMessage</div>
    }

    <div class="form-group">
        <label for="email">Adresse email</label>
        <input type="email" id="email" name="email" required autofocus
               placeholder="vous@exemple.com" />
    </div>

    <button type="submit">Envoyer le lien</button>

    <div style="text-align:center;font-size:13px;margin-top:16px">
        <a href="/Account/Login" class="text-link">Retour a la connexion</a>
    </div>
</form>
