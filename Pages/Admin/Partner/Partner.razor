@page "/admin/partners"
@attribute [Authorize(Roles = "Admin,SuperAdmin,Moderator")]
@using DotnetNiger.UI.Models.Responses
@using DotnetNiger.UI.Components.Admin.Cards
@inject NavigationManager Navigation
@inject IPartnerService PartnerService
@inject IToastService ToastService
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <Skeleton Type="SkeletonType.Title" Class="w-48" />
                    <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-64" />
                </div>
                <Skeleton Type="SkeletonType.Button" Width="160px" />
            </div>
            <div class="overflow-hidden rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Nom</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Type</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Ordre</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Statut</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @for (int i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td class="px-6 py-4"><div class="flex items-center gap-3"><Skeleton Type="SkeletonType.Custom" Class="h-10 w-10 rounded-lg" /><Skeleton Type="SkeletonType.Text" Lines="1" Class="w-32" /></div></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Badge" Width="80px" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Text" Lines="1" Class="w-12" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Badge" Width="60px" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Button" Width="32px" Class="h-8" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <section>
                    <AdminBreadcrumb />
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-body md:text-base">Gérez les partenaires de la communauté.</p>
                </section>
                <button @onclick='() => Navigation.NavigateTo("/admin/partners/nouveau")'
                        class="inline-flex items-center gap-2 rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white shadow-[0_10px_20px_rgba(91,77,245,0.25)] transition hover:brightness-95">
                    <i class="fas fa-plus text-sm"></i>
                    <span class="hidden sm:block">Nouveau partenaire</span>
                </button>
            </div>

            <section class="mb-6 flex flex-col gap-4 md:flex-row md:items-center">
                <div class="flex-1 rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-black/5">
                    <div class="relative">
                        <i class="fas fa-search absolute left-0 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" placeholder="Rechercher un partenaire..."
                               @bind="searchQuery" @bind:event="oninput"
                               class="w-full border-0 bg-transparent pl-7 text-sm text-gray-900 outline-none placeholder:text-gray-400" />
                    </div>
                </div>

                <select @bind="selectedStatus" class="cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition hover:border-gray-300">
                    <option value="">Tous les statuts</option>
                    <option value="true">Actif</option>
                    <option value="false">Inactif</option>
                </select>
            </section>

            <div class="mb-6 hidden md:block">
                <ViewToggle @bind-IsListView="isListView" />
            </div>

            @if (isListView)
            {
                <PartnerTable Partners="pagedPartners" OnChanged="LoadPartnersAsync" />
            }
            else
            {
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-5 lg:gap-6">
                    @foreach (var partner in pagedPartners)
                    {
                        <AdminPartnerCard @key="partner.Id" Partner="partner" OnChanged="LoadPartnersAsync" />
                    }
                </div>
            }

            <div class="mt-6">
                <Paginated @bind-CurrentPage="currentPage" TotalPages="@totalPages" />
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isListView = false;
    private bool responsiveViewApplied;
    private string searchQueryValue = string.Empty;
    private string selectedStatusValue = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private List<PartnerResponse> allPartners = new();

    private string searchQuery
    {
        get => searchQueryValue;
        set
        {
            if (searchQueryValue == value) return;
            searchQueryValue = value;
            currentPage = 1;
        }
    }

    private string selectedStatus
    {
        get => selectedStatusValue;
        set
        {
            if (selectedStatusValue == value) return;
            selectedStatusValue = value;
            currentPage = 1;
        }
    }

    private List<PartnerResponse> filteredPartners => allPartners
        .Where(p => string.IsNullOrEmpty(searchQuery) ||
                    p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(selectedStatus) ||
                    p.IsActive.ToString() == selectedStatus)
        .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredPartners.Count / pageSize));

    private List<PartnerResponse> pagedPartners => filteredPartners
        .Skip((SafeCurrentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int SafeCurrentPage => Math.Clamp(currentPage, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadPartnersAsync();
    }

    private async Task LoadPartnersAsync()
    {
        isLoading = true;
        try
        {
            allPartners = await PartnerService.GetAllAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || responsiveViewApplied)
        {
            return;
        }

        responsiveViewApplied = true;
        var isMobile = await JS.InvokeAsync<bool>("dotnetNigerIsMobile");
        var shouldShowListView = !isMobile;

        if (isListView != shouldShowListView)
        {
            isListView = shouldShowListView;
            StateHasChanged();
        }
    }
}