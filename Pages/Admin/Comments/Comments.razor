@page "/admin/comments"
@using DotnetNiger.UI.Components.Admin.Cards
@inject ICommentService CommentService
@inject IToastService ToastService
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <Skeleton Type="SkeletonType.Title" Class="w-48" />
                    <Skeleton Type="SkeletonType.Text" Lines="1" Class="w-64" />
                </div>
            </div>
            <div class="mb-6 flex flex-wrap gap-3">
                <Skeleton Type="SkeletonType.Button" Width="100px" />
                <Skeleton Type="SkeletonType.Button" Width="120px" />
                <Skeleton Type="SkeletonType.Button" Width="120px" />
                <Skeleton Type="SkeletonType.Button" Width="100px" />
            </div>
            <div class="overflow-hidden rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Auteur</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Contenu</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Type</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Date</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Statut</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @for (int i = 0; i < 4; i++)
                            {
                                <tr>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Custom" Class="h-8 w-32" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Text" Lines="2" Class="w-48" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Badge" Width="80px" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Text" Lines="1" Class="w-24" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Badge" Width="80px" /></td>
                                    <td class="px-6 py-4"><Skeleton Type="SkeletonType.Button" Width="32px" Class="h-8" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="min-h-screen px-4 py-6 md:px-8 md:py-8">
        <div class="mx-auto max-w-7xl">
            <div class="mb-8 flex items-center justify-between gap-4">
                <section>
                    <AdminBreadcrumb />
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-body md:text-base">Modérez les commentaires des articles et événements.</p>
                </section>
            </div>

            <section class="mb-6 flex flex-wrap items-center gap-3">
                <div class="flex flex-wrap gap-2">
                    <button @onclick='() => SetFilter("all")'
                            class="rounded-lg px-4 py-2 text-sm font-medium transition @(statusFilter == "all" ? "bg-black text-white" : "bg-white text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50")">
                        Tous (@allComments.Count)
                    </button>
                    <button @onclick='() => SetFilter("pending")'
                            class="rounded-lg px-4 py-2 text-sm font-medium transition @(statusFilter == "pending" ? "bg-amber-500 text-white" : "bg-white text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50")">
                        En attente (@pendingCount)
                    </button>
                    <button @onclick='() => SetFilter("approved")'
                            class="rounded-lg px-4 py-2 text-sm font-medium transition @(statusFilter == "approved" ? "bg-green-600 text-white" : "bg-white text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50")">
                        Approuvés (@approvedCount)
                    </button>
                    <button @onclick='() => SetFilter("rejected")'
                            class="rounded-lg px-4 py-2 text-sm font-medium transition @(statusFilter == "rejected" ? "bg-red-600 text-white" : "bg-white text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50")">
                        Rejetés (@rejectedCount)
                    </button>
                </div>

                <div class="flex-1 min-w-0">
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" placeholder="Rechercher un commentaire..."
                               @bind="searchQuery" @bind:event="oninput"
                               class="w-full rounded-lg border border-gray-200 bg-white py-2.5 pl-9 pr-4 text-sm text-title outline-none placeholder:text-gray-400" />
                    </div>
                </div>

                <select @bind="typeFilter"
                        class="cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-title shadow-sm outline-none transition hover:border-gray-300">
                    <option value="">Type</option>
                    <option value="post">Articles</option>
                    <option value="event">Événements</option>
                </select>
            </section>

            <div class="overflow-hidden rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Auteur</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Contenu</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Type</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Cible</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Date</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Statut</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @if (filteredComments.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="px-6 py-10 text-center text-sm text-gray-500">Aucun commentaire trouvé.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var comment in filteredComments)
                                {
                                    <tr @key="comment.Id" class="transition hover:bg-gray-50/80">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="h-8 w-8 flex-shrink-0 overflow-hidden rounded-full bg-gray-100">
                                                    @if (!string.IsNullOrWhiteSpace(comment.AuthorAvatar))
                                                    {
                                                        <ResolvedImage Src="@comment.AuthorAvatar" alt="@comment.AuthorName" class="h-full w-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="flex h-full w-full items-center justify-center text-xs font-semibold text-gray-500">
                                                            @comment.AuthorName[..1].ToUpperInvariant()
                                                        </div>
                                                    }
                                                </div>
                                                <span class="text-sm font-medium text-title">@comment.AuthorName</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-body max-w-xs truncate">@Truncate(comment.Content, 150)</td>
                                        <td class="px-6 py-4 text-sm">
                                            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(comment.PostId != Guid.Empty ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                                                @(comment.PostId != Guid.Empty ? "Article" : "Événement")
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-body max-w-[200px] truncate">
                                            @GetTargetTitle(comment)
                                        </td>
                                        <td class="px-6 py-4 text-sm text-body">@comment.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td class="px-6 py-4 text-sm">
                                            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @GetStatusClass(comment.Status)">
                                                @GetStatusLabel(comment.Status)
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-sm">
                                            <div class="flex items-center gap-2">
                                                @if (comment.Status == "pending")
                                                {
                                                    <button @onclick="() => ApproveComment(comment.Id)"
                                                            class="rounded-lg p-2 text-green-600 transition hover:bg-green-50"
                                                            title="Approuver">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button @onclick="() => RejectComment(comment.Id)"
                                                            class="rounded-lg p-2 text-red-600 transition hover:bg-red-50"
                                                            title="Rejeter">
                                                        <i class="fas fa-xmark"></i>
                                                    </button>
                                                }
                                                <button @onclick="() => DeleteComment(comment.Id)"
                                                        class="rounded-lg p-2 text-gray-500 transition hover:bg-gray-100"
                                                        title="Supprimer">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-6">
                <Paginated @bind-CurrentPage="currentPage" TotalPages="@totalPages" />
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<CommentResponse> allComments = new();
    private string statusFilter = "all";
    private string typeFilter = "";
    private string searchQueryValue = "";
    private int currentPage = 1;
    private int pageSize = 10;

    private int pendingCount => allComments.Count(c => c.Status == "pending");
    private int approvedCount => allComments.Count(c => c.Status == "approved");
    private int rejectedCount => allComments.Count(c => c.Status == "rejected");

    private string searchQuery
    {
        get => searchQueryValue;
        set
        {
            if (searchQueryValue == value) return;
            searchQueryValue = value;
            currentPage = 1;
        }
    }

    private List<CommentResponse> filteredComments => allComments
        .Where(c => statusFilter == "all" || c.Status == statusFilter)
        .Where(c => string.IsNullOrEmpty(typeFilter) ||
                    (typeFilter == "post" && c.PostId != Guid.Empty) ||
                    (typeFilter == "event" && c.EventId != Guid.Empty))
        .Where(c => string.IsNullOrEmpty(searchQuery) ||
                    c.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.AuthorName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredComments.Count / pageSize));

    private List<CommentResponse> pagedComments => filteredComments
        .Skip((SafeCurrentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int SafeCurrentPage => Math.Clamp(currentPage, 1, totalPages);

    protected override async Task OnInitializedAsync()
    {
        await LoadCommentsAsync();
    }

    private async Task LoadCommentsAsync()
    {
        isLoading = true;
        try
        {
            allComments = await CommentService.GetAllCommentsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        statusFilter = filter;
        currentPage = 1;
    }

    private async Task ApproveComment(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Approuver ce commentaire ?");
        if (!confirmed) return;

        var updated = await CommentService.UpdateCommentAsync(new UpdateCommentRequest { Id = id, Content = null });
        if (updated is not null)
        {
            var comment = allComments.FirstOrDefault(c => c.Id == id);
            if (comment is not null) comment.Status = "approved";
            ToastService.ShowToast("Commentaire approuvé.", ToastLevel.Success);
        }
        else
        {
            ToastService.ShowToast("Erreur lors de l'approbation.", ToastLevel.Error);
        }
    }

    private async Task RejectComment(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Rejeter ce commentaire ?");
        if (!confirmed) return;

        var comment = allComments.FirstOrDefault(c => c.Id == id);
        if (comment is not null) comment.Status = "rejected";
        ToastService.ShowToast("Commentaire rejeté.", ToastLevel.Success);
    }

    private async Task DeleteComment(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Supprimer ce commentaire ?");
        if (!confirmed) return;

        var deleted = await CommentService.DeleteCommentAsync(new DeleteCommentRequest { Id = id, DeleteAllReplies = true });
        if (deleted)
        {
            allComments.RemoveAll(c => c.Id == id || c.ParentCommentId == id);
            ToastService.ShowToast("Commentaire supprimé.", ToastLevel.Success);
        }
        else
        {
            ToastService.ShowToast("Erreur lors de la suppression.", ToastLevel.Error);
        }
    }

    private static string Truncate(string value, int maxLength)
        => value?.Length > maxLength ? value[..maxLength] + "..." : value ?? "";

    private static string GetStatusClass(string status) => status switch
    {
        "pending" => "bg-amber-100 text-amber-700",
        "approved" => "bg-success-bg text-success",
        "rejected" => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "pending" => "En attente",
        "approved" => "Approuvé",
        "rejected" => "Rejeté",
        _ => status
    };

    private static string GetTargetTitle(CommentResponse comment)
    {
        if (!string.IsNullOrWhiteSpace(comment.PostTitle))
            return comment.PostTitle;
        if (!string.IsNullOrWhiteSpace(comment.EventTitle))
            return comment.EventTitle;
        return "—";
    }
}
