<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotnetNiger.Application\DotnetNiger.Application.csproj" />
  </ItemGroup>

  <!--
    Identity et l'authentification par cookie appartiennent au cadre ASP.NET Core. La
    référence au cadre partagé donne accès aux contrats d'authentification et à
    IHttpContextAccessor, sans embarquer le moteur web lui-même.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <!--
    MimeKit, pour MailKit, épingle exactement System.Security.Cryptography.Pkcs 10.0.0,
    version visée par deux avis de sécurité. Relever cette version ne suffit pas : le
    verrou tient tant que personne ne demande le paquet directement.

    Cette référence directe est donc volontaire. NuGet retient la version la plus haute
    demandée, et 10.0.13 est la première corrigée. Elle peut disparaître le jour où MimeKit
    déclarera lui-même cette version — il suffit alors de la retirer.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
