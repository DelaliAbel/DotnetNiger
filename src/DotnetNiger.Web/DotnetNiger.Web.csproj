<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DotnetNiger.Application\DotnetNiger.Application.csproj" />
    <ProjectReference Include="..\DotnetNiger.Infrastructure\DotnetNiger.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Permet aux tests de joindre les aides d'affichage internes au Web — le choix d'icône d'un
    lien, notamment. Elles n'ont pas à devenir publiques pour être couvertes.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DotnetNiger.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Permet de sortir les secrets du dépôt en développement. Ces valeurs restent sur la
      machine du développeur et ne sont jamais versionnées.
    -->
    <UserSecretsId>dotnetniger-web-local</UserSecretsId>
  </PropertyGroup>

  <!--
    Compilation Tailwind.

    `wwwroot/css/app.css` produit à partir de `wwwroot/css/design/theme.css` est versionné.
    C'est une exception à l'usage, et elle est délibérée : l'hébergeur de production bloque
    npm par politique de groupe, et la compilation du projet y échouerait. Sans ce fichier
    versionné, le site se publierait sans aucune feuille de style.

    Conséquence : recompiler le CSS fait partie du travail sur le thème, et le résultat se
    commite. Une modification de theme.css sans `npm run css:minify` ne se voit pas.

    Sur un poste qui a Node, les cibles ci-dessous compilent le CSS avant le build. Sur un
    poste qui n'en a pas — le serveur de publication — elles sont court-circuitées, et le
    CSS versionné est publié tel quel. Si ce CSS manque et que Node est indisponible, la
    compilation échoue : publier un site sans style doit se voir, pas se découvrir ensuite.
  -->
  <PropertyGroup>
    <TailwindRoot>$(MSBuildThisFileDirectory)../../</TailwindRoot>
    <TailwindEnabled Condition="'$(TailwindEnabled)' == ''">true</TailwindEnabled>
    <TailwindOutput>$(MSBuildThisFileDirectory)wwwroot/css/app.css</TailwindOutput>
    <TailwindAvailable Condition="'$(TailwindEnabled)' == 'true' And Exists('$(TailwindRoot)node_modules')">true</TailwindAvailable>
  </PropertyGroup>

  <!-- Sans Node, le thème est publié tel qu'il est versionné. -->
  <Target Name="TailwindSansNode"
          Condition="'$(TailwindAvailable)' != 'true' And Exists('$(TailwindOutput)')"
          BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Node absent : le thème est publié depuis le CSS versionné." />
  </Target>

  <!-- Sans Node et sans CSS versionné, il n'y a rien à publier : mieux vaut échouer ici. -->
  <Target Name="TailwindAbsent"
          Condition="'$(TailwindAvailable)' != 'true' And !Exists('$(TailwindOutput)')"
          BeforeTargets="BeforeBuild">
    <Error Text="Le thème compilé est absent de $(TailwindOutput) et Node est indisponible. Exécuter 'npm ci' puis 'npm run css:minify', et recommencer." />
  </Target>

  <Target Name="TailwindInstall" Condition="'$(TailwindAvailable)' == 'true'">
    <Message Importance="high" Text="Installation des dépendances Tailwind (npm ci)..." />
    <Exec Command="npm ci" WorkingDirectory="$(TailwindRoot)" Condition="!Exists('$(TailwindRoot)node_modules')" />
  </Target>

  <Target Name="TailwindBuildCss"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="TailwindInstall"
          Condition="'$(TailwindAvailable)' == 'true'">
    <Exec Command="npm run css:minify" WorkingDirectory="$(TailwindRoot)" />
  </Target>

</Project>