<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DotnetNiger.Application\DotnetNiger.Application.csproj" />
    <ProjectReference Include="..\DotnetNiger.Infrastructure\DotnetNiger.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Permet de sortir les secrets du dépôt en développement, notamment le mot de passe
      du compte administrateur initial décrit dans docs/DECISIONS.md. Ces valeurs restent
      sur la machine du développeur et ne sont jamais versionnées.
    -->
    <UserSecretsId>dotnetniger-web-local</UserSecretsId>
  </PropertyGroup>

  <!--
    Compilation Tailwind.

    Le CSS produit à partir de `wwwroot/css/design/theme.css` n'est pas versionné : il est
    régénéré à chaque build, ce qui garantit qu'il corresponde toujours au thème. Node et
    npm sont donc requis pour compiler ce projet.

    Pour travailler sur le thème en boucle :
        npm run css:watch

    Pour compiler sans Node (par exemple une image de build ne disposant que du SDK .NET) :
        dotnet build -p:TailwindEnabled=false
  -->
  <PropertyGroup>
    <TailwindRoot>$(MSBuildThisFileDirectory)../../</TailwindRoot>
    <TailwindEnabled Condition="'$(TailwindEnabled)' == ''">true</TailwindEnabled>
    <TailwindOutput>$(MSBuildThisFileDirectory)wwwroot/css/app.css</TailwindOutput>
  </PropertyGroup>

  <Target Name="TailwindInstall" Condition="'$(TailwindEnabled)' == 'true' And Exists('$(TailwindRoot)package.json') And !Exists('$(TailwindRoot)node_modules')">
    <Message Importance="high" Text="Installation des dépendances Tailwind (npm ci)..." />
    <Exec Command="npm ci" WorkingDirectory="$(TailwindRoot)" />
  </Target>

  <Target Name="TailwindBuildCss" BeforeTargets="BeforeBuild" DependsOnTargets="TailwindInstall" Condition="'$(TailwindEnabled)' == 'true' And Exists('$(TailwindRoot)package.json')">
    <Exec Command="npm run css:minify" WorkingDirectory="$(TailwindRoot)" />
  </Target>

</Project>
