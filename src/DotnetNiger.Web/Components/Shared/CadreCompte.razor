@namespace DotnetNiger.Web.Components.Shared

<section class="compte">
    <div class="compte__carte">
        <header class="compte__entete">
            <p class="eyebrow">@SurTitre</p>
            <h1 class="text-section font-extrabold tracking-tight">@Titre</h1>
            @if (!string.IsNullOrWhiteSpace(Lead))
            {
                <p class="text-sm text-ink-600 dark:text-ink-300">@Lead</p>
            }
        </header>
        @ChildContent
    </div>
</section>

@code {
    /// <summary>Sur-titre affiché au-dessus du titre du formulaire.</summary>
    [Parameter] public string SurTitre { get; set; } = "Espace membre";

    /// <summary>Titre du formulaire.</summary>
    [Parameter] public required string Titre { get; set; }

    /// <summary>Phrase d'introduction sous le titre ; masquée si vide.</summary>
    [Parameter] public string? Lead { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
