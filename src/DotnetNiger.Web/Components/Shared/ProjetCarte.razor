@* Carte de présentation d'un projet open source porté par la communauté. *@

<article class="card card--hover">
    <div class="card__body">
        <h3 class="card__title flex items-center gap-1 text-base">
            <DnIcon Name="github" Size="18" /> @Projet.Nom
        </h3>
        <p class="card__text">@Projet.Description</p>
        <p class="card__meta">
            @foreach (var technologie in Projet.Technologies)
            {
                <span class="badge badge--outline">@technologie</span>
            }
        </p>
        @* Ni étoiles ni contributeurs : ces chiffres viennent de GitHub et ne sont pas
           dans la base. Les afficher demanderait une lecture de l'API GitHub, et le
           dépôt linked ci-dessous montre l'activité réelle à jour. *@
        <a class="link" href="@Projet.Lien" target="_blank" rel="noopener">
            Voir le dépôt <DnIcon Name="external-link" Size="14" />
        </a>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ProjetVue Projet { get; set; } = default!;
}
