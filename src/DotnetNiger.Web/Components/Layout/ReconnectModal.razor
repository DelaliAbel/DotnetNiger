<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Les messages restent en français comme le reste du site. Les classes
   `components-reconnect-*-visible` ne sont visibles que dans l'état
   correspondant : voir ReconnectModal.razor.css. *@
<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Connexion au serveur en cours…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Nouvelle tentative dans <span id="components-seconds-to-next-attempt"></span> secondes…
        </p>
        <p class="components-reconnect-failed-visible">
            La reconnexion a échoué. Rechargez la page pour reprendre.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible" type="button">
            Réessayer
        </button>
        <p class="components-pause-visible">
            La session a été mise en pause par le serveur.
        </p>
        <p class="components-resume-failed-visible">
            La reprise de la session a échoué. Rechargez la page pour reprendre.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible" type="button">
            Reprendre la session
        </button>
    </div>
</dialog>
