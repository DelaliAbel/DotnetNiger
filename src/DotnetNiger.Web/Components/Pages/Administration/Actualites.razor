@attribute [Authorize(Roles = DotnetNiger.Application.Common.RoleNames.Admin)]

@page "/administration/actualites"
@layout DotnetNiger.Web.Components.Layout.AdministrationLayout
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using DotnetNiger.Application.Abstractions.Persistence
@using DotnetNiger.Application.Common
@using DotnetNiger.Domain.Entities.Content
@using DotnetNiger.Domain.Enums
@using DotnetNiger.Infrastructure.Identity
@using DotnetNiger.Web.Controller.Contracts
@inject IUnitOfWork UniteDeTravail

<PageTitle>Actualités - Administration</PageTitle>

<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-section font-semibold">Actualités</h1>
        <p class="text-sm text-ink-600">
            Ce que l'administration voit, tous états confondus, de la dernière modification à la
            plus ancienne. Publier envoie la lettre d'information aux abonnés confirmés.
        </p>
    </div>

    <a class="rounded-sm bg-violet-500 px-4 py-2 text-sm text-white hover:bg-violet-600"
       href="/administration/actualites/nouvelle">Rédiger une actualité</a>
</header>

@if (_confirmation is not null)
{
    <p class="mb-4 rounded-sm bg-vert-100 px-4 py-3 text-sm text-vert-700">@_confirmation</p>
}
else if (_erreur is not null)
{
    <p class="mb-4 rounded-sm bg-orange-100 px-4 py-3 text-sm text-orange-700">@_erreur</p>
}

<nav class="mb-6 flex flex-wrap gap-2" aria-label="Filtrer les actualités">
    <a class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-sm hover:bg-ink-50"
       href="/administration/actualites">Toutes</a>
    <a class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-sm hover:bg-ink-50"
       href="/administration/actualites?statut=Draft">Brouillons</a>
    <a class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-sm hover:bg-ink-50"
       href="/administration/actualites?statut=Published">Publiées</a>
    <a class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-sm hover:bg-ink-50"
       href="/administration/actualites?statut=Archived">Archivées</a>
</nav>

@if (_page.TotalCount == 0)
{
    <p class="rounded-md border border-ink-200 bg-white px-4 py-8 text-center text-ink-500">
        Aucune actualité à afficher.
    </p>
}
else
{
    <ul class="flex flex-col gap-3">
        @foreach (var article in _page.Items)
        {
            <li class="rounded-md border border-ink-200 bg-white p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h2 class="text-lead font-semibold">@article.Title</h2>
                        <p class="text-caption text-ink-500">
                            @Categorie(article.Category) — @article.Author
                            @if (article.PublishedAtUtc is { } publie)
                            {
                                <text> — publié le @publie.ToString("d MMMM yyyy", Culture)</text>
                            }
                        </p>
                    </div>

                    <span class="rounded-full px-3 py-1 text-caption @EtatClasse(article.Status)">
                        @Etat(article.Status)
                    </span>
                </div>

                <p class="mt-2 text-sm text-ink-600">@article.Excerpt</p>

                <div class="mt-4 flex flex-wrap items-center gap-2">
                    @if (article.Status != PublicationStatus.Published)
                    {
                        <a class="rounded-sm border border-ink-300 px-3 py-1 text-sm hover:bg-ink-50"
                           href="/administration/actualites/@article.Id">Modifier</a>

                        <form method="post" action="/administration/actualites/@article.Id/publier">
                            <AntiforgeryToken />
                            <button class="rounded-sm border border-vert-500 px-3 py-1 text-sm text-vert-600 hover:bg-vert-50"
                                    type="submit">
                                Publier
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-caption text-ink-400">
                            Un article publié se modifie sur le site public, pas ici.
                        </span>
                    }

                    @if (article.Status == PublicationStatus.Published)
                    {
                        <form method="post" action="/administration/actualites/@article.Id/archiver">
                            <AntiforgeryToken />
                            <button class="rounded-sm border border-ink-300 px-3 py-1 text-sm hover:bg-ink-50"
                                    type="submit">
                                Archiver
                            </button>
                        </form>
                    }

                    @if (article.Status == PublicationStatus.Archived)
                    {
                        <form method="post" action="/administration/actualites/@article.Id/brouillon">
                            <AntiforgeryToken />
                            <button class="rounded-sm border border-ink-300 px-3 py-1 text-sm hover:bg-ink-50"
                                    type="submit">
                                Remettre en brouillon
                            </button>
                        </form>
                    }

                    <form method="post" action="/administration/actualites/@article.Id/retirer">
                        <AntiforgeryToken />
                        <button class="rounded-sm border border-ink-300 px-3 py-1 text-sm hover:bg-ink-50"
                                type="submit">
                            Retirer
                        </button>
                    </form>
                </div>
            </li>
        }
    </ul>

    <Pager PageNumber="_page.Page" TotalPages="_page.TotalPages" TotalCount="_page.TotalCount"
           Base="/administration/actualites" Query="@_query" />
}

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("fr-FR");

    private PageResponse<AdminArticleSummaryResponse> _page = new([], 1, 20, 0, 0, false);
    private string? _query;
    private string? _confirmation;
    private string? _erreur;

    /// <summary>État à filtrer, ou <see langword="null"/> pour tous.</summary>
    [SupplyParameterFromQuery(Name = "statut")]
    public string? Statut { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "publie")]
    public int Publie { get; set; }

    [SupplyParameterFromQuery(Name = "archive")]
    public bool Archive { get; set; }

    [SupplyParameterFromQuery(Name = "brouillon")]
    public bool Brouillon { get; set; }

    [SupplyParameterFromQuery(Name = "retire")]
    public bool Retire { get; set; }

    [SupplyParameterFromQuery(Name = "erreur")]
    public string? Erreur { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var filtre = Enum.TryParse<PublicationStatus>(Statut, ignoreCase: true, out var etat) ? etat : (PublicationStatus?)null;

        _query = filtre is null ? null : $"statut={filtre.Value}";

        _confirmation = (Publie, Archive, Brouillon, Retire) switch
        {
            (1, _, _, _) => "Actualité publiée : la lettre d'information part vers les abonnés confirmés.",
            (_, true, _, _) => "Actualité archivée : elle a disparu du site.",
            (_, _, true, _) => "Actualité remise en brouillon.",
            (_, _, _, true) => "Actualité retirée.",
            _ => null,
        };

        _erreur = Erreur switch
        {
            "actualite-introuvable" => "Cette actualité n'existe plus.",
            "deja-publie" => "Elle est déjà publiée. Republicer enverrait la lettre une seconde fois.",
            _ => null,
        };

        var requete = UniteDeTravail.ReadRepository<Article>().Query;

        if (filtre is { } valeur)
        {
            requete = requete.Where(article => article.Status == valeur);
        }

        requete = requete
            .OrderByDescending(article => article.UpdatedAtUtc ?? article.CreatedAtUtc)
            .ThenBy(article => article.Title);

        var demande = new PageRequest(Page ?? 1, PageRequest.DefaultPageSize);
        var total = await requete.CountAsync();

        var items = await requete
            .Skip(demande.Skip)
            .Take(demande.PageSize)
            .ToListAsync();

        var ids = items.Select(article => article.AuthorId).Distinct().ToArray();

        var noms = ids.Length == 0
            ? []
            : await UniteDeTravail.ReadRepository<ApplicationUser>().Query
                .Where(user => ids.Contains(user.Id))
                .ToDictionaryAsync(user => user.Id, user => user.FullName);

        _page = ApiProjections.ToPage(
            new PagedResult<Article>(items, demande.PageNumber, demande.PageSize, total),
            article => ApiProjections.ToAdminSummary(
                article,
                noms.GetValueOrDefault(article.AuthorId, string.Empty)));
    }

    private static string Etat(PublicationStatus statut) => statut switch
    {
        PublicationStatus.Published => "Publiée",
        PublicationStatus.Draft => "Brouillon",
        _ => "Archivée",
    };

    private static string EtatClasse(PublicationStatus statut) => statut switch
    {
        PublicationStatus.Published => "bg-vert-100 text-vert-700",
        PublicationStatus.Draft => "bg-orange-100 text-orange-700",
        _ => "bg-ink-100 text-ink-600",
    };

    private static string Categorie(ArticleCategory categorie) => categorie switch
    {
        ArticleCategory.LocalProjects => "Projets locaux",
        ArticleCategory.Interview => "Entretien",
        _ => "Actualités .NET",
    };
}
