@page "/administration/signalements"
@layout DotnetNiger.Web.Components.Layout.AdministrationLayout
@rendermode InteractiveServer

@using System.Text.Json
@using DotnetNiger.Domain.Enums
@using DotnetNiger.Web.Services.Administration

@attribute [Authorize(Roles = DotnetNiger.Application.Common.RoleNames.Admin)]

@inject ServiceSignalements Service
@inject IJSRuntime JS

@*
    File de modération : ce que les membres ont signalé, du plus ancien au plus récent.

    Un signalement ne porte qu'un identifiant — jamais le contenu signalé. Cette page va donc
    le chercher à la lecture pour que le modérateur puisse décider sans quitter l'écran :
    c'est tout l'intérêt d'une file de modération.

    Clôturer n'est pas réversible : la conclusion d'un signalement fait partie de son
    historique. Quand le signalement est justifié et que la cible est un commentaire,
    masquer le commentaire est proposé — sans être fait d'office, l'inversion étant
    possible tant que le modérateur n'a pas décidé.
*@

<PageTitle>Signalements — Administration</PageTitle>

<header class="admin-entete">
    <div>
        <h1 class="admin-entete__titre">Signalements</h1>
        <p class="admin-entete__intro">
            Les contenus signalés par les membres. Les signalements justifiés sont clos avec
            la sanction appliquée ; les autres sont écartés.
        </p>
    </div>
</header>

@if (_donnees is null)
{
    <Chargement />
}
else
{
    <div class="admin-bandeau">
        <div class="admin-bandeau__champ">
            <label class="admin-bandeau__libelle" for="signalement-etat">État</label>
            <div class="select">
                <select id="signalement-etat" @bind="_filtreEtat">
                    <option value="">Tous</option>
                    <option value="@nameof(ReportStatus.Open)">Ouverts</option>
                    <option value="@nameof(ReportStatus.UnderReview)">En cours</option>
                    <option value="@nameof(ReportStatus.Resolved)">Justifiés</option>
                    <option value="@nameof(ReportStatus.Dismissed)">Écartés</option>
                </select>
                <span class="select__chevron"><DnIcon Name="chevron-down" Size="14" /></span>
            </div>
        </div>

        <div class="admin-bandeau__champ">
            <label class="admin-bandeau__libelle" for="signalement-attente">File</label>
            <div class="admin-case admin-case--seule">
                <input type="checkbox" id="signalement-attente" @bind="_seulementAttente" />
                Seulement ceux qui attendent
            </div>
        </div>

        <span class="admin-bandeau__compte">
            @Liste.Count signalement(s) — @Attente.Count en attente
        </span>
    </div>

    @if (Liste.Count is 0)
    {
        <p class="admin-formulaire__aide">Aucun signalement ne correspond à ces filtres.</p>
    }
    else
    {
        <div class="admin-moderation">
            @foreach (var ligne in Liste)
            {
                <article class="admin-moderation__ligne @EtatClasse(ligne.Statut)">
                    <div class="admin-moderation__entete">
                        <div>
                            <span class="badge @EtiquetteMotif(ligne.Motif)">@Motif(ligne.Motif)</span>
                            <strong class="admin-moderation__auteur">@ligne.Rapporteur</strong>
                            <span class="admin-tableau__note">il y a @Delai(ligne.DeposeLe)</span>
                        </div>

                        <span class="badge @Etiquette(ligne.Statut)">@Etat(ligne.Statut)</span>
                    </div>

                    <div class="admin-moderation__cible">
                        <DnIcon Name="@Icone(ligne.Type)" Size="14" />
                        <span>@TypeCible(ligne.Type)</span>
                        @if (!string.IsNullOrWhiteSpace(ligne.Cible.Lien))
                        {
                            <a href="@ligne.Cible.Lien" target="_blank" rel="noopener">
                                @ligne.Cible.Titre
                                <DnIcon Name="external-link" Size="12" />
                            </a>
                        }
                        else
                        {
                            <span>@ligne.Cible.Titre</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ligne.Cible.Extrait))
                    {
                        <blockquote class="admin-moderation__texte">@ligne.Cible.Extrait</blockquote>
                    }

                    @if (!string.IsNullOrWhiteSpace(ligne.Details))
                    {
                        <p class="admin-moderation__details">
                            <strong>Précisions du membre :</strong> @ligne.Details
                        </p>
                    }

                    @if (ligne.Statut is ReportStatus.Resolved or ReportStatus.Dismissed)
                    {
                        <p class="admin-formulaire__aide">
                            Clôturé @Delai(ligne.ClotureLe!.Value) par @ligne.TraitePar.
                            @if (!string.IsNullOrWhiteSpace(ligne.Conclusion))
                            {
                                <text> Conclusion : @ligne.Conclusion.</text>
                            }
                        </p>
                    }
                    else
                    {
                        <div class="admin-moderation__actions">
                            @if (ligne.Type == ReportTargetType.Comment)
                            {
                                @* Justifier un signalement, c'est le plus souvent écarter le
                                   commentaire. Le proposer ici évite d'aller le chercher. *@
                                <button type="button" class="btn btn--rouge btn--sm"
                                        @onclick="() => MasquerCible(ligne)">
                                    <DnIcon Name="eye-off" Size="14" />
                                    Masquer le commentaire
                                </button>
                            }

                            <button type="button" class="btn btn--primary btn--sm"
                                    @onclick="() => Cloturer(ligne, true)">
                                <DnIcon Name="check" Size="14" />
                                Justifié
                            </button>

                            <button type="button" class="btn btn--sm" @onclick="() => Cloturer(ligne, false)">
                                <DnIcon Name="x" Size="14" />
                                Infondé
                            </button>
                        </div>
                    }
                </article>
            }
        </div>
    }
}

<div class="admin-toasts" role="status" aria-live="polite">
    @foreach (var message in _messages)
    {
        <div class="admin-toast admin-toast--@(message.Reussi ? "succes" : "erreur")">
            <DnIcon Name="@(message.Reussi ? "check" : "alert")" Size="16" />
            <span>@message.Texte</span>
        </div>
    }
</div>

@code {
    private SignalementsVue? _donnees;

    private string _filtreEtat = string.Empty;

    private bool _seulementAttente;

    private readonly List<Annonce> _messages = [];

    /// <summary>Signalements qui passent les filtres de la barre.</summary>
    private List<LigneSignalementAdmin> Liste =>
    [
        .. (_donnees?.Signalements ?? [])
            .Where(ligne => string.IsNullOrWhiteSpace(_filtreEtat)
                || string.Equals(ligne.Statut.ToString(), _filtreEtat, StringComparison.Ordinal))
            .Where(ligne => !_seulementAttente || EstOuvert(ligne.Statut))
    ];

    /// <summary>Ce qui attend une décision : un signalement non clôturé.</summary>
    private List<LigneSignalementAdmin> Attente =>
        [.. (_donnees?.Signalements ?? []).Where(ligne => EstOuvert(ligne.Statut))];

    /// <summary>Un signalement reste ouvert tant qu'il n'a pas été clôturé.</summary>
    /// <param name="statut">État de traitement.</param>
    /// <returns><see langword="true"/> si le signalement attend une décision.</returns>
    private static bool EstOuvert(ReportStatus statut)
        => statut is ReportStatus.Open or ReportStatus.UnderReview;

    protected override async Task OnInitializedAsync() => _donnees = await Service.LireAsync();

    /// <summary>Clôt un signalement, comme justifié ou comme infondé.</summary>
    /// <param name="ligne">Signalement concerné.</param>
    /// <param name="justifie">Vrai pour clore comme justifié, faux pour écarter.</param>
    private async Task Cloturer(LigneSignalementAdmin ligne, bool justifie)
    {
        var reponse = await Ecrire(
            "POST",
            $"/api/reports/{ligne.Id}/{(justifie ? "resolve" : "dismiss")}",
            null);

        if (!reponse.Ok)
        {
            await Previent(Raison(reponse), false);
            return;
        }

        Service.Oublie();
        _donnees = await Service.LireAsync();

        await Previent(justifie ? "Signalement clos comme justifié." : "Signalement écarté.", true);
    }

    /// <summary>Masque le commentaire visé par un signalement.</summary>
    /// <param name="ligne">Signalement concerné.</param>
    private async Task MasquerCible(LigneSignalementAdmin ligne)
    {
        var reponse = await Ecrire("POST", $"/api/comments/{ligne.CibleId}/hide", null);

        if (!reponse.Ok)
        {
            await Previent(Raison(reponse), false);
            return;
        }

        await Previent("Commentaire masqué. Clôturez maintenant le signalement comme justifié.", true);
    }

    /// <summary>
    /// Écrit par l'API, après avoir vérifié que le script d'appel est présent.
    /// </summary>
    /// <param name="methode">Verbe de la requête.</param>
    /// <param name="chemin">Adresse de l'API.</param>
    /// <param name="corps">Charge utile, ou <see langword="null"/>.</param>
    /// <returns>La réponse normalisée de l'appel.</returns>
    private async Task<ReponseApi> Ecrire(string methode, string chemin, object? corps)
    {
        await JS.InvokeVoidAsync("DnAdminScripts.assure", true);

        return await JS.InvokeAsync<ReponseApi>("DnApi.envoyer", methode, chemin, corps);
    }

    /// <summary>Affiche un message, puis l'efface.</summary>
    /// <param name="texte">Message à afficher.</param>
    /// <param name="reussi">Vrai pour un succès, faux pour une erreur.</param>
    private async Task Previent(string texte, bool reussi)
    {
        var annonce = new Annonce(texte, reussi);
        _messages.Add(annonce);

        await InvokeAsync(StateHasChanged);

        await Task.Delay(4000);
        _messages.Remove(annonce);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Énonce le temps écoulé, en français, sans dépendre du fuseau de la machine.
    /// </summary>
    /// <param name="instant">Date à compter.</param>
    /// <returns>Une expression comme « 3 h ».</returns>
    private static string Delai(DateTime instant)
    {
        var ecoule = DateTime.UtcNow - instant;

        if (ecoule.TotalMinutes < 1)
        {
            return "quelques instants";
        }

        if (ecoule.TotalHours < 1)
        {
            var minutes = (int)ecoule.TotalMinutes;

            return minutes == 1 ? "1 minute" : $"{minutes} minutes";
        }

        if (ecoule.TotalDays < 1)
        {
            var heures = (int)ecoule.TotalHours;

            return heures == 1 ? "1 heure" : $"{heures} heures";
        }

        var jours = (int)ecoule.TotalDays;

        return jours == 1 ? "1 jour" : $"{jours} jours";
    }

    private static string Etat(ReportStatus statut) => statut switch
    {
        ReportStatus.Open => "Ouvert",
        ReportStatus.UnderReview => "En cours",
        ReportStatus.Resolved => "Justifié",
        _ => "Écarté",
    };

    private static string Etiquette(ReportStatus statut) => statut switch
    {
        ReportStatus.Open => "badge--orange",
        ReportStatus.UnderReview => "badge--orange",
        ReportStatus.Resolved => "badge--vert",
        _ => "badge--ink",
    };

    /// <summary>Classe de ligne, pour distinguer d'un coup d'œil ce qui est clôturé.</summary>
    /// <param name="statut">État de traitement.</param>
    /// <returns>Un modificateur de classe.</returns>
    private static string EtatClasse(ReportStatus statut) => statut switch
    {
        ReportStatus.Open => "admin-moderation__ligne--attente",
        ReportStatus.UnderReview => "admin-moderation__ligne--attente",
        ReportStatus.Resolved => string.Empty,
        _ => "admin-moderation__ligne--masque",
    };

    private static string Motif(ReportReason motif) => motif switch
    {
        ReportReason.Spam => "Indésirable",
        ReportReason.Harassment => "Harcèlement",
        ReportReason.InappropriateContent => "Contenu inapproprié",
        ReportReason.IncorrectInformation => "Information fausse",
        _ => "Autre motif",
    };

    private static string EtiquetteMotif(ReportReason motif) => motif switch
    {
        ReportReason.Spam => "badge--rouge",
        ReportReason.Harassment => "badge--rouge",
        _ => "badge--orange",
    };

    /// <summary>Nom de la nature du contenu signalé.</summary>
    /// <param name="type">Nature de la cible.</param>
    /// <returns>Le nom affiché.</returns>
    private static string TypeCible(ReportTargetType type) => type switch
    {
        ReportTargetType.Article => "Article",
        ReportTargetType.Comment => "Commentaire",
        ReportTargetType.Resource => "Ressource",
        ReportTargetType.CommunityEvent => "Événement",
        ReportTargetType.Project => "Projet",
        _ => "Membre",
    };

    /// <summary>Icône correspondant à la nature du contenu signalé.</summary>
    /// <param name="type">Nature de la cible.</param>
    /// <returns>Le nom d'icône dans la bibliothèque du site.</returns>
    private static string Icone(ReportTargetType type) => type switch
    {
        ReportTargetType.Article => "file-text",
        ReportTargetType.Comment => "message-square",
        ReportTargetType.Resource => "book-open",
        ReportTargetType.CommunityEvent => "calendar",
        ReportTargetType.Project => "code",
        _ => "user",
    };

    /// <summary>Message d'erreur d'une réponse refusée, tel que le serveur l'a formulé.</summary>
    /// <param name="reponse">Réponse de l'appel.</param>
    /// <returns>Un texte compréhensible, jamais un code.</returns>
    private static string Raison(ReponseApi reponse)
        => reponse.Detail
            ?? reponse.Titre
            ?? (reponse.Statut == 0
                ? "Le serveur n'a pas répondu."
                : $"Le serveur a répondu {reponse.Statut}.");

    /// <summary>Un message affiché à l'écran, le temps qu'il soit effacé.</summary>
    /// <param name="Texte">Contenu du message.</param>
    /// <param name="Reussi">Vrai pour un succès, faux pour une erreur.</param>
    private sealed record Annonce(string Texte, bool Reussi);

    /// <summary>Réponse normalisée d'un appel fait par le script d'administration.</summary>
    /// <param name="Ok">Vrai si le serveur a accepté.</param>
    /// <param name="Statut">Code de la réponse.</param>
    /// <param name="Corps">Corps décodé de la réponse.</param>
    private sealed record ReponseApi(bool Ok, int Statut, object? Corps)
    {
        /// <summary>Message d'erreur, au format problem details.</summary>
        public string? Titre => (Corps as JsonElement?)?.TryGetProperty("title", out var titre) == true
            ? titre.GetString()
            : null;

        /// <summary>Précision de l'erreur, quand le serveur en a produit une.</summary>
        public string? Detail => (Corps as JsonElement?)?.TryGetProperty("detail", out var detail) == true
            ? detail.GetString()
            : null;
    }
}