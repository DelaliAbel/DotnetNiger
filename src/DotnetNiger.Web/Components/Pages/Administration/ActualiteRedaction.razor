@attribute [Authorize(Roles = DotnetNiger.Application.Common.RoleNames.Admin)]

@page "/administration/actualites/nouvelle"
@page "/administration/actualites/{Id:guid}"
@layout DotnetNiger.Web.Components.Layout.AdministrationLayout
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using DotnetNiger.Application.Abstractions.Persistence
@using DotnetNiger.Domain.Entities.Content
@using DotnetNiger.Domain.Enums
@inject IUnitOfWork UniteDeTravail

<PageTitle>@(Modification ? "Modifier l'actualité" : "Rédiger une actualités") - Administration</PageTitle>

<header class="mb-6">
    <a class="text-sm text-violet-600 underline" href="/administration/actualites">Retour aux actualités</a>
    <h1 class="text-section font-semibold">@(Modification ? "Modifier l'actualité" : "Rédiger une actualités")</h1>
    @if (Modification && _article is { } existant)
    {
        <p class="text-sm text-ink-600">
            État actuel : <span class="rounded-full bg-ink-100 px-3 py-1 text-caption text-ink-600">@Etat(existant.Status)</span>
        </p>
    }
</header>

@if (_erreur is not null)
{
    <p class="mb-4 rounded-sm bg-orange-100 px-4 py-3 text-sm text-orange-700">@_erreur</p>
}

@if (_introuvable)
{
    <p class="rounded-md border border-ink-200 bg-white px-4 py-8 text-center text-ink-500">
        Cette actualité n'existe pas. <a class="text-violet-600 underline" href="/administration/actualites">Revenir à la liste</a>.
    </p>
}
else if (_article?.Status == PublicationStatus.Published)
{
    <p class="rounded-md border border-ink-200 bg-white px-4 py-8 text-ink-600">
        Cet article est en ligne. Le modifier ici le remettrait hors du site sans prévenir les
        lecteurs : repassez-le en brouillon d'abord, depuis la liste.
    </p>
}
else
{
    <form method="post" action="/administration/actualites/enregistrer" class="flex max-w-3xl flex-col gap-4">
        <AntiforgeryToken />
        <input type="hidden" name="id" value="@Id" />

        <label class="flex flex-col gap-1">
            <span class="text-sm font-medium">Titre</span>
            <input class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-base"
                   type="text" name="Title" maxlength="200" required value="@_article?.Title" />
        </label>

        <label class="flex flex-col gap-1">
            <span class="text-sm font-medium">Chapô</span>
            <span class="text-caption text-ink-500">Le résumé affiché dans les listes et les partages.</span>
            <textarea class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-base"
                      name="Excerpt" rows="2" maxlength="500" required>@_article?.Excerpt</textarea>
        </label>

        <label class="flex flex-col gap-1">
            <span class="text-sm font-medium">Contenu</span>
            <span class="text-caption text-ink-500">HTML autorisé : balises, liens, listes.</span>
            <textarea class="rounded-sm border border-ink-300 bg-white px-3 py-2 font-mono text-sm"
                      name="Content" rows="16" required>@_article?.Content</textarea>
        </label>

        <div class="flex flex-wrap gap-4">
            <label class="flex flex-col gap-1">
                <span class="text-sm font-medium">Rubrique</span>
                <select class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-base" name="CategoryId">
                    @foreach (var rubrique in _Rubriques)
                    {
                        <option value="@rubrique.Id" selected="@(_article?.RubriqueId == rubrique.Id)">
                            @rubrique.Nom
                        </option>
                    }
                </select>
            </label>

            <label class="flex flex-1 flex-col gap-1">
                <span class="text-sm font-medium">Image de couverture</span>
                <input class="rounded-sm border border-ink-300 bg-white px-3 py-2 text-base"
                       type="url" name="CoverImageUrl" placeholder="https://…" value="@_article?.CoverImageUrl" />
            </label>
        </div>

        <label class="flex items-center gap-2">
            <input type="checkbox" name="Publish" value="true" checked="@(_article is null)" />
            <span class="text-sm">Publier immédiatement et envoyer la lettre d'information</span>
        </label>

        <div class="flex gap-2">
            <button class="rounded-sm bg-violet-500 px-4 py-2 text-sm text-white hover:bg-violet-600" type="submit">
                @(Modification ? "Enregistrer" : "Créer l'actualité")
            </button>
            <a class="rounded-sm border border-ink-300 bg-white px-4 py-2 text-sm hover:bg-ink-50"
               href="/administration/actualites">Annuler</a>
        </div>
    </form>
}

@code {
    /// <summary>Identifiant de l'article modifié, absent à la création.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "erreur")]
    public string? Erreur { get; set; }

    private Article? _article;
    private bool _introuvable;
    private string? _erreur;

    /// <summary>
    /// Rubriques proposées dans le menu. Elles viennent de la base : en ajouter une ne
    /// demande ni code ni déploiement, et le menu de la rédaction ne peut pas proposer
    /// une rubrique que le site public ignorerait.
    /// </summary>
    private IReadOnlyList<Rubrique> _Rubriques = [];

    private bool Modification => Id is not null;

    protected override async Task OnParametersSetAsync()
    {
        _Rubriques = await UniteDeTravail.ReadRepository<Rubrique>().Query
            .OrderBy(rubrique => rubrique.Ordre)
            .ThenBy(rubrique => rubrique.Nom)
            .ToListAsync();

        _erreur = Erreur switch
        {
            "deja-publie" => "Cet article est en ligne : repassez-le en brouillon avant de le modifier.",
            _ => null,
        };

        if (Id is not { } identifiant)
        {
            return;
        }

        _article = await UniteDeTravail.ReadRepository<Article>().Query
            .Include(article => article.Rubrique)
            .FirstOrDefaultAsync(article => article.Id == identifiant);

        _introuvable = _article is null;
    }

    private static string Etat(PublicationStatus statut) => statut switch
    {
        PublicationStatus.Published => "Publié",
        PublicationStatus.Draft => "Brouillon",
        _ => "Archivé",
    };

}
