@page "/Error"
@using System.Diagnostics

<PageTitle>Erreur - DotnetNiger</PageTitle>

<section class="wrap">
    <div class="introuvable">
        <p class="introuvable__code" aria-hidden="true">Erreur</p>

        <h1 class="introuvable__titre">Un incident est survenu</h1>

        <p class="introuvable__texte">
            La demande n'a pas pu aboutir. L'équipe est prévenue du problème : réessayez dans un
            instant, et si la situation persiste, signalez-la en précisant l'heure et la page.
        </p>

        @if (ShowRequestId)
        {
            <p class="introuvable__chemin">Référence : @RequestId</p>
        }

        <div class="introuvable__liens">
            <a href="/" class="btn btn--secondary">
                <DnIcon Name="arrow-left" Size="16" />
                Retour à l'accueil
            </a>
            <a href="/communaute" class="btn btn--secondary">
                <DnIcon Name="users" Size="16" />
                Communauté
            </a>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
