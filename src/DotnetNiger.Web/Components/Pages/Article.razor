@page "/blog/{Slug}"
@using System.Globalization

@using DotnetNiger.Application.Abstractions.Persistence
@using DotnetNiger.Domain.Entities.Content
@using Microsoft.EntityFrameworkCore

@inject ISiteContentService Contenu
@inject IUnitOfWork UniteDeTravail

@if (_Article is null)
{
    @if (_Introuvable)
    {
        <section class="section">
            <div class="wrap">
                <EmptyState Icone="search"
                            Titre="Cet article n'existe pas"
                            Message="Le lien est peut-être ancien, ou l'article a été retiré. Le blog liste tous les articles publiés.">
                    <a class="btn btn--ghost" href="/blog">
                        <DnIcon Name="arrow-left" Size="16" /> Retour au blog
                    </a>
                </EmptyState>
            </div>
        </section>
    }
    else
    {
        <Chargement />
    }
}
else
{
    <PageTitle>@_Article.Titre — blog DotnetNiger</PageTitle>
    <HeadContent>
        <DnSeo Titre="@_Article.Titre"
                Description="@_Article.Extrait"
                Image="@_Article.ImageUrl"
                Type="article"
                DatePublication="@_Article.DatePublication.ToDateTime(TimeOnly.MinValue)" />
    </HeadContent>

    <!-- 1. En-tête de l'article -->
    <section class="hero hero--centre">
        <div class="wrap">
            <p class="hero__eyebrow">
                <a class="link" href="/blog">Blog</a>
                <span aria-hidden="true">·</span>
                <a class="link" href="@UrlRubrique">@_Article.Categorie</a>
            </p>

            <h1 class="hero__title fiche__titre">@_Article.Titre</h1>
            <p class="hero__lead fiche__accentuation">
                <time datetime="@_Article.DatePublication.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                    @_Article.DatePublication.ToString("d MMMM yyyy", Culture)
                </time>
                <span aria-hidden="true">·</span>
                <span>@_Article.Auteur</span>
                @if (!string.IsNullOrWhiteSpace(_Article.FonctionAuteur))
                {
                    <span aria-hidden="true">·</span>
                    <span>@_Article.FonctionAuteur</span>
                }
                <span aria-hidden="true">·</span>
                <span>@_Article.LectureMinutes min de lecture</span>
            </p>
        </div>
    </section>

<!-- 2. Corps de l'article -->
<section class="section" aria-label="Contenu de l'article">
        <div class="wrap">
            @* Le formulaire de commentaire dépose une publication classique : son résultat
               revient dans l'adresse, et c'est ici qu'il se lit. Sans cela, un commentaire
               refusé disparaissait sans que le visiteur sache pourquoi. *@
            @if (_Erreur is not null)
            {
                <p class="alerte alerte--rouge mb-2" role="alert">
                    <span class="alerte__icone"><DnIcon Name="alert" Size="16" /></span>
                    @_Erreur
                </p>
            }

            @if (_Confirmation is not null)
            {
                <p class="alerte alerte--vert mb-2" role="status">
                    <span class="alerte__icone"><DnIcon Name="check" Size="16" /></span>
                    @_Confirmation
                </p>
            }

            <div class="grid gap-2 md:grid-cols-3 fiche__grille">
                <div class="md:col-span-2">
                    @if (!string.IsNullOrWhiteSpace(_Article.ImageUrl))
                    {
                        <DnCardMedia ImageUrl="@_Article.ImageUrl" Alt="" />
                    }

                    <div class="article__corps fiche__corps">
                        <p class="text-lead">@_Article.Extrait</p>
                        @* Le corps est stocké en HTML, assaini à l'écriture par le domaine :
                           l'échapper afficherait les balises au lecteur. *@
                        @((MarkupString)ContenuHtml.Nettoyer(_Article.Contenu))
                    </div>

                    <!-- Retour au blog en fin de lecture, là où l'on cherche après avoir terminé. -->
                    <div class="article__fin">
                        <a class="btn btn--ghost" href="/blog">
                            <DnIcon Name="arrow-left" Size="16" /> Retour au blog
                        </a>
                        <a class="btn btn--primary" href="@UrlRubrique">
                            Plus d'articles en @_Article.Categorie
                            <DnIcon Name="arrow-right" Size="16" />
                        </a>
                        <Partage Titre="@_Article.Titre" />
                    </div>
                </div>

                <aside class="bande" aria-label="À propos de l'auteur">
                    <p class="eyebrow">Rédigé par</p>
                    <p class="bande__title fiche__auteur">@_Article.Auteur</p>
                    @if (!string.IsNullOrWhiteSpace(_Article.FonctionAuteur))
                    {
                        <p class="bande__lead">@_Article.FonctionAuteur</p>
                    }
                    <p class="bande__lead">
                        Article publié le @_Article.DatePublication.ToString("d MMMM yyyy", Culture).
                    </p>
                </aside>
            </div>
        </div>
    </section>

    @if (EstEnBase)
    {
        <!-- 3. Commentaires -->
        <section class="section" aria-label="Commentaires">
            <div class="wrap">
                <Commentaires ArticleId="@_ArticleId" CheminRetour="@($"/blog/{Slug}")" />
            </div>
        </section>
    }

    <!-- 4. Articles suggérés -->
    @if (Suggestions.Length > 0)
    {
        <section class="section section--alt" aria-labelledby="suggestions-titre">
            <div class="wrap">
                <div class="section__head section__head--split">
                    <div>
                        <p class="eyebrow">À lire aussi</p>
                        <h2 id="suggestions-titre" class="section__title">Suggestions</h2>
                        <p class="section__lead">D'autres articles de la communauté, sur des sujets voisins.</p>
                    </div>
                    @* Trois articles voisins ne font pas le tour du blog : le lien donne le
                       reste de la bibliothèque, là où le lecteur est déjà en train de lire. *@
                    <a class="btn btn--ghost" href="/blog">
                        Voir tous les articles <DnIcon Name="arrow-right" Size="16" />
                    </a>
                </div>

                <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3">
                    @foreach (var suggestion in Suggestions)
                    {
                        <ArticleCarte Article="suggestion" />
                    }
                </div>
            </div>
        </section>
    }
}

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("fr-FR");

    /// <summary>Nombre d'articles proposés en fin de lecture.</summary>
    private const int NombreSuggestions = 3;

    [Parameter] public string? Slug { get; set; }

    private ArticleVue? _Article;

    /// <summary>Message d'erreur renvoyé par le formulaire de commentaire, s'il a échoué.</summary>
    private string? _Erreur;

    /// <summary>Confirmation renvoyée par le formulaire, s'il a abouti.</summary>
    private string? _Confirmation;

    [SupplyParameterFromQuery(Name = "erreur")]
    public string? _ErreurUrl { get; set; }

    [SupplyParameterFromQuery(Name = "confirmation")]
    public string? _ConfirmationUrl { get; set; }

    /// <summary>Identifiant de l'article en base, vide s'il n'y a pas de ligne.</summary>
    private Guid _ArticleId;

    /// <summary>Vrai si l'article existe en base et peut donc recevoir des commentaires.</summary>
    private bool EstEnBase => _ArticleId != Guid.Empty;

    private bool _Introuvable;

    private ArticleVue[] Suggestions { get; set; } = [];

    /// <summary>
    /// Filtre la liste sur la rubrique de l'article. Le slug vient du référentiel :
    /// le reconstruire depuis le libellé produisait «nouveautes-de-.net», que le
    /// filtre de la page blog ne reconnaît pas.
    /// </summary>
    private string UrlRubrique => Referentiel.RubriqueArticleParNom(_Article?.Categorie) is { Slug: var slug }
        ? $"/blog?categorie={Uri.EscapeDataString(slug)}"
        : "/blog";

    protected override async Task OnParametersSetAsync()
    {
        _Erreur = _ErreurUrl;
        _Confirmation = _ConfirmationUrl;

        if (!string.IsNullOrWhiteSpace(Slug))
        {
            var articles = await Contenu.ChargerArticlesAsync();
            var trouve = articles.FirstOrDefault(a => string.Equals(a.Slug, Slug, StringComparison.Ordinal));
            _Article = trouve;
            _Introuvable = trouve is null;
            Suggestions = trouve is null ? [] : ChoisirSuggestions(articles, trouve);

            if (trouve is not null)
            {
                // Le commentaire se rattache à l'identifiant en base, pas au slug : un
                // article de démonstration jamais transféré n'a donc pas de fil.
                var enBase = await UniteDeTravail.ReadRepository<DotnetNiger.Domain.Entities.Content.Article>().Query
                    .AsNoTracking()
                    .Where(article => article.Slug == Slug)
                    .Select(article => (Guid?)article.Id)
                    .FirstOrDefaultAsync();

                _ArticleId = enBase ?? Guid.Empty;
            }

            return;
        }

        // Sans slug, la route ne peut pas désigner d'article : on affiche la page d'accueil du
        // blog plutôt que de laisser une page vide.
        _Article = null;
        _Introuvable = true;
        Suggestions = [];
    }

    /// <summary>
    /// Articles de la même rubrique en priorité, complétés par les plus récents des autres
    /// rubriques. On ne propose que des articles parus, jamais l'article lui-même.
    /// </summary>
    private static ArticleVue[] ChoisirSuggestions(IReadOnlyList<ArticleVue> articles, ArticleVue article)
    {
        var autres = articles
            .Where(a => !string.Equals(a.Slug, article.Slug, StringComparison.Ordinal))
            .ToArray();

        var memeRubrique = autres
            .Where(a => a.Categorie == article.Categorie)
            .OrderByDescending(a => a.DatePublication);

        var recents = autres
            .Where(a => a.Categorie != article.Categorie)
            .OrderByDescending(a => a.DatePublication);

        return [.. memeRubrique.Concat(recents).Take(NombreSuggestions)];
    }
}
