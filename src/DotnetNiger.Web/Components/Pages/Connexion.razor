@page "/compte/connexion"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IConfiguration Configuration

<PageTitle>Connexion - DotnetNiger</PageTitle>

<CadreCompte Titre="Connexion"
            SurTitre="Espace membre"
            Lead="Connectez-vous pour publier une ressource, commenter ou vous inscrire à un événement."
            ArgumentsPanneau="ArgumentsPanneau">
    @if (Confirmation is not null)
    {
        <Alerte Variante="vert">@Confirmation</Alerte>
    }
    else if (Error is not null)
    {
        <Alerte Variante="rouge">@Error</Alerte>
    }

    <form method="post" action="/compte/connexion/se-connecter" class="grid gap-5">
        <AntiforgeryToken />
        <input type="hidden" name="Retour" value="@ReturnUrl" />

        <div class="field">
            <label class="field__label" for="Email">Adresse e-mail</label>
            <input class="input" id="Email" type="email" name="Email" required maxlength="256"
                   autocomplete="username" value="@Email" />
        </div>

        <div class="field">
            <div class="compte__actions">
                <label class="field__label" for="Password">Mot de passe</label>
                <a href="@MotDePasseOubliUrl" class="text-caption font-semibold text-violet-700 underline dark:text-violet-200">
                    Mot de passe oublié ?
                </a>
            </div>
            <input class="input" id="Password" type="password" name="Password" required maxlength="256"
                   autocomplete="current-password" />
        </div>

        <label class="compte__option">
            <input type="checkbox" name="RememberMe" value="true" />
            Rester connecté
        </label>

        <button type="submit" class="btn btn--primary w-full">Se connecter</button>
    </form>

    @if (EnabledProviders.Count > 0)
    {
        <p class="compte__separateur">ou continuer avec un compte externe</p>
        <div class="compte__fournisseurs">
            @foreach (var provider in EnabledProviders)
            {
                <a href="@ExternalLink(provider)" class="btn btn--ghost w-full">
                    <DnIcon Name="external-link" Size="16" />
                    Continuer avec @provider
                </a>
            }
        </div>
    }

    <p class="compte__pied">
        <span>Pas encore de compte ?</span>
        <a href="/compte/inscription" class="font-semibold text-violet-700 underline dark:text-violet-200">Créer un compte</a>
    </p>
</CadreCompte>

@code {
    private static readonly string[] ArgumentsPanneau =
    [
        "Publier une ressource et la partager avec la communauté",
        "Commenter les articles et participer aux événements",
        "Suivre les projets locaux et recevoir les nouvelles",
    ];

    [SupplyParameterFromQuery(Name = "erreur")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "confirme")]
    public string? Confirmed { get; set; }

    [SupplyParameterFromQuery(Name = "envoye")]
    public string? Sent { get; set; }

    [SupplyParameterFromQuery(Name = "courriel")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "retour")]
    public string? ReturnUrl { get; set; }

    private List<string> EnabledProviders { get; set; } = new();

    private string? Confirmation =>
        Confirmed switch
        {
            "motdepasse" => "Mot de passe réinitialisé. Vous pouvez vous connecter avec votre nouveau mot de passe.",
            not null when !string.IsNullOrWhiteSpace(Confirmed) => "Votre adresse est confirmée. Vous pouvez vous connecter.",
            _ => !string.IsNullOrWhiteSpace(Sent) && !string.IsNullOrWhiteSpace(Email)
                ? $"Un message de confirmation a été envoyé à {Email}."
                : null,
        };

    private string MotDePasseOubliUrl => string.IsNullOrWhiteSpace(Email)
        ? "/compte/mot-de-passe-oublie"
        : $"/compte/mot-de-passe-oublie?courriel={Uri.EscapeDataString(Email)}";

    protected override void OnInitialized()
    {
        EnabledProviders = ExternalProviderCatalog
            .EnabledProviders(Configuration)
            .Select(fournisseur => fournisseur.Label)
            .ToList();
    }

    private string ExternalLink(string label)
    {
        var provider = ExternalProviderCatalog
            .EnabledProviders(Configuration)
            .First(fournisseur => fournisseur.Label == label);

        var destination = ExternalSignInNavigation.IsLocal(ReturnUrl) ? ReturnUrl! : "/";

        return $"/connexion/{provider.Key}?returnUrl={Uri.EscapeDataString(destination)}";
    }
}
