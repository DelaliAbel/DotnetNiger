@page "/compte/tableau-de-bord"
@layout DotnetNiger.Web.Components.Layout.MemberLayout
@using System.Globalization
@using DotnetNiger.Domain.Enums
@using DotnetNiger.Web.Services.EspaceMembre
@attribute [Authorize]

@inject ServiceEspaceMembre Espace

<PageTitle>Mon tableau de bord — DotnetNiger</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (_espace is null)
{
    <Chargement />
}
else
{
    @if (_Alerte is not null)
    {
        <p class="alerte @(_AlerteEstErreur ? "alerte--rouge" : "alerte--vert") mb-4"
           role="@(_AlerteEstErreur ? "alert" : "status")">
            <span class="alerte__icone">
                <DnIcon Name="@(_AlerteEstErreur ? "alert" : "check")" Size="14" />
            </span>
            @_Alerte
        </p>
    }

    <DepotRessource Nom="@_espace.Profil.FullName" Photo="@_espace.Profil.PhotoUrl" />

    <section class="mt-6" aria-labelledby="partages-titre">
        <div class="section__head mb-3">
            <h2 class="section__title text-lead" id="partages-titre">
                Ce que j'ai partagé
                <span class="carte__compteur">@_espace.Ressources.Count</span>
            </h2>
        </div>

        @if (_espace.Ressources.Count == 0)
        {
            <EmptyState Icone="book-open"
                        Titre="Rien de partagé pour l'instant"
                        Message="Le formulaire ci-dessus dépose votre première ressource." />
        }
        else
        {
            <ul class="partages">
                @foreach (var ressource in _espace.Ressources)
                {
                    <li class="partage">
                        <div class="partage__entete">
                            <DnAvatar Nom="@_espace.Profil.FullName" ImageUrl="@_espace.Profil.PhotoUrl" Sm />
                            <div>
                                <p class="partage__auteur">@_espace.Profil.FullName</p>
                                <p class="partage__quand">
                                    @if (ressource.PublieeUtc is { } publiee)
                                    {
                                        <time datetime="@publiee.ToString("o", CultureInfo.InvariantCulture)">
                                            @publiee.ToString("d MMMM yyyy à HH:mm", Culture)
                                        </time>
                                    }
                                    else
                                    {
                                        <text>en brouillon</text>
                                    }
                                </p>
                            </div>
                            @if (ressource.Statut != PublicationStatus.Published)
                            {
                                <span class="badge badge--ink">
                                    @(ressource.Statut == PublicationStatus.Draft ? "Brouillon" : "Archivée")
                                </span>
                            }
                        </div>

                        <h3 class="partage__titre">
                            <a href="@($"/ressources/{ressource.Slug}")">@ressource.Titre</a>
                        </h3>
                        <p class="partage__texte">@ressource.Description</p>

                        <p class="partage__pied">
                            <span class="badge badge--violet">@ressource.Categorie</span>
                            @if (ressource.Lien is not null)
                            {
                                <a class="lien" href="@ressource.Lien" target="_blank" rel="noopener noreferrer">
                                    Voir la ressource <DnIcon Name="arrow-up-right" Size="14" />
                                </a>
                            }
                        </p>

                        @* Le membre reprend ce qu'il a publié : une faute de titre, une
                           adresse qui a changé, une ressource déposée par erreur. *@
                          <br />
                          
                        <details class="partage__actions">
                            
                            <summary class="partage__actions-titre">Modifier ou retirer</summary>

                            <form method="post" action="/compte/ressources/@ressource.Id/retirer"
                                  class="mt-3"
                                  onsubmit="return confirm('Retirer définitivement « @ressource.Titre » ? Cette action est irréversible.');">
                                <AntiforgeryToken />
                                <button class="btn btn--ghost btn--sm" type="submit">
                                    Retirer cette ressource
                                </button>
                            </form>

                            <form method="post" action="/compte/ressources/@ressource.Id/corriger"
                                  class="partage__edition">
                                <AntiforgeryToken />

                                <div class="field">
                                    <label class="field__label" for="corriger-@ressource.Id">
                                        Titre
                                    </label>
                                    <input id="corriger-@ressource.Id" class="input" name="Titre"
                                           maxlength="200" required value="@ressource.Titre" />
                                </div>

                                <div class="field">
                                    <label class="field__label" for="corriger-description-@ressource.Id">
                                        Description
                                    </label>
                                    <textarea id="corriger-description-@ressource.Id" class="input"
                                              name="Description" rows="3" maxlength="500"
                                              required>@ressource.Description</textarea>
                                </div>

                                <div class="grid gap-2 sm:grid-cols-2">
                                    <div class="field">
                                        <label class="field__label" for="corriger-lien-@ressource.Id">
                                            Adresse
                                        </label>
                                        <input id="corriger-lien-@ressource.Id" class="input" name="LienExterne"
                                               type="url" maxlength="2048" value="@ressource.Lien"
                                               placeholder="https://…" />
                                    </div>

                                    <div class="field">
                                        <label class="field__label" for="corriger-categorie-@ressource.Id">
                                            Catégorie
                                        </label>
                                        <select id="corriger-categorie-@ressource.Id" class="input"
                                                name="Categorie">
                                            @foreach (var categorie in Categories)
                                            {
                                                <option value="@categorie"
                                        selected="@(categorie == ressource.Categorie)">
                                                @categorie
                                            </option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <button class="btn btn--secondary btn--sm" type="submit">
                                    Enregistrer les corrections
                                </button>
                            </form>
                        </details>
                    </li>
                }
            </ul>

        }
    </section>
}
