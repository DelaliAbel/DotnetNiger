@page "/acces-refuse"

<PageTitle>Accès refusé - DotnetNiger</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<CadreCompte Titre="Accès refusé"
            SurTitre="Espace membre"
            Lead="Votre compte n'a pas les droits nécessaires pour consulter cette page.">
    <p class="compte__pied">
        <span>Si vous pensez qu'il s'agit d'une erreur, écrivez à l'équipe : le compte qui vous est
        attribué n'a peut-être pas encore le bon rôle.</span>
    </p>

    <div class="grid gap-3">
        <a href="/" class="btn btn--primary w-full">Retour à l'accueil</a>
        <a href="/communaute" class="btn btn--ghost w-full">Voir la communauté</a>
    </div>
</CadreCompte>

