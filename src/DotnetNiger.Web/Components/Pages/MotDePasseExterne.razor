@page "/compte/mot-de-passe"
@inject PendingExternalSignInProtector Protector

<PageTitle>Choisir un mot de passe - dotnetNiger</PageTitle>

<section class="mx-auto w-full max-w-md">
    <h1 class="mb-1 text-2xl font-semibold">
        @(IsProof ? "Confirmez votre mot de passe" : "Choisissez un mot de passe")
    </h1>
    <p class="mb-6 text-sm text-neutral-600">
        @if (IsProof)
        {
            <text>
                Un compte existe déjà pour l'adresse
                <strong>@Pending?.Email</strong>. Saisissez son mot de passe pour y rattacher
                votre compte @Pending?.Provider.
            </text>
        }
        else
        {
            <text>
                Sur dotnetNiger, chaque compte a son propre mot de passe. Il vous permettra de
                vous connecter même si votre fournisseur d'identité est indisponible.
            </text>
        }
    </p>

    @if (Pending is null)
    {
        <p class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
            Cette demande a expiré ou n'est pas valide. Recommencez depuis la page de connexion.
        </p>
        <p class="mt-4 text-sm">
            <a href="/compte/connexion" class="font-medium text-violet-700 underline">Retour à la connexion</a>
        </p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="mb-4 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-900">
                @Error
            </p>
        }

        <form method="post"
              action="@(IsProof ? "/compte/mot-de-passe/preuve" : "/compte/mot-de-passe/enregistrer")"
              class="space-y-4">
            <AntiforgeryToken />
            <input type="hidden" name="Token" value="@Token" />

            <label class="block">
                <span class="mb-1 block text-sm font-medium">
                    @(IsProof ? "Votre mot de passe actuel" : "Mot de passe")
                </span>
                <input type="password" name="Password" required maxlength="256"
                       autocomplete="@(IsProof ? "current-password" : "new-password")"
                       class="w-full rounded-lg border border-neutral-300 px-3 py-2" />
            </label>

            @if (!IsProof)
            {
                <label class="block">
                    <span class="mb-1 block text-sm font-medium">Confirmation du mot de passe</span>
                    <input type="password" name="ConfirmPassword" required maxlength="128"
                           autocomplete="new-password"
                           class="w-full rounded-lg border border-neutral-300 px-3 py-2" />
                </label>
            }

            <button type="submit"
                    class="w-full rounded-lg bg-violet-700 px-4 py-2 font-medium text-white hover:bg-violet-800">
                @(IsProof ? "Rattacher mon compte" : "Enregistrer mon mot de passe")
            </button>
        </form>

        <p class="mt-4 text-sm text-neutral-600">
            <a href="/compte/connexion" class="underline">Utiliser un autre compte</a>
        </p>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "jeton")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "preuve")]
    public string? ProofFlag { get; set; }

    /// <summary>
    /// Vrai si le membre doit prouver un compte existant plutôt que créer le sien.
    /// </summary>
    private bool IsProof => !string.IsNullOrWhiteSpace(ProofFlag);

    [SupplyParameterFromQuery(Name = "erreur")]
    public string? Error { get; set; }

    private PendingExternalSignIn? Pending { get; set; }

    protected override void OnParametersSet() => Pending = Protector.Unprotect(Token);
}
