@page "/compte/mot-de-passe"
@inject PendingExternalSignInProtector Protector

<PageTitle>Choisir un mot de passe - DotnetNiger</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<CadreCompte SurTitre="Espace membre"
            Titre="@(IsProof ? "Confirmez votre mot de passe" : "Choisissez un mot de passe")"
            Lead="@(IsProof ? "Un compte existe déjà pour cette adresse, rattachez-le à votre compte externe." : "Sur DotnetNiger, chaque compte a son propre mot de passe, utilisable même si votre fournisseur d'identité est indisponible.")">
    @if (Pending is null)
    {
        <Alerte Variante="orange">
            Cette demande a expiré ou n'est pas valide. Recommencez depuis la page de connexion.
        </Alerte>
        <p class="compte__pied">
            <a href="/compte/connexion" class="font-semibold text-violet-700 underline dark:text-violet-200">Retour à la connexion</a>
        </p>
    }
    else
    {
        @if (Error is not null)
        {
            <Alerte Variante="rouge">@Error</Alerte>
        }

        <form method="post"
              action="@(IsProof ? "/compte/mot-de-passe/preuve" : "/compte/mot-de-passe/enregistrer")"
              class="grid gap-5">
            <AntiforgeryToken />
            <input type="hidden" name="Token" value="@Token" />

            @if (IsProof)
            {
                <div class="field">
                    <span class="field__label">Compte à rattacher</span>
                    <p class="input text-ink-600 dark:text-ink-300">@Pending.Email</p>
                </div>
            }

            <div class="field">
                <label class="field__label" for="Password">
                    @(IsProof ? "Votre mot de passe actuel" : "Mot de passe")
                </label>
                <DnChampMotDePasse Id="Password"
                                    Name="Password"
                                    Required="true"
                                    MaximumLength="256"
                                    AutoComplete="@(IsProof ? "current-password" : "new-password")" />
            </div>

            @if (!IsProof)
            {
                <div class="field">
                    <label class="field__label" for="ConfirmPassword">Confirmation du mot de passe</label>
                    <DnChampMotDePasse Id="ConfirmPassword"
                                    Name="ConfirmPassword"
                                    Required="true"
                                    AutoComplete="new-password" />
                </div>
            }

            <button type="submit" class="btn btn--primary w-full" data-dn-submit>
                @(IsProof ? "Rattacher mon compte" : "Enregistrer mon mot de passe")
            </button>
        </form>

        <p class="compte__pied">
            <a href="/compte/connexion" class="underline">Utiliser un autre compte</a>
        </p>
    }
</CadreCompte>

@code {

    [SupplyParameterFromQuery(Name = "jeton")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "preuve")]
    public string? ProofFlag { get; set; }

    /// <summary>
    /// Vrai si le membre doit prouver un compte existant plutôt que créer le sien.
    /// </summary>
    private bool IsProof => !string.IsNullOrWhiteSpace(ProofFlag);

    [SupplyParameterFromQuery(Name = "erreur")]
    public string? Error { get; set; }

    private PendingExternalSignIn? Pending { get; set; }

    protected override void OnParametersSet() => Pending = Protector.Unprotect(Token);
}
