@page "/compte/inscription"
@inject IConfiguration Configuration

<PageTitle>Créer un compte - DotnetNiger</PageTitle>

<CadreCompte Titre="Créer un compte"
            SurTitre="Rejoindre la communauté"
            Lead="Votre adresse sert aussi d'identifiant. Elle ne sera jamais transmise à un tiers.">
    @if (EmailFailed is not null)
    {
        <Alerte Variante="orange">
            Votre compte a été créé, mais le message de confirmation n'a pas pu partir. Vérifiez que le
            serveur de courriels est correctement configuré, puis utilisez la procédure de
            <a href="/compte/mot-de-passe-oublie" class="font-semibold underline">réinitialisation</a>
            pour le renvoyer.
        </Alerte>
    }
    else if (Sent is not null)
    {
        <Alerte Variante="vert">
            Votre compte a été créé. Un message de confirmation a été envoyé à
            <strong>@Email</strong> : ouvrez le lien qu'il contient pour l'activer.
        </Alerte>
        <p class="compte__pied">
            <a href="/compte/connexion" class="font-semibold text-violet-700 underline dark:text-violet-200">Retour à la connexion</a>
        </p>
    }
    else
    {
        @* L'échec laisse le formulaire en place : un message d'erreur suivi d'une page
           vide oblige à tout retaper, alors que seule l'adresse était fautive. *@
        @if (Error is not null)
        {
            <Alerte Variante="rouge">@Error</Alerte>
        }

        @* Les fournisseurs passent avant le formulaire : une personne venue de Google n'a pas
           d'abord à se demander si elle possède déjà un mot de passe chez nous. *@
        @if (EnabledProviders.Count > 0)
        {
            <div class="compte__fournisseurs">
                @foreach (var provider in EnabledProviders)
                {
                    <a href="/connexion/@provider.Key" class="btn btn--ghost w-full">
                        <DnIcon Name="@provider.Icone" Size="18" />
                        S'inscrire avec @provider.Label
                    </a>
                }
            </div>

            <p class="compte__separateur">ou avec votre adresse e-mail</p>
        }

        <form method="post" action="/compte/inscription/creer" class="grid gap-4">
            <AntiforgeryToken />

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="field">
                    <label class="field__label" for="FirstName">Prénom</label>
                    <input class="input" id="FirstName" type="text" name="FirstName" required minlength="2" maxlength="80"
                           autocomplete="given-name" value="@FirstName" />
                </div>
                <div class="field">
                    <label class="field__label" for="LastName">Nom</label>
                    <input class="input" id="LastName" type="text" name="LastName" required minlength="2" maxlength="80"
                           autocomplete="family-name" value="@LastName" />
                </div>
            </div>

            <div class="field">
                <label class="field__label" for="Email">Adresse e-mail</label>
                <input class="input" id="Email" type="email" name="Email" required maxlength="256"
                       autocomplete="email" value="@AdresseSaisie" />
            </div>

            <div class="field">
                <label class="field__label" for="Password">Mot de passe</label>
                <input class="input" id="Password" type="password" name="Password" required maxlength="128"
                       autocomplete="new-password" />
                <p class="text-caption text-ink-500 dark:text-ink-400">
                    Au moins @MinimumLength caractères, avec une majuscule, une minuscule et un chiffre.
                </p>
            </div>

            <div class="field">
                <label class="field__label" for="ConfirmPassword">Confirmation du mot de passe</label>
                <input class="input" id="ConfirmPassword" type="password" name="ConfirmPassword" required maxlength="128"
                       autocomplete="new-password" />
            </div>

            <button type="submit" class="btn btn--primary w-full">Créer mon compte</button>
        </form>

        <p class="compte__pied">
            <span>Vous avez déjà un compte ?</span>
            <a href="/compte/connexion" class="font-semibold text-violet-700 underline dark:text-violet-200">Se connecter</a>
        </p>
    }
</CadreCompte>

@code {
    [SupplyParameterFromQuery(Name = "erreur")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "envoye")]
    public string? Sent { get; set; }

    [SupplyParameterFromQuery(Name = "courriel")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "courrielEchoue")]
    public string? EmailFailed { get; set; }

    /// <summary>Prénom renvoyé par le formulaire après un refus, pour ne pas le retaper.</summary>
    [SupplyParameterFromQuery(Name = "prenom")]
    public string? FirstName { get; set; }

    /// <summary>Nom renvoyé par le formulaire après un refus, pour ne pas le retaper.</summary>
    [SupplyParameterFromQuery(Name = "nom")]
    public string? LastName { get; set; }

    /// <summary>Adresse renvoyée par le formulaire après un refus, pour ne pas la retaper.</summary>
    [SupplyParameterFromQuery(Name = "courrielSaisi")]
    public string? SaisiEmail { get; set; }

    /// <summary>
    /// Adresse à réafficher dans le formulaire. Le succès annonce un envoi à
    /// <c>courriel</c> ; un refus renvoie la saisie sous <c>courrielSaisi</c>, pour ne
    /// pas laisser croire que l'inscription a réussi.
    /// </summary>
    private string AdresseSaisie => SaisiEmail ?? Email ?? string.Empty;

    private List<EnabledProvider> EnabledProviders { get; set; } = new();

    private const int MinimumLength = 12;

    protected override void OnInitialized() =>
        EnabledProviders = ExternalProviderCatalog.EnabledProviders(Configuration).ToList();
}
