@page "/ressources"

@inject ISiteContentService Contenu

@inject DotnetNiger.Application.Abstractions.ICurrentUserService Utilisateur

<PageTitle>Ressources — DotnetNiger, la communauté des développeurs .NET au Niger</PageTitle>
<HeadContent>
    <DnSeo Titre="Ressources"
            Description="Formations et tutoriels (Blazor, ASP.NET Core, MAUI), bibliothèques et outils, articles de blog et guides techniques pour apprendre et pratiquer .NET." />
</HeadContent>

@if (_Ressources is null)
{
    <div class="wrap py-12">
        <p class="text-caption text-[var(--site-fg-muted)]">Chargement…</p>
    </div>
}
else
{
    <!-- 1. Bannière principale -->
    <section class="hero hero--centre">
        <div class="wrap">
            <p class="hero__eyebrow">
                <DnIcon Name="book-open" Size="14" /> Bibliothèque de la communauté
            </p>
            <h1 class="hero__title mt-1">
                Apprendre, pratiquer et <strong>passer à l'action</strong>
            </h1>
            <p class="hero__lead mt-3">
                Formations, tutoriels, bibliothèques et guides : une sélection de la communauté
                DotnetNiger pour progresser avec .NET, de la découverte à la maîtrise.
            </p>
        </div>
    </section>

    <!-- 2. Recherche, catégorie et tri -->
    <section class="section pt-5 pb-0" aria-label="Rechercher et filtrer les ressources">
        <div class="wrap">
            <form method="get" action="/ressources" class="filtres" role="search">
                <div class="filtres__champ">
                    <label class="filtres__libelle" for="recherche-ressources">Recherche</label>
                    <input id="recherche-ressources" class="input" type="search" name="q"
                    value="@_Recherche" placeholder="Titre, sujet, auteur…" />
                </div>

                <div class="filtres__champ">
                    <label class="filtres__libelle" for="categorie-ressources">Catégorie</label>
                    <span class="select">
                        <select id="categorie-ressources" name="categorie">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(_Categorie))">Toutes les catégories</option>
                            @foreach (var categorie in Referentiel.CategoriesRessource)
                            {
                                <option value="@categorie.Slug" selected="@(categorie.Slug == _Categorie)">@categorie.Nom</option>
                            }
                        </select>
                        <DnIcon Name="chevron-down" Size="16" Class="select__chevron" />
                    </span>
                </div>

                <div class="filtres__champ">
                    <label class="filtres__libelle" for="tri-ressources">Trier par</label>
                    <span class="select">
                        <select id="tri-ressources" name="tri">
                            @foreach (var (cle, libelle) in Tris)
                            {
                                <option value="@cle" selected="@(cle == _Tri)">@libelle</option>
                            }
                        </select>
                        <DnIcon Name="chevron-down" Size="16" Class="select__chevron" />
                    </span>
                </div>

                <div class="filtres__actions">
                    <button type="submit" class="btn btn--primary">
                        <DnIcon Name="search" Size="16" /> Filtrer
                    </button>
                    @if (FiltresActifs)
                    {
                        <a class="link text-caption" href="/ressources">Réinitialiser</a>
                    }
                </div>
            </form>
        </div>
    </section>

    <!-- 3. Catalogue -->
    <section class="section" aria-labelledby="catalogue-titre">
        <div class="wrap">
            <div class="section__head section__head--split">
                <div>
                    <p class="eyebrow">La sélection</p>
                    <h2 id="catalogue-titre" class="section__title">
                        @TitreCatalogue <strong>@SousTitreCatalogue</strong>
                    </h2>
                    <p class="section__lead">
                        @if (_Recherche is { Length: > 0 })
                        {
                            <text>@ResultatsFiltres.Length résultat(s) pour « @_Recherche ».</text>
                        }
                        else
                        {
                            <text>@ResultatsFiltres.Length ressources dans la bibliothèque de la communauté.</text>
                        }
                    </p>
                </div>
                <span class="badge badge--violet">@ResultatsFiltres.Length ressources</span>
            </div>

            @if (ResultatsPageCourante.Length == 0)
            {
                <EmptyState Icone="search"
                Titre="Aucune ressource ne correspond à votre recherche"
                Message="Essayez d'autres mots-clés ou élargissez la recherche en réinitialisant le filtre de catégorie.">
                <a class="btn btn--ghost" href="/ressources">
                    Voir toutes les ressources <DnIcon Name="arrow-right" Size="16" />
                </a>
            </EmptyState>
        }
        else
        {
            <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var ressource in ResultatsPageCourante)
                {
                    <RessourceCarte Ressource="ressource" Icone="book-open" />
                }
            </div>

            <Pagination PageCourante="PageCourante"
            NombreDePages="NombreDePages"
            Libelle="Pagination des ressources"
            UrlPage="UrlPage" />
        }
    </div>
</section>

<!-- 4. Contribuer -->
<section class="section" aria-labelledby="proposer-titre">
    <div class="wrap">
        <div class="bande">
            <div class="grid items-center gap-6 md:grid-cols-2">
                <div>
                    <p class="eyebrow text-vert-300">Contribuer</p>
                    <h2 id="proposer-titre" class="bande__title mt-1">
                        Une ressource à partager avec la communauté ?
                    </h2>
                    <p class="bande__lead">
                        Tutoriel, outil ou guide qui vous a fait gagner du temps : proposez-la,
                        elle aidera peut-être un autre développeur nigerien.
                    </p>
                </div>
                <div class="contribuer__actions">

                    @if (Utilisateur.IsAuthenticated)
                    {

                        <a class="btn btn--white btn--lg" href="/compte/tableau-de-bord">
                            Proposer une ressource <DnIcon Name="arrow-right" Size="18" />
                        </a>

                    }
                    else
                    {

                        <a class="btn btn--white btn--lg" href="/compte/inscription">
                            Proposer une ressource <DnIcon Name="arrow-right" Size="18" />
                        </a>
                        <p class="contribuer__note">
                            Connectez-vous pour publier directement votre ressource :
                            <a class="link" href="/compte/connexion?retour=/ressources">se connecter</a>.
                        </p>
                    }


                </div>
            </div>
        </div>
    </div>
</section>
}

@code {
    /// <summary>Nombre de ressources affichées par page.</summary>
    private const int RessourcesParPage = 9;

    /// <summary>
    /// Ordres de tri proposés. Une ressource n'a pas de date de publication : c'est
    /// une curated stable, pas un article. Le tri porte donc sur ce qu'elle porte
    /// réellement — son titre et son auteur.
    /// </summary>
    private static readonly (string Cle, string Libelle)[] Tris = new[]
    {
        ("selection", "Sélection de l'équipe"),
        ("az", "Titre A → Z"),
        ("za", "Titre Z → A"),
        ("auteur", "Auteur A → Z"),
        ("sujet", "Sujet A → Z"),
    };

    private IReadOnlyList<RessourceVue>? _Ressources;

    [SupplyParameterFromQuery(Name = "q")]
    public string? _Recherche { get; set; }

    [SupplyParameterFromQuery(Name = "categorie")]
    public string? _Categorie { get; set; }

    [SupplyParameterFromQuery(Name = "tri")]
    public string? _Tri { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? _Page { get; set; }

    private RessourceVue[] ResultatsFiltres { get; set; } = [];

    private string TitreCatalogue { get; set; } = "Toutes les";

    private string SousTitreCatalogue { get; set; } = "ressources";

    private int PageCourante { get; set; } = 1;

    private int NombreDePages { get; set; } = 1;

    private RessourceVue[] ResultatsPageCourante =>
        ResultatsFiltres.Skip((PageCourante - 1) * RessourcesParPage)
            .Take(RessourcesParPage)
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        var ressources = await Contenu.ChargerRessourcesAsync();
        _Ressources = ressources.ToArray();

        if (_Page is { } pageDemandee && pageDemandee > 0)
        {
            PageCourante = pageDemandee;
        }

        AppliquerFiltres();
    }

    private void AppliquerFiltres()
    {
        IEnumerable<RessourceVue> resultats = _Ressources ?? [];

        var categorie = CategorieSelectionnee();
        if (categorie is not null)
        {
            resultats = resultats.Where(r => r.Categorie == categorie);
        }

        var recherche = _Recherche?.Trim();
        if (recherche is { Length: > 0 })
        {
            resultats = resultats.Where(r =>
                r.Titre.Contains(recherche, StringComparison.OrdinalIgnoreCase)
                || r.Description.Contains(recherche, StringComparison.OrdinalIgnoreCase)
                || r.Sujet.Contains(recherche, StringComparison.OrdinalIgnoreCase)
                || r.Auteur.Contains(recherche, StringComparison.OrdinalIgnoreCase));
        }

        // Un critère de tri inconnu retombe sur l'ordre alphabétique plutôt que sur
        // une liste vide : l'URL reste partageable, seul l'ordre change.
        // Par défaut, l'ordre de la garniture : c'est l'ordre éditorial — les
        // ressources les plus utiles d'abord. Une ressource n'a pas de date de
        // publication, et un « plus récent d'abord » y serait un ordre inventé.
        resultats = _Tri switch
        {
            "az" => resultats.OrderBy(r => r.Titre, StringComparer.OrdinalIgnoreCase),
            "za" => resultats.OrderByDescending(r => r.Titre, StringComparer.OrdinalIgnoreCase),
            "auteur" => resultats.OrderBy(r => r.Auteur, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Titre, StringComparer.OrdinalIgnoreCase),
            "sujet" => resultats.OrderBy(r => r.Sujet, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Titre, StringComparer.OrdinalIgnoreCase),
            _ => resultats,
        };

        ResultatsFiltres = resultats.ToArray();

        NombreDePages = Math.Max(1, (int)Math.Ceiling(ResultatsFiltres.Length / (double)RessourcesParPage));
        if (PageCourante > NombreDePages)
        {
            PageCourante = NombreDePages;
        }

        (TitreCatalogue, SousTitreCatalogue) = CategorieSelectionnee() switch
        {
            "Formations et tutoriels" => ("Formations et", "tutoriels"),
            "Bibliothèques et outils" => ("Bibliothèques et", "outils"),
            "Articles de blog et guides" => ("Articles et", "guides"),
            _ => ("Toutes les", "ressources"),
        };
    }

    private string? CategorieSelectionnee() =>
        Referentiel.CategorieRessourceParSlug(_Categorie)?.Nom;

    /// <summary>Vrai dès qu'un critère a été utilisé ; pilote le lien de remise à zéro.</summary>
    private bool FiltresActifs =>
        !string.IsNullOrWhiteSpace(_Recherche)
        || !string.IsNullOrWhiteSpace(_Categorie)
        || (_Tri is { Length: > 0 } and not "selection");

    /// <summary>Construit l'URL d'une page en conservant la catégorie, le tri et la recherche en cours.</summary>
    private string UrlPage(int page)
    {
        var paramètres = new List<string>();
        if (!string.IsNullOrWhiteSpace(_Categorie))
        {
            paramètres.Add($"categorie={Uri.EscapeDataString(_Categorie)}");
        }

        if (_Recherche is { Length: > 0 })
        {
            paramètres.Add($"q={Uri.EscapeDataString(_Recherche)}");
        }

        if (!string.IsNullOrWhiteSpace(_Categorie))
        {
            paramètres.Add($"categorie={Uri.EscapeDataString(_Categorie)}");
        }

        if (_Tri is { Length: > 0 } and not "selection")
        {
            paramètres.Add($"tri={Uri.EscapeDataString(_Tri)}");
        }

        if (page > 1)
        {
            paramètres.Add($"page={page}");
        }

        return "/ressources" + (paramètres.Count > 0 ? "?" + string.Join("&", paramètres) : "");
    }
}