@page "/a-propos"

@inject ISiteContentService Contenu

@inject DotnetNiger.Application.Abstractions.ICurrentUserService Utilisateur

<PageTitle>À propos — DotnetNiger, la communauté des développeurs .NET au Niger</PageTitle>
<HeadContent>
    <DnSeo Titre="À propos"
            Description="Découvrez la mission, les valeurs, l'histoire et l'équipe de la communauté des développeurs .NET au Niger." />
</HeadContent>

@if (_erreur)
{
    <div class="wrap py-12">
        <EtatErreur />
    </div>
}
else if (_APropos is null)
{
    <div class="wrap py-12">
        <Chargement />
    </div>
}
else
{
    <!-- 1. Qui sommes-nous ? -->
    <section class="hero">
        <div class="wrap hero__grid hero__grid--inverse">
            <div>
                <p class="hero__eyebrow">
                    <DnIcon Name="code" Size="14" /> Qui sommes-nous ?
                </p>
                <h1 class="hero__title mt-1">
                    Un catalyseur de la <strong>transformation numérique au Sahel</strong>
                </h1>
                <p class="hero__lead mt-3">
                    @_APropos.Presentation
                </p>
                <div class="hero__actions mt-4">
                    <a class="btn btn--white btn--lg" href="/a-propos#mission">
                        Découvrir notre vision <DnIcon Name="arrow-right" Size="18" />
                    </a>
                    <a class="btn btn--accent btn--lg" href="/a-propos#equipe">
                        Rencontrer l'équipe <DnIcon Name="users" Size="18" />
                    </a>
                </div>
            </div>

            <div class="hero__panel">
                <div class="hero__panel__bar" aria-hidden="true">
                    <span class="hero__panel__dot bg-orange-400"></span>
                    <span class="hero__panel__dot bg-vert-400"></span>
                    <span class="hero__panel__dot bg-violet-300"></span>
                </div>
                <img class="hero__panel__image" src="/images/img3.jpg" loading="lazy"
                     width="640" height="480"
                alt="Atelier DotnetNiger : des développeurs .NET du Niger autour de leurs ordinateurs portables" />
            </div>
        </div>
    </section>

    <!-- 2. Notre mission -->
    <section class="section" aria-labelledby="mission-titre" id="mission">
        <div class="wrap">
            <div class="mission">
                <div class="section__head mb-0">
                    <p class="eyebrow text-vert-300">Notre mission</p>
                    <h2 id="mission-titre" class="mission__titre">
                        Propulser le talent local au sommet de la <strong>tech mondiale</strong>
                    </h2>
                    <p class="mission__detail">
                        @_APropos.MissionDetail
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Nos valeurs fondamentales -->
    <section class="section" aria-labelledby="valeurs-titre">
        <div class="wrap">
            <div class="section__head">
                <p class="eyebrow">Nos valeurs fondamentales</p>
                <h2 id="valeurs-titre" class="section__title">
                    Ce qui <strong>guide notre communauté</strong>
                </h2>
            </div>

            @if (_APropos.Valeurs.Count == 0)
            {
                <EmptyState Icone="sparkles" Titre="Aucune valeur publiée pour le moment" />
            }
            else
            {
                <div class="grid gap-2 md:grid-cols-3">
                    @foreach (var valeur in _APropos.Valeurs)
                    {
                        <article class="card card--hover">
                            <div class="card__body">
                                <span class="badge badge--violet"><DnIcon Name="@valeur.Icone" Size="14" /> @valeur.Titre</span>
                                <h3 class="card__title text-base">@valeur.Titre</h3>
                                <p class="card__text">@valeur.Description</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <!-- 4. Notre histoire -->
    <section class="section" aria-labelledby="histoire-titre">
        <div class="wrap">
            <div class="section__head">
                <p class="eyebrow">Notre histoire</p>
                <h2 id="histoire-titre" class="section__title">
                    De la <strong>fondation</strong> à la <strong>reconnaissance</strong>
                </h2>
                <p class="section__lead">
                    Trois temps forts ont marqué le parcours de la communauté, des premières
                    rencontres à Niamey jusqu'à l'intégration dans le réseau mondial des
                    communautés .NET.
                </p>
            </div>

            @if (_APropos.Histoire.Count == 0)
            {
                <EmptyState Icone="calendar" Titre="Aucun jalon publié pour le moment" />
            }
            else
            {
                <div class="grid gap-2 md:grid-cols-3">
                    @foreach (var jalon in _APropos.Histoire)
                    {
                        <article class="card card--hover">
                            <div class="card__body">
                                <span class="badge badge--violet">@jalon.Periode</span>
                                <h3 class="card__title">@jalon.Titre</h3>
                                <p class="card__text">@jalon.Description</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <!-- 5. Équipe -->
    <section class="section section--alt" aria-labelledby="equipe-titre" id="equipe">
        <div class="wrap">
            <div class="section__head">
                <p class="eyebrow">L'équipe</p>
                <h2 id="equipe-titre" class="section__title">
                    Les personnes qui <strong>font vivre la communauté</strong>
                </h2>
                <p class="section__lead">
                    Membres, contributeurs et responsables : celles et ceux qui accompagnent la
                    croissance de DotnetNiger au quotidien.
                </p>
            </div>

            @if (_APropos.Equipe.Count == 0)
            {
                <EmptyState Icone="users"
                Titre="L'équipe n'est pas encore présentée"
                Message="Les membres qui animent la communauté apparaîtront ici avec leur rôle et leurs liens.">
                <a class="btn btn--ghost" href="/communaute">
                    Découvrir la communauté <DnIcon Name="arrow-right" Size="16" />
                </a>
            </EmptyState>
        }
        else
        {
            <div class="grid gap-2 md:grid-cols-3">
                @foreach (var membre in _APropos.Equipe)
                {
                    <article class="card">
                        <div class="card__media card__media--equipe">
                            @* Sans photo, le composant tombe sur les initiales. Un
                               <img src=""> afficherait une page d'erreur à la place de
                               la photo, ce qui est pire qu'un cercle vide. *@
                            <DnAvatar Nom="@membre.Nom" ImageUrl="@membre.ImageUrl" Teinte="@membre.Teinte" Profil />
                        </div>
                        <div class="card__body">
                            <h3 class="card__title text-base">@membre.Nom</h3>

                            @* Ni la fonction ni les liens ne sont rendus à vide : un
                               paragraphe sans texte garde sa marge et laisse un trou
                               sous le nom, comme une carte inachevée. *@
                            @if (!string.IsNullOrWhiteSpace(membre.Role))
                            {
                                <p class="card__text">@membre.Role</p>
                            }

                            @if (membre.Liens.Count > 0)
                            {
                                <p class="card__meta">
                                    @* Les mêmes liens que ceux que le membre enregistre depuis
                                       son profil, dans son ordre. L'icône est déduite de
                                       l'adresse : GitHub et LinkedIn ont la leur, tout le
                                       reste — portfolio, blog — prend celle d'un site. *@
                                    @foreach (var lien in membre.Liens)
                                    {
                                        <a class="equipe__social" href="@lien.Url" target="_blank" rel="noopener"
                                           aria-label="@($"{lien.Libelle} de {membre.Nom}")"
                                           title="@lien.Libelle">
                                            <DnIcon Name="@lien.Icone" Size="16" />
                                        </a>
                                    }
                                </p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<!-- 6. Zone de connexion rapide -->
<section class="section" aria-labelledby="rejoindre-titre">
    <div class="wrap">
        <div class="bande">
            <div class="grid items-center gap-6 md:grid-cols-2">

                @if (Utilisateur.IsAuthenticated)
                {
                    <div>
                        <p class="eyebrow text-vert-300">Voir les événements de la communauté</p>
                        <h2 id="rejoindre-titre" class="bande__title mt-1">
                            La communauté vous attend
                        </h2>
                        <p class="bande__lead">
                            Échangez avec des développeurs passionnés, découvrez des ressources
                            et participez à la vie de DotnetNiger.
                        </p>
                    </div>
                    <div>
                        <a class="btn btn--white btn--lg" href="/evenements">
                            Voir tous les événements
                            <DnIcon Name="arrow-right" Size="18" />
                        </a>
                    </div>
                }
                else
                {
                    <div>
                        <p class="eyebrow text-vert-300">Rejoindre la communauté</p>
                        <h2 id="rejoindre-titre" class="bande__title mt-1">
                            La communauté vous attend
                        </h2>
                        <p class="bande__lead">
                            Échangez avec des développeurs passionnés, découvrez des ressources
                            et participez à la vie de DotnetNiger.
                        </p>
                    </div>
                    <div>
                        <a class="btn btn--white btn--lg" href="/compte/inscription">
                            Rejoindre la communauté <DnIcon Name="arrow-right" Size="18" />
                        </a>

                    </div>
                }
            </div>
        </div>
    </div>
</section>
}

@code {
    private AProposVue? _APropos;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _APropos = await Contenu.ChargerAProposAsync();
        }
        catch
        {
            _erreur = true;
        }
    }
}