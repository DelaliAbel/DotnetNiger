<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#512BD4" />
    <meta name="description" content="DotnetNiger — la communauté des développeurs .NET au Niger : événements, ressources, projets open source et actualités." />
    <meta property="og:site_name" content="DotnetNiger" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="DotnetNiger — la communauté des développeurs .NET au Niger" />
    <meta property="og:description" content="Rejoignez la communauté des développeurs .NET au Niger : événements, ressources, projets open source et actualités." />
    <meta property="og:image" content="/favicon.png" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["DotnetNiger.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script>
        // Applique le thème mémorisé avant le premier rendu pour éviter un flash clair/sombre.
        (function () {
            try {
                var theme = localStorage.getItem("dn-theme");
                if (theme === null) {
                    theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                if (theme === "dark") {
                    document.documentElement.classList.add("dark");
                }
                document.documentElement.setAttribute("data-theme", theme);
            } catch (e) { }
        })();

        // Chargement des scripts propres à l'administration.
        //
        // Ils vivent dans le layout d'administration, qui est remplacé à chaque navigation
        // enhanced : le document reçu alors ne réexécute pas les scripts, et l'éditeur
        // comme les appels d'API se retrouvent absents. Ce minuscule amorceur vit dans le
        // document racine, qui n'est jamais remplacé, et réinjecte ce qui manque. Chaque
        // fichier n'est chargé qu'une fois.
        window.DnAdminScripts = (function () {
            var fichiers = [
                "/js/api-admin.js",
                "/tinymce/tinymce.min.js",
                "/js/tinymce-admin.js"
            ];

            var charger = [];

            for (var i = 0; i < fichiers.length; i++) {
                (function (chemin) {
                    charger.push(new Promise(function (resoudre) {
                        if (document.querySelector('script[data-dn="' + chemin + '"]')) {
                            resoudre();
                            return;
                        }

                        var balise = document.createElement("script");
                        balise.src = chemin;
                        balise.dataset.dn = chemin;
                        balise.addEventListener("load", resoudre);
                        balise.addEventListener("error", resoudre);
                        document.head.appendChild(balise);
                    }));
                })(fichiers[i]);
            }

            return {
                // Attend que les scripts soient présents. Sans argument, n'attend rien : la
                // simple présence suffit quand la page n'a pas encore à les utiliser.
                assure: function (attendre) {
                    if (!attendre) {
                        return null;
                    }

                    return Promise.all(charger);
                },

                // Indique si un objet global existe. Blazor n'évalue pas une expression :
                // le nom qu'on lui donne doit désigner une fonction. Cette sonde évite
                // d'écrire `typeof window.x !== "undefined"` côté C#, qui planterait.
                present: function (nom) {
                    return typeof window[nom] !== "undefined";
                }
            };
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
