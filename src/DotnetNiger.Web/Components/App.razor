@inject DotnetNiger.Web.Services.Reglages.ServiceReglages Reglages
@inject Microsoft.Extensions.Options.IOptions<DotnetNiger.Infrastructure.Email.EmailOptions> OptionsCourriel

@*
    Document racine, commun à toutes les pages.

    L'adresse du site et le logo viennent de la configuration et des réglages, jamais d'une
    chaîne en dur ici. Une adresse écrite dans ce fichier serait vraie au moment du
    développement et fausse après le changement de domaine : le pire moment pour s'en
    apercevoir, celui où l'indexation est déjà en cours.
*@

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#512BD4" />

    @* Ces trois-là sont identiques quelle que soit la page : titre et description
        canoniques sont fournis par <DnSeo />, sur chaque page. Les déclarer ici en plus
        ferait doubler chaque balise, et le moteur retiendrait la première — celle du
        document racine, donc la même pour toutes les pages. *@
    <meta property="og:site_name" content="DotnetNiger" />
    <meta property="og:locale" content="fr_NI" />
    <meta name="twitter:card" content="summary_large_image" />

    @* Image de repli quand une page n'en fournit pas : le logo des réglages. *@
    <meta property="og:image" content="@ImagePartagee" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["DotnetNiger.Web.styles.css"]" />
    <ImportMap />
    @* Le favicon suit le logo des réglages : changer de logo sans changer d'icône laisserait
       deux identités différentes dans le navigateur et dans les signets.
       Une seule source, donc : le `.ico` n'est déclaré que lorsqu'aucun logo n'est posé.
       Le déclarer toujours laisserait le navigateur libre de le préférer au logo — et c'est
       ce qu'il fait, l'onglet gardant alors l'ancienne icône sans raison visible. *@
    @if (_logo is { Length: > 0 })
    {
        <link rel="icon" type="image/png" href="@_logo" />
        <link rel="apple-touch-icon" href="@_logo" />
        <link rel="shortcut icon" href="@_logo" />
    }
    else
    {
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
    }
    <script>
        // Applique le thème mémorisé avant le premier rendu pour éviter un flash clair/sombre.
        (function () {
            try {
                var theme = localStorage.getItem("dn-theme");
                if (theme === null) {
                    theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                if (theme === "dark") {
                    document.documentElement.classList.add("dark");
                }
                document.documentElement.setAttribute("data-theme", theme);
            } catch (e) { }
        })();

        // Chargement des scripts propres à l'administration.
        //
        // Ils vivent dans le layout d'administration, qui est remplacé à chaque navigation
        // enhanced : le document reçu alors ne réexécute pas les scripts, et l'éditeur
        // comme les appels d'API se retrouvent absents. Ce minuscule amorceur vit dans le
        // document racine, qui n'est jamais remplacé, et réinjecte ce qui manque. Chaque
        // fichier n'est chargé qu'une fois.
        window.DnAdminScripts = (function () {
            var fichiers = [
                "/js/api-admin.js",
                "/tinymce/tinymce.min.js",
                "/js/tinymce-admin.js"
            ];

            var charger = [];

            for (var i = 0; i < fichiers.length; i++) {
                (function (chemin) {
                    charger.push(new Promise(function (resoudre) {
                        if (document.querySelector('script[data-dn="' + chemin + '"]')) {
                            resoudre();
                            return;
                        }

                        var balise = document.createElement("script");
                        balise.src = chemin;
                        balise.dataset.dn = chemin;
                        balise.addEventListener("load", resoudre);
                        balise.addEventListener("error", resoudre);
                        document.head.appendChild(balise);
                    }));
                })(fichiers[i]);
            }

            return {
                // Attend que les scripts soient présents. Sans argument, n'attend rien : la
                // simple présence suffit quand la page n'a pas encore à les utiliser.
                assure: function (attendre) {
                    if (!attendre) {
                        return null;
                    }

                    return Promise.all(charger);
                },

                // Indique si un objet global existe. Blazor n'évalue pas une expression :
                // le nom qu'on lui donne doit désigner une fonction. Cette sonde évite
                // d'écrire `typeof window.x !== "undefined"` côté C#, qui planterait.
                present: function (nom) {
                    return typeof window[nom] !== "undefined";
                }
            };
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    /// <summary>Logo déposé par l'administration, ou <see langword="null"/>.</summary>
    private string? _logo;

    /// <summary>
    /// Adresse publique du site, sans barre finale.
    /// </summary>
    /// <remarks>
    /// Elle vient de la configuration du serveur — la même valeur que celle qui fabrique
    /// les liens des courriels. Les deux doivent concorder : des courriels pointant vers
    /// un domaine et des balises SEO vers un autre installeraient deux sites aux yeux d'un
    /// moteur de recherche.
    /// </remarks>
    private string SitePublic => OptionsCourriel.Value.SiteUrl.TrimEnd('/');

    /// <summary>Adresse de la page courante, pour le canonical et <c>og:url</c>.</summary>
    private string UrlCanonique
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);

            return string.IsNullOrEmpty(relative) ? SitePublic : $"{SitePublic}/{relative}";
        }
    }

    /// <summary>Adresse absolue de l'image partagée sur les réseaux sociaux.</summary>
    private string ImagePartagee
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_logo))
            {
                return $"{SitePublic}/favicon.png";
            }

            return _logo.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? _logo
                : $"{SitePublic}/{_logo.TrimStart('/')}";
        }
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
        => _logo = (await Reglages.LireAsync()).Logo;
}
