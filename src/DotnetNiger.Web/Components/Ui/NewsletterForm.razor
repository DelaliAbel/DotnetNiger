@namespace DotnetNiger.Web.Components.Ui

<div class="field">
    <form class="grid gap-1 sm:grid-cols-[1fr_auto]" @onsubmit="Soumettre" novalidate>
        <label class="sr-only" for="newsletter-courriel">Votre adresse e-mail</label>
        <input id="newsletter-courriel" class="input" type="email" inputmode="email" autocomplete="email"
               placeholder="vous@exemple.com" aria-label="Votre adresse e-mail" @bind="@_courriel" />
        <button class="btn btn--accent w-full sm:w-auto" type="submit">
            <DnIcon Name="send" Size="16" /> S'abonner
        </button>
    </form>
    <p class="text-caption mt-2 text-[color:rgb(255_255_255/0.75)]">
        Pas de spam : des actualités et des événements, au rythme de la communauté.
    </p>
</div>

<div class="toasts" aria-live="polite">
    @foreach (var message in _Messages)
    {
        <div class="toast @(message.Danger ? "toast--danger" : "toast--vert")" role="status">
            <span class="toast__icone">
                <DnIcon Name="@(message.Danger ? "x" : "check")" Size="16" />
            </span>
            <span class="toast__message">@message.Texte</span>
        </div>
    }
</div>

@code {
    private string _courriel = string.Empty;

    private readonly List<(Guid Id, string Texte, bool Danger)> _Messages = new();

    private async Task Soumettre()
    {
        if (string.IsNullOrWhiteSpace(_courriel) || !_courriel.Contains('@', StringComparison.Ordinal))
        {
            Ajouter("Veuillez saisir une adresse e-mail valide.", danger: true);
            return;
        }

        _courriel = string.Empty;
        Ajouter("Bien reçu ! Votre inscription à la newsletter est enregistrée (simulation).");
        await InvokeAsync(StateHasChanged);
    }

    private void Ajouter(string texte, bool danger = false)
    {
        var identifiant = Guid.NewGuid();
        _Messages.Add((identifiant, texte, danger));
        _ = RetirerAprèsDelaiAsync(identifiant);
    }

    private async Task RetirerAprèsDelaiAsync(Guid identifiant)
    {
        await Task.Delay(4000);
        _Messages.RemoveAll(m => m.Id == identifiant);
        await InvokeAsync(StateHasChanged);
    }
}