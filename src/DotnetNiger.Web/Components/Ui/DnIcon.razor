@namespace DotnetNiger.Web.Components.Ui

@if (Defs.TryGetValue(Name, out var definition))
{
    <svg class="dn-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="@(definition.Rempli ? "currentColor" : "none")"
         stroke="@(definition.Rempli ? "none" : "currentColor")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        @foreach (var chemin in definition.Chemins)
        {
            <path d="@chemin" />
        }
    </svg>
}

