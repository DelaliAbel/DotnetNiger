    /// Balisage rendu tel quel, réservé aux logos multicolores. Prioritaire sur
    /// <paramref name="Chemins"/> quand il est présent.
    /// </param>
    private sealed record DefinitionIcon(string[] Chemins, bool Rempli, string? MarkupBrut = null);

