@namespace DotnetNiger.Web.Components.Ui

@if (Defs.TryGetValue(Name, out var definition))
{
    @* Un logo de marque multicolore — Google — n'a pas de version « currentColor »
       reconnaissable : il est rendu tel quel, avec ses propres couleurs. *@
    if (definition.MarkupBrut is not null)
    {
        @((MarkupString)definition.MarkupBrut)
    }
    else
    {
        <svg class="@Classes" width="@Size" height="@Size" viewBox="0 0 24 24" fill="@(definition.Rempli ? "currentColor" : "none")"
             stroke="@(definition.Rempli ? "none" : "currentColor")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @foreach (var chemin in definition.Chemins)
            {
                <path d="@chemin" />
            }
        </svg>
    }
}

@code {
    /// <summary>Nom de l'icône, parmi celles déclarées dans <see cref="Defs"/>.</summary>
    [Parameter] public required string Name { get; set; }

    /// <summary>Taille en pixels ; la géométrie reste celle d'un carré 24 × 24.</summary>
    [Parameter] public int Size { get; set; } = 20;

    /// <summary>
    /// Classes CSS additionnelles, pour les cas où l'icône doit être positionnée
    /// (flèche d'un menu déroulant, par exemple) plutôt que de participer au flux.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    private string Classes => string.IsNullOrWhiteSpace(Class) ? "dn-icon" : $"dn-icon {Class}";

