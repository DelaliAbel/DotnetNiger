@namespace DotnetNiger.Web.Components.Ui

@*
    Champ de mot de passe avec un bouton qui le rend lisible.

    Un mot de passe recopié depuis un gestionnaire se trompe souvent d'un caractère. Sans
    moyen de le vérifier, le membre échoue, attend « mot de passe incorrect », puis
    recommence — sans jamais comprendre que le mot de passe était juste.

    Le bouton est piloté par un script, et non par `@onclick`. Les pages de compte sont
    rendues côté serveur, sans îlot interactif : un gestionnaire d'événement Blazor
    n'y répondrait pas. Et mélanger les deux mechanisms fait pis — le script changeait
    `type` dans le DOM, puis Blazor réécrivait `type="password"` au rendu suivant,
    laissant l'œil et le champ en désaccord permanent.

    Le texte affiché appartient au composant et suit la frappe. Rendre `value="@Valeur"`
    suffirait à primera vue, mais Blazor réécrit alors l'attribut à chaque rendu : un rendu
    déclenché ailleurs — l'ouverture d'un tiroir, l'envoi d'un formulaire — remettrait
    dans le champ une valeur antérieure. Le membre verrait ses caractères s'effacer.
*@

<div class="champ-mdp">
    <input class="input champ-mdp__champ @CssChamp"
           id="@Id"
           name="@Name"
           type="password"
           value="@_texte"
           maxlength="@MaximumLength"
           autocomplete="@AutoComplete"
           required="@Required"
           minlength="@MinimumLength"
           @oninput="SurSaisie"
           @attributes="AttributsSupplementaires" />

    <button class="champ-mdp__oeil" type="button"
            aria-pressed="false"
            aria-label="Afficher le mot de passe"
            title="Afficher"
            onclick="DnMotDePasse.bascule(this); return false;">
        @* Les deux icônes sont rendues ; c'est l'attribut `aria-pressed`, posé par le
           script, que la feuille de style interroge pour savoir laquelle montrer. *@
        <span class="champ-mdp__icone champ-mdp__icone--barre">
            <DnIcon Name="eye-off" Size="16" />
        </span>
        <span class="champ-mdp__icone champ-mdp__icone--ouvert">
            <DnIcon Name="eye" Size="16" />
        </span>
    </button>
</div>

@code {
    /// <summary>Identifiant du champ, relié au <c>label</c>.</summary>
    [Parameter] public string Id { get; set; } = string.Empty;

    /// <summary>Nom transmis au serveur.</summary>
    [Parameter, EditorRequired] public required string Name { get; set; }

    /// <summary>
    /// Valeur initiale, pour réafficher une saisie précédente après une erreur.
    /// </summary>
    /// <remarks>
    /// Elle n'est lue qu'au premier rendu. Après, seul le composant fait foi : le recopier à
    /// chaque rendu reviendrait à écraser ce que la personne est en train de taper.
    /// </remarks>
    [Parameter] public string? Valeur { get; set; }

    /// <summary>
    /// Rappelée à chaque frappe, pour que la page puisse lire le mot de passe saisi.
    /// </summary>
    /// <remarks>
    /// La liaison va dans les deux sens : une page qui lit ce champ — pour l'envoyer au
    /// serveur, comme la création d'un compte — a besoin de connaître la saisie. Sans ce
    /// rappel, le champ est visuellement rempli mais sa valeur reste nulle-part, et le
    /// serveur reçoit une chaîne vide.
    /// </remarks>
    [Parameter] public EventCallback<string?> ValeurChanged { get; set; }

    /// <summary>
    /// Longueur minimale déclarée au navigateur, ou <see langword="null"/> pour ne rien imposer.
    /// </summary>
    /// <remarks>
    /// Elle doit venir de la même source que le texte qui annonce la règle. Un minimum
    /// annoncé à 12 et non appliqué laisse le membre remplir un mot de passe trop court,
    /// se faire refuser par le serveur, et découvrir la règle trop tard.
    /// </remarks>
    [Parameter] public int? MinimumLength { get; set; }

    /// <summary>Le champ est-il requis ?</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Longueur maximale acceptée.</summary>
    [Parameter] public int MaximumLength { get; set; } = 128;

    /// <summary>Valeur du <c>autocomplete</c> : <c>new-password</c> ou <c>current-password</c>.</summary>
    [Parameter] public string AutoComplete { get; set; } = "current-password";

    /// <summary>Message d'erreur, affiché sous le champ.</summary>
    [Parameter] public string? Erreur { get; set; }

    /// <summary>Classes additionnelles du champ, pour un état particulier.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Attributs restants, transmis tels quels au <c>input</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AttributsSupplementaires { get; set; }

    private string CssChamp => string.IsNullOrWhiteSpace(Class) ? string.Empty : Class!;

    /// <summary>Texte affiché : toujours celui de la dernière frappe.</summary>
    private string? _texte;

    private bool _texteInitialPose;

    protected override void OnParametersSet()
    {
        if (!_texteInitialPose)
        {
            _texte = Valeur;
            _texteInitialPose = true;
        }
    }

    private async Task SurSaisie(ChangeEventArgs args)
    {
        var saisie = args.Value?.ToString();

        _texte = saisie;
        Valeur = saisie;

        await ValeurChanged.InvokeAsync(saisie);
    }
}