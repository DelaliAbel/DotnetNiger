@* Carte admin des partenaires avec menu d'actions. *@
@using DotnetNiger.UI.Models.Responses
@inject NavigationManager Navigation
@inject IPartnerService PartnerService
@inject IToastService ToastService

<div class="group rounded-lg bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] ring-1 ring-black/5 overflow-hidden">
    <div class="relative h-36 bg-gradient-to-br from-[#512BD4] to-[#3F1FB3] flex items-center justify-center overflow-hidden">
        @if (!string.IsNullOrWhiteSpace(Partner?.LogoUrl))
        {
            <ResolvedImage Src="@Partner.LogoUrl" alt="@Partner.Name" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
        }
        else
        {
            <i class="fas fa-handshake text-5xl text-white/40"></i>
        }
    </div>

    <div class="p-5">
        <div class="mb-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h3 class="truncate text-lg font-semibold text-title">@Partner?.Name</h3>
                <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(Partner?.PartnerType == "education" ? "bg-blue-100 text-blue-700" : "bg-amber-100 text-amber-700")">
                        @GetPartnerTypeLabel(Partner?.PartnerType ?? "")
                    </span>
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @(Partner?.IsActive == true ? "bg-success-bg text-success" : "bg-gray-100 text-gray-700")">
                        @(Partner?.IsActive == true ? "Actif" : "Inactif")
                    </span>
                </div>
            </div>

            <AdminActionDropdown ItemId="@(Partner?.Id ?? Guid.Empty)"
                                 Status="@(Partner?.IsActive == true ? "Published" : "Pending")"
                                 ViewLabel="Modifier"
                                 EditLabel="Modifier"
                                 DeleteLabel="Supprimer"
                                 OnView="EditPartner"
                                 OnEdit="EditPartner"
                                 OnDelete="DeletePartner" />
        </div>

        <p class="mb-4 line-clamp-3 text-sm leading-6 text-body break-words">@Partner?.Description</p>

        <div class="flex items-center justify-between gap-3 border-t border-gray-100 pt-4 text-sm text-body">
            @if (!string.IsNullOrWhiteSpace(Partner?.WebsiteUrl))
            {
                <a href="@Partner.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="truncate font-medium text-secondary hover:underline">
                    @Partner.WebsiteUrl
                </a>
            }
            else
            {
                <span class="text-gray-400">—</span>
            }
            <span class="whitespace-nowrap text-xs text-muted">Ordre: @Partner?.SortOrder</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public PartnerResponse? Partner { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task EditPartner(Guid id)
    {
        if (Partner is null) return Task.CompletedTask;
        Navigation.NavigateTo($"/admin/partners/edit/{Partner.Id}");
        return Task.CompletedTask;
    }

    private async Task DeletePartner(Guid id)
    {
        if (Partner is null) return;
        var deleted = await PartnerService.DeleteAsync(Partner.Id);
        if (deleted)
        {
            ToastService.ShowToast("Partenaire supprimé.", ToastLevel.Success);
            await OnChanged.InvokeAsync();
        }
        else
        {
            ToastService.ShowToast("Erreur lors de la suppression.", ToastLevel.Error);
        }
    }

    private static string GetPartnerTypeLabel(string type)
    {
        return type.ToLowerInvariant() switch
        {
            "education" => "Éducation",
            "sponsor" => "Sponsor",
            _ => type
        };
    }
}
