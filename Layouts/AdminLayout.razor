@using DotnetNiger.UI.Components.Admin.Shared
@using System.Security.Claims
@using DotnetNiger.UI.Helpers
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@if (_authorized)
{ 
    <div class="flex flex-col h-screen">
       <Topbar ToggleSidebar="ToggleSidebar" ToggleCollapsed="ToggleCollapsed" IsCollapsed="isCollapsed"/>
      <div class="flex flex-1 overflow-hidden">
           <Sidebar IsOpen="sidebarOpen" IsCollapsed="isCollapsed" Closed="ToggleSidebar"/>
        <main class="flex-1 overflow-y-auto bg-primary transition-all duration-300">
          <div class="container mx-auto ">
            @Body
          </div>
        </main>
      </div>
    </div>
    <ToastContainer />
}
else
{
    <div class="flex items-center justify-center h-screen">
        <p>Vérification des autorisations...</p>
    </div>
}

@code{
  bool sidebarOpen = false;
  bool isCollapsed = false;
  bool  _authorized ;

  protected override async Task OnInitializedAsync()
  {
      var state = await AuthStateProvider.GetAuthenticationStateAsync();
      if (state.User.Identity?.IsAuthenticated != true)
      {
          Navigation.NavigateTo("/", forceLoad: true);
          return;
      }

      var isAdmin = state.User.FindAll(ClaimTypes.Role).Any(r => RoleConstants.IsAdminRole(r.Value));

      if (!isAdmin)
      {
          Navigation.NavigateTo("/");
          return;
      }

      _authorized = true; 
  }

  void ToggleCollapsed(){
    isCollapsed = !isCollapsed;
  }
  void ToggleSidebar(){
    sidebarOpen = !sidebarOpen;
  }
}