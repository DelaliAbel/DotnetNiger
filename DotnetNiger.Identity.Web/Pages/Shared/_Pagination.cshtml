@using DotnetNiger.Identity.Web.Models
@model PaginationModel
@{
    var totalPages = Model.TotalPages;
    var current = Model.CurrentPage;
}
@if (totalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(current <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.BuildUrl(current - 1)">Précédent</a>
            </li>
            @for (int i = Math.Max(1, current - 2); i <= Math.Min(totalPages, current + 2); i++)
            {
                <li class="page-item @(i == current ? "active" : "")">
                    <a class="page-link" href="@Model.BuildUrl(i)">@i</a>
                </li>
            }
            <li class="page-item @(current >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@Model.BuildUrl(current + 1)">Suivant</a>
            </li>
        </ul>
    </nav>
}
