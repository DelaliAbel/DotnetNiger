@model List<Tuple<string, string>>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-3 small">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i></a></li>
        <li class="breadcrumb-item"><a href="/Developer/Admin/Index">Administration</a></li>
        @for (int i = 0; i < Model.Count; i++)
        {
            var crumb = Model[i];
            var isLast = i == Model.Count - 1;
            if (!string.IsNullOrEmpty(crumb.Item2) && !isLast)
            {
                <li class="breadcrumb-item"><a href="@crumb.Item2">@crumb.Item1</a></li>
            }
            else
            {
                <li class="breadcrumb-item active">@crumb.Item1</li>
            }
        }
    </ol>
</nav>
