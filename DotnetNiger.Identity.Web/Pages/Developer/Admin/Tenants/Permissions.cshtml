@page "/Developer/Admin/Tenants/{tenantId:guid}/Permissions"
@model DotnetNiger.Identity.Web.Pages.Developer.Admin.Tenants.PermissionsModel
@{
    ViewData["Title"] = "Permissions";
}

@await Html.PartialAsync("_Breadcrumbs", new List<Tuple<string, string>> { Tuple.Create("Tenants", "/Developer/Admin/Tenants"), Tuple.Create("Permissions", "") })
<h1>Permissions</h1>
<p class="lead">Gestion des permissions du tenant.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    Permissions
                    <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
                </h5>
            </div>
            <div class="card-body">
                @if (Model.GroupedPermissions.Count == 0)
                {
                    <p class="text-muted mb-0">Aucune permission. Créez-en une avec le formulaire.</p>
                }
                else
                {
                    <div class="accordion" id="permissionsAccordion">
                        @for (int i = 0; i < Model.GroupedPermissions.Count; i++)
                        {
                            var group = Model.GroupedPermissions[i];
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapse-@i">
                                        <strong>@group.Category</strong>
                                        <span class="badge bg-info ms-2">@group.Permissions.Count</span>
                                    </button>
                                </h2>
                                <div id="collapse-@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                                     data-bs-parent="#permissionsAccordion">
                                    <div class="accordion-body p-2">
                                        <table class="table table-sm table-borderless mb-0">
                                            <tbody>
                                                @foreach (var perm in group.Permissions)
                                                {
                                                    <tr>
                                                        <td><code>@perm.Name</code></td>
                                                        <td class="text-end">
                                                            <form method="post" asp-page-handler="Delete" asp-route-permissionId="@perm.Id"
                                                                  onsubmit="return confirm('Supprimer la permission @perm.Name ?')">
                                                                <button type="submit" class="btn btn-outline-danger btn-sm">&#128465;</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* Pagination *@
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-3">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="?tenantId=@Model.TenantId&CurrentPage=@(Model.CurrentPage-1)">«</a>
                                </li>
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?tenantId=@Model.TenantId&CurrentPage=@p">@p</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="?tenantId=@Model.TenantId&CurrentPage=@(Model.CurrentPage+1)">»</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Nouvelle permission</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label class="form-label">Nom</label>
                        <input name="CreateInput.Name" class="form-control" required placeholder="users:read" />
                        <small class="text-muted">Format: <code>ressource:action</code></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Catégorie</label>
                        <input name="CreateInput.Category" class="form-control" required placeholder="Users" />
                        <small class="text-muted">Ex: Users, Roles, API Keys, Security</small>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Créer</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Assigner à un rôle</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Assign">
                    <div class="mb-3">
                        <label class="form-label">Rôle</label>
                        <select name="AssignInput.RoleId" class="form-select" required>
                            <option value="">Sélectionner...</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Permissions</label>
                        <div class="border rounded p-2" style="max-height:200px;overflow-y:auto">
                            @foreach (var perm in Model.AllPermissions)
                            {
                                <div class="form-check">
                                    <input name="AssignInput.PermissionIds" class="form-check-input" type="checkbox"
                                           value="@perm.Id" id="perm-@perm.Id" />
                                    <label class="form-check-label small" for="perm-@perm.Id">
                                        <code>@perm.Name</code> <small class="text-muted">(@perm.Category)</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <button type="submit" class="btn btn-warning w-100">Assigner</button>
                </form>
            </div>
        </div>
    </div>
</div>
