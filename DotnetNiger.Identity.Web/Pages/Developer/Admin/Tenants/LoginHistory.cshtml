@page "/Developer/Admin/Tenants/{tenantId:guid}/LoginHistory"
@model DotnetNiger.Identity.Web.Pages.Developer.Admin.Tenants.LoginHistoryModel
@{
    ViewData["Title"] = "Historique des connexions";
}

@await Html.PartialAsync("_Breadcrumbs", new List<Tuple<string, string>> { Tuple.Create("Tenants", "/Developer/Admin/Tenants"), Tuple.Create("Connexions", "") })
<h1>Historique des connexions</h1>
<p class="lead">Consultez l'historique des connexions de tous les utilisateurs du tenant.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            Connexions
            <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
        </h5>
        <div class="d-flex align-items-center gap-2">
            <small class="text-muted">
                @if (Model.CurrentPage > 1 || Model.TotalCount > Model.PageSize)
                {
                    <span>Page @Model.CurrentPage / @Model.TotalPages</span>
                }
            </small>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Entries.Count == 0)
        {
            <p class="text-muted mb-0">Aucune connexion enregistrée.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Utilisateur</th>
                            <th>IP</th>
                            <th>Appareil</th>
                            <th>Statut</th>
                            <th>Raison</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td><small>@e.Timestamp.ToString("g")</small></td>
                                <td><small>@e.Email</small></td>
                                <td><small>@e.IpAddress</small></td>
                                <td>
                                    <small class="text-muted">
                                        @(e.UserAgent?.Length > 40 ? e.UserAgent[..40] + "..." : e.UserAgent)
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-@(e.Success ? "success" : "danger")">
                                        @(e.Success ? "Succès" : "Échec")
                                    </span>
                                </td>
                                <td><small class="text-muted">@(e.FailureReason ?? "—")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?tenantId=@Model.TenantId&CurrentPage=@(Model.CurrentPage-1)">«</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?tenantId=@Model.TenantId&CurrentPage=@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?tenantId=@Model.TenantId&CurrentPage=@(Model.CurrentPage+1)">»</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
