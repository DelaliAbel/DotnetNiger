@page
@model DotnetNiger.Identity.Web.Pages.Developer.Admin.AuditLogsModel
@{
    ViewData["Title"] = "Journaux d'audit";
}

@await Html.PartialAsync("_Breadcrumbs", new List<Tuple<string, string>> { Tuple.Create("Audit", "") })
<h1>Journaux d'audit</h1>
<p class="lead">Consultez l'historique des actions administratives sur la plateforme.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Filtres</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Type d'entité</label>
                <select name="EntityTypeFilter" class="form-select">
                    <option value="">Tous</option>
                    <option value="Tenant" selected="@(Model.EntityTypeFilter == "Tenant")">Tenant</option>
                    <option value="User" selected="@(Model.EntityTypeFilter == "User")">Utilisateur</option>
                    <option value="Role" selected="@(Model.EntityTypeFilter == "Role")">Rôle</option>
                    <option value="Permission" selected="@(Model.EntityTypeFilter == "Permission")">Permission</option>
                    <option value="Client" selected="@(Model.EntityTypeFilter == "Client")">Client OAuth2</option>
                    <option value="ApiKey" selected="@(Model.EntityTypeFilter == "ApiKey")">Clé API</option>
                    <option value="ExternalService" selected="@(Model.EntityTypeFilter == "ExternalService")">Service externe</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Action</label>
                <select name="ActionFilter" class="form-select">
                    <option value="">Toutes</option>
                    <option value="Create" selected="@(Model.ActionFilter == "Create")">Création</option>
                    <option value="Update" selected="@(Model.ActionFilter == "Update")">Modification</option>
                    <option value="Delete" selected="@(Model.ActionFilter == "Delete")">Suppression</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Du</label>
                <input name="FromDate" type="date" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Au</label>
                <input name="ToDate" type="date" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Filtrer</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Historique (@Model.TotalCount entrées)</h5>
    </div>
    <div class="card-body">
        @if (Model.Logs.Count == 0)
        {
            <p class="text-muted mb-0">Aucune entrée d'audit.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td><small>@log.CreatedAt.ToString("g")</small></td>
                                <td><span class="badge bg-secondary">@log.EntityType</span></td>
                                <td>
                                    <span class="badge bg-@(log.Action switch {
                                        "Create" => "success",
                                        "Update" => "info",
                                        "Delete" => "danger",
                                        _ => "secondary"
                                    })">@log.Action</span>
                                </td>
                                <td><small class="text-muted">@(log.Description ?? "—")</small></td>
                                <td><small>@(log.IpAddress ?? "—")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalCount > 50)
            {
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mt-3">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(Model.CurrentPage - 1)&entityTypeFilter=@Model.EntityTypeFilter&actionFilter=@Model.ActionFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")">Précédent</a>
                            </li>
                        }
                        <li class="page-item disabled">
                            <span class="page-link">Page @Model.CurrentPage</span>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="?page=@(Model.CurrentPage + 1)&entityTypeFilter=@Model.EntityTypeFilter&actionFilter=@Model.ActionFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")">Suivant</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
