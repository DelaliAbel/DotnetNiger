        <div class="tab-content">
            @* ════════ TAB 1: GETTING STARTED ════════ *@
            <div class="tab-pane fade show active" id="en-start" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🎯 Account Creation — Step by Step</h5></div>
                    <div class="card-body">
                        <h6>1. Register</h6>
                        <p>Go to the <code>/Account/Register</code> page on Identity to create your account.</p>

                        <h6 class="mt-3">2. Email Confirmation</h6>
                        <p>After registration, a confirmation code is sent by email. Enter it in the form to activate your account.</p>

                        <h6 class="mt-3">3. Auto Login</h6>
                        <p>Once confirmed, you're automatically logged in and redirected to Identity.Web.</p>

                        <h6 class="mt-3">4. Understanding the OIDC Flow</h6>
                        <p>When you click "Sign in" from Identity.Web, you're redirected to Identity (the OIDC server) which handles authentication. Once authenticated, Identity redirects you back to Identity.Web with a secure token.</p>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🏢 User Management</h5></div>
                    <div class="card-body">
                        <p>From <strong>Admin → Tenants → [Your tenant] → Users</strong>, you can:</p>
                        <ul>
                            <li><strong>Create</strong> a user with email, password, name, and initial role</li>
                            <li><strong>Edit</strong> user profile (first name, last name)</li>
                            <li><strong>Enable/Disable</strong> accounts</li>
                            <li><strong>Change password</strong> for a user</li>
                            <li><strong>Send password reset</strong> email</li>
                            <li><strong>Delete</strong> a user from the tenant</li>
                        </ul>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🔑 Roles and Permissions</h5></div>
                    <div class="card-body">
                        <p>Roles define a set of permissions. Each user can have one or more roles.</p>
                        <ul>
                            <li><strong>Create a role</strong> with a unique name and optional description</li>
                            <li><strong>Assign permissions</strong> to each role</li>
                            <li><strong>Assign users</strong> to roles</li>
                        </ul>
                        <p>Available permissions include: <code>users.read</code>, <code>users.write</code>, <code>roles.read</code>, <code>roles.write</code>, <code>apikeys.read</code>, <code>apikeys.write</code>, <code>services.read</code>, <code>services.write</code>, and more.</p>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🔄 Redirecting to Identity for Authentication</h5></div>
                    <div class="card-body">
                        <p>If you're developing an application that uses DotnetNiger Identity as an authentication provider, here's how to redirect your users:</p>

                        <h6>ASP.NET Core</h6>
                        <pre><code>builder.Services.AddAuthentication()
    .AddOpenIdConnect("oidc", options =>
    {
        options.Authority = "@Model.IdentityUrl";
        options.ClientId = "your-client-id";
        options.ResponseType = "code";
        options.Scope.Add("openid");
        options.Scope.Add("profile");
        options.Scope.Add("email");
        options.Scope.Add("roles");
        options.SaveTokens = true;
    });</code></pre>

                        <h6 class="mt-3">Node.js</h6>
                        <pre><code>const { Issuer } = require('openid-client');
const issuer = await Issuer.discover('@Model.IdentityUrl');
const client = new issuer.Client({
  client_id: 'your-client-id',
  redirect_uris: ['http://localhost:3000/callback'],
  response_types: ['code'],
});</code></pre>
                    </div>
                </div>
            </div>

            @* ════════ TAB 2: SERVICES ════════ *@
            <div class="tab-pane fade" id="en-services" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">📦 Register an External Service</h5></div>
                    <div class="card-body">
                        <p>Register your external API to make it accessible through the DotnetNiger Gateway.</p>

                        <h6>cURL</h6>
                        <pre><code>curl -X POST @Model.IdentityUrl/api/v1/external-services/register \
  -H "X-API-Key: dn_your_key" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "My Service",
    "slug": "my-service",
    "baseUrl": "https://api.myservice.com"
  }'</code></pre>

                        <h6 class="mt-3">Python</h6>
                        <pre><code>import requests
response = requests.post(
    "@Model.IdentityUrl/api/v1/external-services/register",
    json={"name": "My Service", "slug": "my-service", "baseUrl": "https://api.myservice.com"},
    headers={"X-API-Key": "dn_your_key"}
)
print(response.json())</code></pre>

                        <h6 class="mt-3">Node.js</h6>
                        <pre><code>const response = await axios.post(
  '@Model.IdentityUrl/api/v1/external-services/register',
  { name: 'My Service', slug: 'my-service', baseUrl: 'https://api.myservice.com' },
  { headers: { 'X-API-Key': 'dn_your_key' } }
);</code></pre>

                        <h6 class="mt-3">C#</h6>
                        <pre><code>using var client = new HttpClient();
client.DefaultRequestHeaders.Add("X-API-Key", "dn_your_key");
var payload = new { name = "My Service", slug = "my-service", baseUrl = "https://api.myservice.com" };
var response = await client.PostAsJsonAsync("@Model.IdentityUrl/api/v1/external-services/register", payload);</code></pre>

                        <h6 class="mt-3">Go</h6>
                        <pre><code>package main
import ("bytes"; "encoding/json"; "net/http")
func main() {
    payload := map[string]string{"name":"My Service","slug":"my-service","baseUrl":"https://api.myservice.com"}
    body, _ := json.Marshal(payload)
    req, _ := http.NewRequest("POST", "@Model.IdentityUrl/api/v1/external-services/register", bytes.NewBuffer(body))
    req.Header.Set("X-API-Key", "dn_your_key"); req.Header.Set("Content-Type","application/json")
    client := &http.Client{}; client.Do(req)
}</code></pre>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🩺 Health Monitoring</h5></div>
                    <div class="card-body">
                        <p>The Gateway checks your service's health every 30 seconds. If a service fails 3 consecutive checks, its status changes to <strong>Suspended</strong>. Update the service (PATCH) to reactivate it.</p>
                    </div>
                </div>
            </div>

            @* ════════ TAB 3: AUTH ════════ *@
            <div class="tab-pane fade" id="en-auth" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🔐 Obtaining an OIDC Token</h5></div>
                    <div class="card-body">
                        <h6>Password Flow (backends only)</h6>
                        <pre><code>curl -X POST @Model.IdentityUrl/connect/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=password" \
  -d "username=user@example.com" \
  -d "password=MyPassword123" \
  -d "scope=openid profile email roles offline_access"</code></pre>

                        <h6 class="mt-3">Client Credentials Flow (machine-to-machine)</h6>
                        <pre><code>curl -X POST @Model.IdentityUrl/connect/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=client_credentials" \
  -d "client_id=your_client_id" \
  -d "client_secret=your_client_secret" \
  -d "scope=api"</code></pre>

                        <h6 class="mt-3">Refresh Token</h6>
                        <pre><code>curl -X POST @Model.IdentityUrl/connect/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=refresh_token" \
  -d "refresh_token=your_refresh_token" \
  -d "scope=openid profile email offline_access"</code></pre>
                    </div>
                </div>
            </div>

            @* ════════ TAB 4: API KEYS ════════ *@
            <div class="tab-pane fade" id="en-apikeys" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🗝️ Manage Your API Keys</h5></div>
                    <div class="card-body">
                        <h6>Create a key</h6>
                        <pre><code>curl -X POST @Model.IdentityUrl/api/v1/admin/tenants/{tenantId}/api-keys \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -d '{"name": "My prod key", "scopes": ["api"]}'</code></pre>

                        <h6 class="mt-3">List keys</h6>
                        <pre><code>curl -X GET @Model.IdentityUrl/api/v1/admin/tenants/{tenantId}/api-keys \
  -H "Authorization: Bearer {token}"</code></pre>

                        <h6 class="mt-3">Rotate a key</h6>
                        <pre><code>curl -X POST @Model.IdentityUrl/api/v1/admin/tenants/{tenantId}/api-keys/{keyId}/rotate \
  -H "Authorization: Bearer {token}"</code></pre>

                        <h6 class="mt-3">Delete a key</h6>
                        <pre><code>curl -X DELETE @Model.IdentityUrl/api/v1/admin/tenants/{tenantId}/api-keys/{keyId} \
  -H "Authorization: Bearer {token}"</code></pre>
                    </div>
                </div>
            </div>

            @* ════════ TAB 5: OAUTH2 CLIENTS ════════ *@
            <div class="tab-pane fade" id="en-clients" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🔌 Manage OAuth2 Clients</h5></div>
                    <div class="card-body">
                        <p>OAuth2 clients allow your applications to authenticate via DotnetNiger Identity.</p>
                        <pre><code>builder.Services.AddAuthentication()
    .AddOpenIdConnect("oidc", options =>
    {
        options.Authority = "@Model.IdentityUrl";
        options.ClientId = "my-client";
        options.ClientSecret = "my-secret";
        options.ResponseType = "code";
        options.Scope.Add("openid"); options.Scope.Add("profile");
        options.Scope.Add("email"); options.Scope.Add("roles");
        options.SaveTokens = true;
    });</code></pre>
                    </div>
                </div>
            </div>

            @* ════════ TAB 6: SECURITY ════════ *@
            <div class="tab-pane fade" id="en-security" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🛡️ Two-Factor Authentication (2FA/TOTP)</h5></div>
                    <div class="card-body">
                        <h6>Enable 2FA</h6>
                        <ol>
                            <li>Go to your <strong>Profile → Security</strong></li>
                            <li>Click "Configure two-factor authentication"</li>
                            <li>Scan the QR code with Google Authenticator or Authy</li>
                            <li>Enter the 6-digit code to confirm</li>
                            <li>Save your recovery codes in a safe place</li>
                        </ol>

                        <h6 class="mt-3">API — Setup 2FA</h6>
                        <pre><code># Setup
curl -X POST @Model.IdentityUrl/api/v1/profile/two-factor/setup \
  -H "Authorization: Bearer {token}"

# Enable
curl -X POST @Model.IdentityUrl/api/v1/profile/two-factor/enable \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -d '{"code": "123456"}'</code></pre>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">📧 Change Email / 📜 Login History / 🗄️ GDPR</h5></div>
                    <div class="card-body">
                        <p>All these features are available from your <strong>Profile</strong> page.</p>
                        <pre><code># Change email
curl -X POST @Model.IdentityUrl/api/v1/profile/change-email \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -d '{"newEmail": "new@email.com"}'

# Login history
curl -X GET @Model.IdentityUrl/api/v1/profile/login-history?page=1&pageSize=20 \
  -H "Authorization: Bearer {token}"

# Export GDPR data
curl -X POST @Model.IdentityUrl/api/v1/account/export \
  -H "Authorization: Bearer {token}"

# Delete account
curl -X DELETE @Model.IdentityUrl/api/v1/profile \
  -H "Authorization: Bearer {token}"</code></pre>
                    </div>
                </div>
            </div>

            @* ════════ TAB 7: ERRORS ════════ *@
            <div class="tab-pane fade" id="en-errors" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">⚠️ Error Codes</h5></div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr><th>Code</th><th>Cause</th><th>Solution</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><span class="error-code">400</span></td><td>Invalid request</td><td>Check JSON format and required fields</td></tr>
                                <tr><td><span class="error-code">401</span></td><td>Missing or invalid API key</td><td>Check <code>X-API-Key</code> header</td></tr>
                                <tr><td><span class="error-code">403</span></td><td>Expired or invalid JWT</td><td>Get a new token from <code>/connect/token</code></td></tr>
                                <tr><td><span class="error-code">404</span></td><td>Resource not found</td><td>Check the URL and identifiers</td></tr>
                                <tr><td><span class="error-code">409</span></td><td>Conflict (duplicate slug/email)</td><td>Use a unique slug or email</td></tr>
                                <tr><td><span class="error-code">429</span></td><td>Too many requests</td><td>Wait 60 seconds before retrying</td></tr>
                                <tr><td><span class="error-code">500</span></td><td>Internal server error</td><td>Contact support</td></tr>
                                <tr><td><span class="error-code">502</span></td><td>External service unreachable</td><td>Check your service is running</td></tr>
                                <tr><td><span class="error-code">504</span></td><td>External service timeout</td><td>Optimize your service response time</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* ════════ TAB 8: PRODUCTION ════════ *@
            <div class="tab-pane fade" id="en-prod" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🚀 Production Deployment</h5></div>
                    <div class="card-body">
                        <p>Replace local URLs with your production domains:</p>
                        <pre><code>IDENTITY_URL=https://auth.dotnetniger.com
GATEWAY_URL=https://gateway.dotnetniger.com</code></pre>
                        <h6 class="mt-3">Recommendations</h6>
                        <ul>
                            <li><strong>HTTPS</strong> — Enable TLS on Gateway and Identity</li>
                            <li><strong>API Keys</strong> — Use separate production keys</li>
                            <li><strong>Database</strong> — Switch from SQLite to PostgreSQL</li>
                            <li><strong>OIDC Certificates</strong> — Use real certificates via <code>OpenIddict:CertificatePath</code></li>
                        </ul>
                    </div>
                </div>
            </div>

            @* ════════ TAB 9: FAQ ════════ *@
            <div class="tab-pane fade" id="en-faq" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">❓ Frequently Asked Questions</h5></div>
                    <div class="card-body">
                        <div class="accordion" id="faqAccordionEn">

                            <h6 class="mt-3 text-primary">📝 Account</h6>
                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq1">I'm not receiving the confirmation email</button></h2>
                                <div id="en-faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Check your spam folder. Make sure you entered the correct email address. You can request a new code from the confirmation page.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq2">Can I use a personal email to register?</button></h2>
                                <div id="en-faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Yes, any valid email address is accepted.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq3">My account is disabled, what should I do?</button></h2>
                                <div id="en-faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Contact your tenant administrator. Only an administrator can reactivate a disabled account.</div>
                                </div>
                            </div>

                            <h6 class="mt-4 text-primary">🏢 Tenant</h6>
                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq4">What's the difference between a tenant and a workspace?</button></h2>
                                <div id="en-faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">A tenant provides complete data isolation — users, roles, API keys, services, and configurations are completely separated between tenants at the database level.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq5">How many users per tenant?</button></h2>
                                <div id="en-faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">There is no limit. You can create as many users as needed.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq6">Can a user belong to multiple tenants?</button></h2>
                                <div id="en-faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Yes, a user can belong to multiple tenants with potentially different roles in each tenant.</div>
                                </div>
                            </div>

                            <h6 class="mt-4 text-primary">🔌 API</h6>
                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq7">What's the difference between an API key and a JWT token?</button></h2>
                                <div id="en-faq7" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">An <strong>API key</strong> is for machine-to-machine authentication (service → Gateway) without user context. A <strong>JWT token</strong> represents an authenticated user with their roles and permissions. API keys are static; JWTs expire after 1 hour.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq8">How do I refresh a JWT token?</button></h2>
                                <div id="en-faq8" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Use <code>grant_type=refresh_token</code> with the refresh token obtained during authentication. The <code>offline_access</code> scope is required.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq9">What if my API key is compromised?</button></h2>
                                <div id="en-faq9" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Immediately <strong>rotate</strong> the key from the dashboard or via the API. The old key will be revoked instantly.</div>
                                </div>
                            </div>

                            <h6 class="mt-4 text-primary">📦 Services</h6>
                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq10">My service is "Suspended", why?</button></h2>
                                <div id="en-faq10" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">The Gateway checks your service health every 30 seconds. If 3 consecutive checks fail, the service is suspended.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq11">How do I reactivate a suspended service?</button></h2>
                                <div id="en-faq11" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Update the service via PATCH or from the interface. It switches to "Pending" status and will be re-checked.</div>
                                </div>
                            </div>

                            <h6 class="mt-4 text-primary">🔒 Security</h6>
                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq12">Is 2FA mandatory?</button></h2>
                                <div id="en-faq12" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">No, but it's strongly recommended, especially for tenant administrators.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq13">What if I lose my phone (2FA)?</button></h2>
                                <div id="en-faq13" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Use a recovery code generated during 2FA setup. If you lost the codes, an administrator can disable 2FA for your account.</div>
                                </div>
                            </div>

                            <h6 class="mt-4 text-primary">📋 GDPR</h6>
                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq14">What's included in my data export?</button></h2>
                                <div id="en-faq14" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Profile (name, email), login history, GDPR consents, API keys, registered external services.</div>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#en-faq15">How long are logs kept?</button></h2>
                                <div id="en-faq15" class="accordion-collapse collapse" data-bs-parent="#faqAccordionEn">
                                    <div class="accordion-body">Audit logs and login history are kept for 365 days, then automatically deleted.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ════════ TAB 10: BUG REPORT ════════ *@
            <div class="tab-pane fade" id="en-bug" role="tabpanel">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header"><h5 class="mb-0">🐛 Report a Bug</h5></div>
                    <div class="card-body">
                        <p>Use this form to report a bug, suggest an improvement, or flag a security issue.</p>

                        <div id="bugReportAlertEn" class="alert d-none" role="alert"></div>

                        <form id="bugReportFormEn">
                            <div class="mb-3">
                                <label for="bugTitleEn" class="form-label">Title *</label>
                                <input type="text" class="form-control" id="bugTitleEn" required placeholder="e.g., Pagination broken on Users page">
                            </div>
                            <div class="mb-3">
                                <label for="bugTypeEn" class="form-label">Type</label>
                                <select class="form-select" id="bugTypeEn">
                                    <option value="bug">🐛 Bug</option>
                                    <option value="feature">💡 Feature Request</option>
                                    <option value="security">🔒 Security Issue</option>
                                    <option value="documentation">📖 Documentation Error</option>
                                    <option value="other">📌 Other</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="bugDescriptionEn" class="form-label">Detailed Description *</label>
                                <textarea class="form-control" id="bugDescriptionEn" rows="5" required placeholder="Describe the issue in detail. What you expected and what actually happened."></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="bugStepsEn" class="form-label">Steps to Reproduce</label>
                                <textarea class="form-control" id="bugStepsEn" rows="3" placeholder="1. Go to...&#10;2. Click on...&#10;3. See error..."></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="bugPageUrlEn" class="form-label">Page URL</label>
                                <input type="text" class="form-control" id="bugPageUrlEn" value="@HttpContext.Request.Path">
                            </div>
                            <div class="mb-3">
                                <label for="bugUserAgentEn" class="form-label">Browser / OS</label>
                                <input type="text" class="form-control" id="bugUserAgentEn" placeholder="Chrome 120, Windows 11">
                            </div>
                            <button type="submit" class="btn btn-primary" id="bugSubmitBtnEn">
                                <span id="bugSubmitTextEn">Send Report</span>
                                <span id="bugSubmitSpinnerEn" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @* ──────────── Copy buttons ──────────── *@
    <script>
        document.querySelectorAll('pre').forEach(pre => {
            const btn = document.createElement('button');
            btn.className = 'copy-btn btn btn-outline-secondary btn-sm';
            btn.textContent = '📋 Copy';
            btn.onclick = async () => {
                const code = pre.querySelector('code');
                if (code) {
                    await navigator.clipboard.writeText(code.textContent);
                    btn.textContent = '✅ Copied!';
                    setTimeout(() => { btn.textContent = '📋 Copy'; }, 2000);
                }
            };
            pre.style.position = 'relative';
            pre.appendChild(btn);
        });
    </script>

    @* ──────────── Bug report form submission ──────────── *@
    <script>
        function setupBugForm(formId, alertId, titleId, typeId, descId, stepsId, urlId, uaId, submitBtnId, submitTextId, spinnerId) {
            document.getElementById(formId).addEventListener('submit', async (e) => {
                e.preventDefault();
                const alertEl = document.getElementById(alertId);
                const btn = document.getElementById(submitBtnId);
                const text = document.getElementById(submitTextId);
                const spinner = document.getElementById(spinnerId);

                btn.disabled = true;
                text.classList.add('d-none');
                spinner.classList.remove('d-none');

                const payload = {
                    title: document.getElementById(titleId).value,
                    type: document.getElementById(typeId).value,
                    description: document.getElementById(descId).value,
                    steps: document.getElementById(stepsId).value,
                    pageUrl: document.getElementById(urlId).value,
                    userAgent: document.getElementById(uaId).value
                };

                try {
                    const resp = await fetch('@Model.SupportReportUrl', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await resp.json();
                    if (resp.ok) {
                        alertEl.className = 'alert alert-success';
                        alertEl.textContent = '@(Model.Lang == "fr" ? "✅ Signalement envoyé avec succès. Merci !" : "✅ Report sent successfully. Thank you!")';
                        document.getElementById(formId).reset();
                    } else {
                        alertEl.className = 'alert alert-danger';
                        alertEl.textContent = data.error || '@(Model.Lang == "fr" ? "❌ Erreur lors de l\'envoi." : "❌ Error sending report.")';
                    }
                } catch (err) {
                    alertEl.className = 'alert alert-danger';
                    alertEl.textContent = '@(Model.Lang == "fr" ? "❌ Erreur de connexion." : "❌ Connection error.")';
                }

                alertEl.classList.remove('d-none');
                btn.disabled = false;
                text.classList.remove('d-none');
                spinner.classList.add('d-none');
            });
        }

        @if (Model.Lang == "fr")
        {
            <text>
            setupBugForm('bugReportForm', 'bugReportAlert', 'bugTitle', 'bugType', 'bugDescription', 'bugSteps', 'bugPageUrl', 'bugUserAgent', 'bugSubmitBtn', 'bugSubmitText', 'bugSubmitSpinner');
            </text>
        }
        else
        {
            <text>
            setupBugForm('bugReportFormEn', 'bugReportAlertEn', 'bugTitleEn', 'bugTypeEn', 'bugDescriptionEn', 'bugStepsEn', 'bugPageUrlEn', 'bugUserAgentEn', 'bugSubmitBtnEn', 'bugSubmitTextEn', 'bugSubmitSpinnerEn');
            </text>
        }

        @* ──────────── Auto-fill page URL ──────────── *@
        document.addEventListener('DOMContentLoaded', () => {
            @if (Model.Lang == "fr")
            {
                <text>document.getElementById('bugPageUrl').value = window.location.href;</text>
            }
            else
            {
                <text>document.getElementById('bugPageUrlEn').value = window.location.href;</text>
            }
        });
    </script>
}
