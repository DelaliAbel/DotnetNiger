@page
@model DotnetNiger.Identity.Web.Pages.Developer.DocsModel
@{
    ViewData["Title"] = "Documentation";
}

<style>
pre { position: relative; background: #f8f9fa; border-radius: 6px; padding: 16px; }
pre code { font-size: 0.82rem; line-height: 1.6; display: block; overflow-x: auto; }
.copy-btn {
    position: absolute; top: 4px; right: 4px; z-index: 10;
    opacity: 0; transition: opacity 0.2s; font-size: 0.75rem;
    padding: 2px 8px; cursor: pointer;
}
pre:hover .copy-btn { opacity: 1; }
.tab-content { min-height: 400px; }
.nav-tabs .nav-link { font-size: 0.85rem; padding: 8px 12px; }
.nav-tabs .nav-link svg { vertical-align: -2px; margin-right: 4px; }
.error-code { font-family: monospace; font-weight: bold; font-size: 1.1rem; }
.screenshot-placeholder {
    background: #e9ecef; border: 2px dashed #adb5bd; border-radius: 8px;
    padding: 40px 20px; text-align: center; color: #6c757d; margin: 16px 0;
}
.screenshot-placeholder::before { content: "📷 "; }
.faq-question { cursor: pointer; font-weight: 600; padding: 12px 16px; margin: 0; border-radius: 6px; }
.faq-question:hover { background: #f0f0ff; }
.faq-answer { padding: 0 16px 12px; }
.bug-form label { font-weight: 500; }
</style>

<div class="container py-4" style="max-width:1140px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-1">@(Model.Lang == "fr" ? "Documentation développeur" : "Developer Documentation")</h1>
            <p class="text-muted mb-0">@(Model.Lang == "fr" ? "Guide complet pour utiliser la plateforme DotnetNiger" : "Complete guide to using the DotnetNiger platform")</p>
        </div>
        <div class="btn-group" role="group">
            <a href="?lang=fr" class="btn btn-outline-primary btn-sm @(Model.Lang == "fr" ? "active" : "")">FR</a>
            <a href="?lang=en" class="btn btn-outline-primary btn-sm @(Model.Lang == "en" ? "active" : "")">EN</a>
        </div>
    </div>

    @if (Model.Lang == "fr")
    {
        @* ──────────── FR: Qu'est-ce qu'un tenant ? ──────────── *@
        <div class="card mb-4 shadow-sm">
            <div class="card-header" role="button" data-bs-toggle="collapse" data-bs-target="#tenantSectionFr" style="cursor:pointer;">
                <h5 class="mb-0"><i class="bi bi-question-circle me-2"></i>Qu'est-ce qu'un tenant ?</h5>
            </div>
            <div class="collapse" id="tenantSectionFr">
                <div class="card-body">
                    <p>Un <strong>tenant</strong> représente une organisation, une équipe ou un projet isolé sur la plateforme DotnetNiger. Chaque tenant possède ses propres ressources :</p>
                    <ul>
                        <li><strong>Utilisateurs</strong> — Comptes membres du tenant avec rôles et permissions</li>
                        <li><strong>Rôles et permissions</strong> — Droits d'accès personnalisés</li>
                        <li><strong>Clés API</strong> — Clés d'authentification pour les appels API</li>
                        <li><strong>Services externes</strong> — APIs enregistrées accessibles via le Gateway</li>
                        <li><strong>Clients OAuth2</strong> — Applications OIDC/OAuth2 autorisées</li>
                    </ul>
                    <p>L'isolation est totale : les données d'un tenant ne sont jamais visibles par les autres tenants. Chaque tenant a son propre espace de stockage, ses propres configurations et ses propres utilisateurs.</p>

                    <div class="screenshot-placeholder">Capture d'écran : Vue d'ensemble d'un tenant dans le Dashboard</div>

                    <h6 class="mt-3">Créer votre premier tenant</h6>
                    <ol>
                        <li>Connectez-vous en tant qu'admin plateforme sur <code>admin@dotnetniger.com</code></li>
                        <li>Allez dans <strong>Admin → Tenants</strong> et cliquez sur <strong>"Nouveau tenant"</strong></li>
                        <li>Donnez un nom (ex: <code>Ma Société</code>) et un slug (ex: <code>ma-societe</code>)</li>
                        <li>Un email admin est automatiquement généré : <code>admin@ma-societe.dotnetniger.com</code></li>
                        <li>Déconnectez-vous et reconnectez-vous avec cet email pour gérer votre tenant</li>
                    </ol>

                    <div class="alert alert-info">
                        <strong>💡 Astuce :</strong> Le slug du tenant est utilisé dans les URLs et les identifiants. Choisissez-le avec soin, il ne pourra pas être changé facilement.
                    </div>
                </div>
            </div>
        </div>

        @* ──────────── FR: Navigation Tabs (10 onglets) ──────────── *@
