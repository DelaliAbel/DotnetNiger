@page
@model DotnetNiger.Identity.Web.Pages.Developer.ProfileModel
@{
    ViewData["Title"] = "Profil";
}

<h1>Mon Profil</h1>
<p class="lead">Modifiez vos informations personnelles.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.FirstName" class="form-label">Prénom</label>
                    <input asp-for="Input.FirstName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.LastName" class="form-label">Nom de famille</label>
                    <input asp-for="Input.LastName" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Email actuel</label>
                    <input class="form-control" value="@Model.Email" readonly disabled />
                </div>
                <div class="col-12">
                    <details class="mt-2">
                        <summary class="text-primary small">Changer d'adresse email</summary>
                        <div class="mt-2 p-3 bg-light rounded border">
                            <form method="post" asp-page-handler="ChangeEmail" class="row g-2 align-items-end">
                                <div class="col-md-8">
                                    <label asp-for="ChangeEmailInput.NewEmail" class="form-label">Nouvel email</label>
                                    <input asp-for="ChangeEmailInput.NewEmail" class="form-control" type="email" required placeholder="nouveau@email.com" />
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-primary w-100">Envoyer le code</button>
                                </div>
                            </form>
                            <form method="post" asp-page-handler="ConfirmChangeEmail" class="row g-2 align-items-end mt-2">
                                <div class="col-md-8">
                                    <label asp-for="ConfirmChangeEmailInput.Code" class="form-label">Code de confirmation</label>
                                    <input asp-for="ConfirmChangeEmailInput.Code" class="form-control" placeholder="Code reçu par email" />
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-success w-100">Confirmer</button>
                                </div>
                            </form>
                        </div>
                    </details>
                </div>
                <div class="col-12">
                    <label asp-for="Input.AvatarUrl" class="form-label">Avatar URL</label>
                    <input asp-for="Input.AvatarUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Changer le mot de passe</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="ChangePassword">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PasswordInput.CurrentPassword" class="form-label">Mot de passe actuel</label>
                    <input asp-for="PasswordInput.CurrentPassword" type="password" class="form-control" />
                    <span asp-validation-for="PasswordInput.CurrentPassword" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PasswordInput.NewPassword" class="form-label">Nouveau mot de passe</label>
                    <input asp-for="PasswordInput.NewPassword" type="password" class="form-control" />
                    <span asp-validation-for="PasswordInput.NewPassword" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-warning">Changer le mot de passe</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-shield-lock me-1"></i>Sécurité - Double authentification</h5>
    </div>
    <div class="card-body">
        @if (Model.TwoFactorEnabled)
        {
            <p>
                <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Double authentification active</span>
            </p>
            <p class="mb-3">
                Codes de récupération restants : <strong>@Model.RecoveryCodesLeft</strong>
            </p>

            @if (Model.RecoveryCodes is { Length: > 0 })
            {
                <div class="mb-3 p-3 bg-light rounded border" id="recoveryCodesSection">
                    <h6 class="fw-bold mb-2"><i class="bi bi-key me-1"></i>Codes de récupération</h6>
                    <p class="text-muted small">Chaque code ne peut être utilisé qu'une seule fois.</p>
                    <div class="row row-cols-2 g-2">
                        @foreach (var code in Model.RecoveryCodes)
                        {
                            <div class="col"><code class="fs-6">@code</code></div>
                        }
                    </div>
                </div>
            }

            <div class="d-flex gap-2 mb-3 flex-wrap">
                @if (Model.RecoveryCodes is null or { Length: 0 })
                {
                    <form method="post" asp-page-handler="GenerateRecoveryCodes">
                        <button type="submit" class="btn btn-outline-warning">
                            <i class="bi bi-eye me-1"></i>Voir les codes de récupération
                        </button>
                    </form>
                }
                <form method="post" asp-page-handler="GenerateRecoveryCodes">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-arrow-clockwise me-1"></i>Régénérer les codes
                    </button>
                </form>
            </div>

            <hr />
            <h6>Désactiver la double authentification</h6>
            <form method="post" asp-page-handler="DisableTwoFactor" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label asp-for="TwoFactorInput.Code" class="form-label">Code de vérification</label>
                    <input asp-for="TwoFactorInput.Code" class="form-control" placeholder="Code à 6 chiffres" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-shield-slash me-1"></i>Désactiver
                    </button>
                </div>
            </form>
        }
        else
        {
            if (!string.IsNullOrEmpty(Model.SharedKey))
            {
                <div class="mb-4">
                    <h6 class="fw-bold mb-2">1. Scannez le code QR</h6>
                    <div class="mb-2">
                        <img src="https://chart.googleapis.com/chart?chs=200x200&chld=M|0&cht=qr&chl=@Uri.EscapeDataString(Model.AuthenticatorUri ?? "")"
                             alt="QR Code" class="img-thumbnail" />
                    </div>
                    <p class="mb-1">
                        Ou saisissez la clé manuellement :
                        <code class="user-select-all">@Model.SharedKey</code>
                    </p>
                </div>
                <div class="mb-3">
                    <h6 class="fw-bold mb-2">2. Entrez le code de vérification</h6>
                    <form method="post" asp-page-handler="EnableTwoFactor" class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label asp-for="TwoFactorInput.Code" class="form-label">Code à 6 chiffres</label>
                            <input asp-for="TwoFactorInput.Code" class="form-control" placeholder="123456" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg me-1"></i>Valider et activer
                            </button>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <p class="mb-3">La double authentification n'est pas activée.</p>
                <form method="post" asp-page-handler="SetupTwoFactor">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-shield-plus me-1"></i>Configurer
                    </button>
                </form>
            }
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Informations du compte</h5>
    </div>
    <div class="card-body">
        <table class="table table-borderless mb-0">
            <tbody>
                <tr><th class="ps-0" style="width:200px">Rôles</th><td>@string.Join(", ", Model.Roles)</td></tr>
                <tr><th class="ps-0" style="width:200px">Tenant ID</th><td><code>@Model.TenantId</code></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-4 border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-trash me-2"></i>Supprimer mon compte</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <strong>⚠️ Action irréversible</strong> — La suppression de votre compte entraîne la suppression définitive de toutes vos données personnelles (profil, clés API, services, historique). Cette action ne peut pas être annulée.
        </div>
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
            <i class="bi bi-person-x me-1"></i>Supprimer définitivement mon compte
        </button>
    </div>
</div>

<!-- Delete Account Confirmation Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirmation de suppression</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous absolument sûr de vouloir supprimer votre compte ?</p>
                <p class="mb-0"><strong>Cette action est irréversible.</strong></p>
                <hr />
                <form method="post" asp-page-handler="DeleteAccount" id="deleteAccountForm">
                    <div class="mb-3">
                        <label for="confirmDeleteEmail" class="form-label">Tapez votre email pour confirmer :</label>
                        <input type="email" class="form-control" id="confirmDeleteEmail" name="confirmEmail" required placeholder="@Model.Email" />
                    </div>
                    <div class="mb-3">
                        <label for="confirmDeleteText" class="form-label">Tapez <strong>SUPPRIMER</strong> pour confirmer :</label>
                        <input type="text" class="form-control" id="confirmDeleteText" name="confirmText" required pattern="SUPPRIMER" placeholder="SUPPRIMER" />
                    </div>
                    <button type="submit" class="btn btn-danger w-100" id="deleteAccountBtn">
                        <i class="bi bi-trash me-1"></i>Supprimer définitivement
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Historique des connexions</h5>
        <form method="post" asp-page-handler="LoadLoginHistory">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Afficher</button>
        </form>
    </div>
    <div class="card-body">
        @if (Model.LoginHistory.Count == 0)
        {
            <p class="text-muted mb-0">Cliquez sur "Afficher" pour voir l'historique.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>IP</th>
                            <th>Navigateur</th>
                            <th>Statut</th>
                            <th>Fournisseur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.LoginHistory)
                        {
                            <tr>
                                <td><small>@entry.Timestamp.ToString("g")</small></td>
                                <td><small>@entry.IpAddress</small></td>
                                <td><small class="text-muted">@(entry.UserAgent?.Length > 40 ? entry.UserAgent[..40] + "..." : entry.UserAgent)</small></td>
                                <td>
                                    <span class="badge bg-@(entry.Success ? "success" : "danger")">
                                        @(entry.Success ? "Succès" : "Échec")
                                    </span>
                                </td>
                                <td><small>@(entry.Provider ?? "—")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
