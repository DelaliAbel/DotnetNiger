{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information"
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "DotnetNiger.Identity",
    "Audience": "DotnetNiger.Identity.Client",
    "DisableHttpsRequirement": true
  },
  "DownstreamServices": {
    "Identity": {
      "Id": "identity",
      "ContainerName": "identity",
      "Port": 8081,
      "DevUrl": "http://localhost:5075",
      "HealthEndpoint": "/health",
      "SwaggerEndpoint": "/openapi/v1.json",
      "SwaggerName": "Identity API",
      "RoutesConfig": "ocelot.identity.routes.json"
    },
    "Community": {
      "Id": "community",
      "ContainerName": "community",
      "Port": 8082,
      "DevUrl": "http://localhost:5050",
      "HealthEndpoint": "/api/v1/test/health",
      "SwaggerEndpoint": "/openapi/v1.json",
      "SwaggerName": "Community API",
      "RoutesConfig": "ocelot.community.routes.json"
    }
  },
  "Gateway": {
    "Port": 5000,
    "ContainerName": "gateway",
    "BaseUrl": "http://localhost:5000"
  },
  "HealthCheckIntervalSeconds": 30,
  "MaxHealthCheckFailures": 3,
  "SlugCacheDurationSeconds": 60,
  "InternalApiKey": "dev-internal-api-key-2024",
  "DeveloperPortal": {
    "IdentityBaseUrl": "http://localhost:5075"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "https://dotnetniger.vercel.app,https://dotnetniger.netlify.app,http://localhost:5201,http://dotnetniger.runasp.net,https://dotnetniger.runasp.net,http://identity-dotnetniger.runasp.net,http://community-dotnetniger.runasp.net,https://identity-dotnetniger.runasp.net,https://community-dotnetniger.runasp.net"
  }
}
